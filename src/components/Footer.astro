---
/**
 * The footer: one block for PlayRun (who, where, email, profile), the site links beside it, and
 * one bottom line with the copyright, the credit and the legal links. No call to action here:
 * "Get in touch" lives in the nav, the hero and the end of Home.
 */
import Icon from '../assets/logo/icon.svg';
import ExternalLink from './ExternalLink.astro';
import { contact, legalNav, nav, playrun, site, social } from '../config';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__who">
        <Icon class="footer__icon" aria-hidden="true" role="presentation" />
        <p class="footer__name">{contact.name}</p>
        <p>{playrun.role}, {site.name}. {contact.location}.</p>
        <p class="footer__contact">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          {social.map((s) => (
            <>
              <span class="footer__dot" aria-hidden="true">&middot;</span>
              <ExternalLink href={s.href} rel="me">{s.label}</ExternalLink>
            </>
          ))}
        </p>
      </div>
      <nav class="footer__site" aria-label="Footer">
        <ul role="list" class="footer__links">
          <li><a href="/">Home</a></li>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/contact">Contact</a></li>
          <li><a href="/credits">Credits</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer__bottom small muted">
      <p>
        © {year} {site.name}. Designed, built and tested by PlayRun. <a href="/quality">Tested with Playwright on every push</a>.
      </p>
      <ul role="list" class="footer__legal">
        {legalNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg);
    border-top: 1px solid var(--surface-2);
    padding-block: var(--s-5) var(--s-4);
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-4) var(--s-6);
    align-items: start;
  }
  .footer__who p {
    max-width: none;
    overflow-wrap: anywhere;
  }
  .footer__who p + p {
    margin-top: 0.3em;
  }
  .footer__icon {
    height: 2rem;
    width: auto;
    color: var(--field-blue);
    margin-bottom: var(--s-3);
  }
  .footer__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
  }
  .footer__contact {
    margin-top: var(--s-2) !important;
  }
  .footer__dot {
    margin-inline: 0.4em;
    color: var(--muted);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem var(--s-3);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
  }
  .footer__links a {
    text-decoration: none;
  }
  .footer__links a:hover,
  .footer__links a:focus-visible {
    text-decoration: underline;
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    flex-wrap: wrap;
    margin-top: var(--s-5);
    padding-top: var(--s-3);
    border-top: 1px solid var(--surface-2);
  }
  .footer__bottom p {
    max-width: none;
  }
  .footer__legal {
    display: flex;
    gap: var(--s-3);
  }
  @media (max-width: 47.99rem) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

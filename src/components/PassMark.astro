---
/** An 8-bit tick on a 7x7 grid, drawn in the current colour. Decorative unless a label is given. */
interface Props {
  label?: string;
  class?: string;
}
const { label, class: className } = Astro.props;
const cells = [
  [6, 1],
  [5, 2],
  [4, 3],
  [3, 4],
  [2, 5],
  [1, 4],
  [0, 3],
];
---

<svg
  class:list={['passmark', className]}
  viewBox="0 0 7 7"
  shape-rendering="crispEdges"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {cells.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="currentColor" />)}
</svg>

<style>
  .passmark {
    display: block;
    width: 1em;
    height: 1em;
  }
</style>

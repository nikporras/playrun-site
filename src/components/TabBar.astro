---
/**
 * The bar along the foot of a phone (below 48rem), a game's HUD: the five pages, each a small
 * pixel icon over a short label, the page you are on in green. Plain links, so it works without
 * script, under reduced motion and with the games off. Its right end is left for the scoreboard's
 * counter (Hud.astro places it there while the games run), and the ship's progress line rides on
 * its top edge. It clears the iPhone's home indicator. Tablets and desktops keep the header nav.
 */
import { nav, primaryAction } from '../config';

// The build writes file routes (/skills.html, /index.html); the bar compares the clean address.
const current = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '/').replace(/([^/])$/, '$1/');
const items = [...nav, { label: 'Contact', href: primaryAction.href }];
// 8 by 8 pixel icons, one path each
const icons: Record<string, string> = {
  '/': 'M3 0h2v1H3zM2 1h4v1H2zM1 2h6v1H1zM0 3h8v1H0zM1 4h6v1H1zM1 5h2v3H1zM5 5h2v3H5z',
  '/skills/': 'M3 0h2v2H3zM0 2h8v1H0zM1 3h6v1H1zM2 4h4v1H2zM1 5h6v1H1zM1 6h2v1H1zM5 6h2v1H5zM1 7h1v1H1zM6 7h1v1H6z',
  '/portfolio/': 'M0 0h6v1H0zM0 1h7v1H0zM0 2h2v2H0zM6 2h2v2H6zM0 4h8v3H0zM0 7h1v1H0zM2 7h1v1H2zM4 7h1v1H4zM6 7h1v1H6z',
  '/quality/': 'M6 1h2v1H6zM5 2h2v1H5zM0 3h1v1H0zM4 3h2v1H4zM0 4h2v1H0zM3 4h2v1H3zM1 5h3v1H1zM2 6h1v1H2z',
  '/contact/': 'M0 1h8v1H0zM0 2h2v1H0zM6 2h2v1H6zM0 3h1v3H0zM7 3h1v3H7zM2 3h1v1H2zM5 3h1v1H5zM3 4h2v1H3zM0 6h8v1H0z',
};
---

<nav class="tabbar" aria-label="Site">
  <ul role="list" class="tabbar__list">
    {
      items.map((item) => (
        <li>
          <a class="tabbar__link" href={item.href} aria-current={current === item.href ? 'page' : undefined}>
            <svg class="tabbar__icon" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
              <path d={icons[item.href]} fill="currentColor" />
            </svg>
            <span class="tabbar__label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tabbar {
    display: none;
  }
  @media (max-width: 47.99rem) {
    .tabbar {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      padding-right: var(--counter-w, 0px);
      background: var(--pr-navy);
      border-top: 2px solid var(--surface-2);
    }
    .tabbar__list {
      display: flex;
      height: var(--bar-h);
      margin: 0;
      padding: 0;
    }
    .tabbar__list li {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
    }
    /* the longest label has a little more room */
    .tabbar__list li:has([href='/portfolio/']) {
      flex-grow: 1.3;
    }
    .tabbar__link {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
      min-height: 2.75rem;
      color: var(--muted);
      text-decoration: none;
      font-family: var(--font-display);
      font-size: var(--bar-label, 1rem);
      line-height: 1;
      white-space: nowrap;
    }
    .tabbar__link:hover {
      color: var(--ink);
    }
    .tabbar__link:focus-visible {
      outline-offset: -3px;
      color: var(--ink);
    }
    .tabbar__link[aria-current='page'] {
      color: var(--accent);
    }
    .tabbar__icon {
      width: var(--bar-icon, 1rem);
      height: var(--bar-icon, 1rem);
    }
  }
</style>

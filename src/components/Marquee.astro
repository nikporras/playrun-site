---
/**
 * The run-sheet ticker: one band, one lane, a build going through the test run with a pass mark
 * between the states. Pauses with the button and when off screen, never on hover. Static and
 * wrapping under prefers-reduced-motion. Needs no script to move.
 */
import PassMark from './PassMark.astro';

interface Props {
  run: string[];
}
const { run } = Astro.props;
---

<aside class="marquee" aria-label="Test run ticker">
  <div class="marquee__lanes">
  <div class="marquee__lane">
    {
      [false, true].map((copy) => (
        <ul role="list" class:list={['marquee__list', { 'marquee__copy': copy }]} aria-hidden={copy ? 'true' : undefined}>
          {run.map((item) => (
            <li class="marquee__item">
              <span>{item}</span>
              <PassMark class="marquee__mark" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
  </div>
  <button class="marquee__pause" type="button" aria-pressed="false" hidden>
    <span data-play-label>Pause</span>
  </button>
</aside>

<style>
  .marquee {
    margin-top: var(--gap);
    padding-block: var(--s-2);
    background: var(--surface);
    color: var(--ink);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--s-2);
  }
  .marquee__lanes {
    min-width: 0;
    overflow: clip;
    display: grid;
    gap: var(--s-1);
  }
  .marquee__lane {
    display: flex;
    width: max-content;
    white-space: nowrap;
    animation: marquee 70s linear infinite;
    will-change: transform;
  }
  .marquee__list {
    display: flex;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding-right: var(--s-3);
  }
  :global(.marquee__mark) {
    color: var(--accent);
    font-size: 1.5rem;
  }
  .marquee[data-paused] .marquee__lane {
    animation-play-state: paused;
  }
  .marquee__pause {
    margin-right: var(--margin);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1;
    padding: 0.5rem 0.75rem;
    background: var(--bg);
    color: var(--ink);
  }
  :global(.js) .marquee__pause[hidden] {
    display: inline-block;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 47.99rem) {
    .marquee__list {
      font-size: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__lane {
      animation: none;
      width: auto;
      white-space: normal;
    }
    .marquee__list {
      flex-wrap: wrap;
      row-gap: var(--s-1);
    }
    .marquee__copy,
    .marquee__pause {
      display: none !important;
    }
  }
</style>

<script>
  const band = document.querySelector<HTMLElement>('.marquee');
  const pause = band?.querySelector<HTMLButtonElement>('.marquee__pause');
  if (band && pause) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      pause.hidden = false;
      let byUser = false;
      const apply = () => {
        band.toggleAttribute('data-paused', byUser || !onScreen);
        pause.setAttribute('aria-pressed', String(byUser));
        pause.querySelector('[data-play-label]')!.textContent = byUser ? 'Play' : 'Pause';
      };
      let onScreen = true;
      pause.addEventListener('click', () => {
        byUser = !byUser;
        apply();
      });
      // Nonessential loops stop when hidden: pause the band while it is off screen.
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(
          (entries) => {
            onScreen = entries.some((e) => e.isIntersecting);
            apply();
          },
          { threshold: 0 },
        ).observe(band);
      }
      document.addEventListener('visibilitychange', () => {
        onScreen = !document.hidden;
        apply();
      });
    }
  }
</script>

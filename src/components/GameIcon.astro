const map: Record<string, string> = { b: 'px-blue', c: 'px-cyan', g: 'px-green', l: 'px-light', n: 'px-navy' };
const cells: { x: number; y: number; cls: string }[] = [];
(ART[name] ?? []).forEach((row, y) => [...row].forEach((ch, x) => map[ch] && cells.push({ x, y, cls: map[ch] })));
---

<svg class:list={['gameicon', className]} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  {cells.map((c) => <rect x={c.x} y={c.y} width="1" height="1" class={c.cls} />)}
</svg>

<style>
  .gameicon {
    display: block;
    image-rendering: pixelated;
  }
  .px-blue {
    fill: var(--pr-blue);
  }
  .px-cyan {
    fill: var(--pr-cyan);
  }
  .px-green {
    fill: var(--pr-green);
  }
  .px-light {
    fill: var(--pr-light);
  }
  .px-navy {
    fill: var(--pr-navy);
  }
</style>

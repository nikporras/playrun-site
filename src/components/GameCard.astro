---
/**
 * One title on the portfolio, a navy tile in two blocks. The game: its official logo in one colour
 * (or its pixel icon where no clean logo exists) with the year and status, the title, one line on
 * the game, and the studio and publisher. A thin rule. My part: what I did on it (the most
 * prominent text on the card), the kinds of testing as labels right under it, the platforms, and
 * one outline button to its store page in a new tab. The company's accent colours the labels
 * through --g-accent and --g-ink, set on the group around the card. On a phone, with script, the
 * card folds to one row (a button) that opens the whole card in place.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import GameIcon from './GameIcon.astro';
import ExternalLink from './ExternalLink.astro';
import PassMark from './PassMark.astro';
import { logos } from '../data/logos';

interface Props {
  project: CollectionEntry<'projects'>;
  /** A tag under the title, such as "via Universally Speaking". */
  via?: string;
  delay?: number;
  /** A target for the track's scan: once on screen and settled, the ship scans it (a bonus, never a gate). */
  scan?: boolean;
  /** Open in a phone's folded list (the first game of each company); the desktop always shows it whole. */
  open?: boolean;
}
const { project: p, via, delay = 0, scan = false, open = false } = Astro.props;
const panel = `card-${p.id}`;
const logo = logos[p.id];
const when = p.data.status === 'in-development' ? 'In development' : `${p.data.year} · Released`;
const store = p.data.store ?? 'Steam';
---

<article class:list={['card tile--live', open && 'is-open']} data-enter="place" data-scan={scan ? '' : undefined} data-card style={`--enter-delay: ${delay}ms`}>
  <span class="card__pass" aria-hidden="true"><PassMark /> Pass</span>
  <!-- On a phone (with script) the card folds to this row: a small logo, the title, the year and
       status, a chevron; it opens the whole card below it. -->
  <button type="button" class="card__toggle" aria-expanded={open ? 'true' : 'false'} aria-controls={panel} data-card-toggle>
    <span class="card__mini" aria-hidden="true">
      {logo ? <Image src={logo} alt="" height={56} densities={[1, 2]} loading="lazy" decoding="async" /> : !p.data.wordmark && <GameIcon name={p.data.icon} />}
    </span>
    <span class="card__name">{p.data.title}</span>
    <span class="card__state">{when}</span>
    <svg class="card__chevron" viewBox="0 0 7 5" shape-rendering="crispEdges" aria-hidden="true">
      <path d="M0 0h2v1H0zM5 0h2v1H5zM1 1h2v1H1zM4 1h2v1H4zM2 2h3v1H2zM3 3h1v1H3z" fill="currentColor"></path>
    </svg>
  </button>
  <div class="card__body" id={panel}>
    <div class="card__inner">
      <div class="card__top">
        <span class="card__logo">
          {logo ? (
            <Image src={logo} alt="" height={56} densities={[1, 2]} loading="lazy" decoding="async" />
          ) : p.data.wordmark ? (
            <span class="card__wordmark" aria-hidden="true">{p.data.title}</span>
          ) : (
            <GameIcon name={p.data.icon} />
          )}
        </span>
        <p class="card__when">{when}</p>
      </div>
      <h4 class="card__title">{p.data.title}</h4>
      {via && <p class="card__via">{via}</p>}
      <p class="card__summary">{p.data.summary}</p>
      <p class="card__makers">
        {p.data.studio}
        {p.data.publisher && (
          <>
            <span class="card__dot" aria-hidden="true">&middot;</span> {p.data.publisher}
          </>
        )}
      </p>
      <div class="card__part">
        {
          p.data.did && (
            <p class="card__did">
              <span class="card__didkey">What I did</span> {p.data.did}
            </p>
          )
        }
        {
          p.data.tags.length > 0 && (
            <ul role="list" class="card__tags" aria-label="Testing">
              {p.data.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )
        }
        <p class="card__platforms">{p.data.platforms.join(', ')}</p>
        {p.data.url && <ExternalLink class="button button--outline card__store" href={p.data.url}>View on {store}</ExternalLink>}
      </div>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-3);
    min-width: 0;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
    border-top: 0.25rem solid var(--g-accent, var(--accent-2));
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
  }
  /* The whole card's content; a grid row so a phone can fold it (0fr) and open it (1fr). */
  .card__body {
    flex: 1 1 auto;
    display: grid;
    grid-template-rows: 1fr;
  }
  .card__inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-height: 0;
    min-width: 0;
  }
  .card__toggle {
    display: none;
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-2);
    margin-bottom: var(--s-3);
  }
  .card__logo {
    display: block;
    height: 3.5rem;
    max-width: 11rem;
  }
  .card__logo :global(img) {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }
  .card__wordmark {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1;
    padding-top: 0.4rem;
  }
  .card__logo :global(.gameicon) {
    width: 3.5rem;
    height: 3.5rem;
  }
  /* The pixel icon takes the company's accent; its navy pixels stay navy. */
  .card__logo :global(.gameicon rect:not(.px-navy)) {
    fill: var(--g-accent, var(--accent-2));
  }
  .card__when {
    flex: none;
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--g-ink, var(--accent-2));
    max-width: none;
    padding-top: 0.25rem;
  }
  .card__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
    text-wrap: balance;
  }
  .card__via {
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--g-ink, var(--accent-2));
    max-width: none;
  }
  .card__makers {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--g-ink, var(--accent-2));
    max-width: none;
  }
  .card__dot {
    margin-inline: 0.2em;
  }
  /* My part, under a thin rule: what I did first, the most prominent text on the card (a step
     larger and brighter than the line on the game), its labels right under it, then the platforms
     and the button at the foot. */
  .card__part {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    margin-top: var(--s-2);
    padding-top: var(--s-2);
    border-top: 1px solid var(--rule);
  }
  .card__did {
    font-size: 1.125rem;
    line-height: 1.4;
    max-width: none;
    color: var(--ink);
  }
  .card__didkey {
    display: block;
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--g-ink, var(--accent-2));
    margin-bottom: 0.15em;
  }
  .card__summary {
    font-size: 1rem;
    max-width: none;
    color: var(--muted);
    margin-top: var(--s-1);
  }
  .card__makers {
    margin-top: 0;
  }
  /* The kinds of testing, as the labels a tracker would show them, right under what I did. */
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.125rem;
  }
  .card__tags li {
    font-family: ui-monospace, 'Cascadia Mono', Consolas, 'Courier New', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    padding: 0.1em 0.5em;
    border: 1px solid var(--g-ink, var(--accent-2));
    border-radius: 0.3rem;
    color: var(--g-ink, var(--accent-2));
    background: color-mix(in srgb, var(--g-accent, var(--accent-2)) 12%, transparent);
  }
  .card__platforms {
    font-size: 0.875rem;
    color: var(--muted);
    max-width: none;
    margin-top: var(--s-2);
  }
  .card__store {
    margin-top: var(--s-2);
    align-self: flex-start;
  }
  .card__platforms {
    margin-top: auto;
    padding-top: var(--s-2);
  }
  /* The scan: the track's bolt hits the card. Its border flashes green, a translucent green band
     with faint scanlines and a glowing leading edge sweeps it top to bottom like a QA pass, and a
     small PASS stamp pops into the top right corner, inside the padding, and stays. Nothing in the
     card moves. --card-h is set by the script at the shot, so the band knows how far to travel. */
  .card {
    --card-h: 100%;
  }
  .card::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 48px;
    background: repeating-linear-gradient(to bottom, rgba(103, 193, 140, 0.3) 0 2px, rgba(103, 193, 140, 0.14) 2px 4px);
    border-bottom: 2px solid var(--accent-2);
    box-shadow: 0 2px 12px var(--accent-2);
    opacity: 0;
    transform: translateY(-48px);
    pointer-events: none;
    z-index: 2;
  }
  .card__pass {
    position: absolute;
    top: 0.2rem;
    right: 0.25rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--accent);
    background: var(--bg);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.75rem;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    transform: scale(0.6);
    transform-origin: 100% 0;
    pointer-events: none;
  }
  .card__pass :global(.passmark) {
    width: 0.75rem;
    height: 0.75rem;
  }
  .card.is-scanned .card__pass {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .card.is-scanned {
      animation: card-flash 240ms steps(2) both;
    }
    .card.is-scanned::before {
      animation: scan-band 500ms linear 40ms both;
    }
    .card.is-scanned .card__pass {
      animation: pass-pop 200ms var(--ease-out) 600ms both;
    }
  }
  @keyframes card-flash {
    from {
      box-shadow: inset 0 0 0 3px var(--accent);
    }
    to {
      box-shadow: inset 0 0 0 0 var(--accent);
    }
  }
  @keyframes scan-band {
    0% {
      opacity: 1;
      transform: translateY(-48px);
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(var(--card-h));
    }
  }
  @keyframes pass-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 63.99rem) {
    .card {
      padding: var(--s-2);
    }
    .card__title {
      font-size: 1.75rem;
    }
  }
  /* A phone, with script: each card folds to a row, a button the width of the card. Open, the
     whole card follows it in place, the same content in the same order as on a desktop. */
  @media (max-width: 47.99rem) {
    :global(.js) .card {
      gap: 0;
      padding-block: 0.5rem 0;
    }
    :global(.js) .card__toggle {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr) auto 0.875rem;
      align-items: center;
      gap: 0.75rem;
      width: calc(100% + 2 * var(--s-2));
      min-height: 3rem;
      margin: 0 calc(-1 * var(--s-2));
      padding: 0.5rem var(--s-2) 0.75rem;
      color: var(--ink);
      text-align: left;
      font: inherit;
    }
    :global(.js) .card__toggle:focus-visible {
      outline-offset: -3px;
    }
    .card__mini {
      display: block;
      height: 1.5rem;
    }
    .card__mini :global(img) {
      height: 100%;
      width: auto;
      max-width: 100%;
      object-fit: contain;
      object-position: left center;
    }
    .card__mini :global(.gameicon) {
      width: 1.5rem;
      height: 1.5rem;
    }
    .card__mini :global(.gameicon rect:not(.px-navy)) {
      fill: var(--g-accent, var(--accent-2));
    }
    .card__name {
      font-family: var(--font-display);
      font-size: 1.25rem;
      line-height: 1.1;
    }
    .card__state {
      font-family: var(--font-display);
      font-size: 0.875rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-align: right;
      color: var(--g-ink, var(--accent-2));
    }
    .card__chevron {
      width: 0.875rem;
      height: 0.625rem;
      color: var(--g-ink, var(--accent-2));
    }
    :global(.js) .card.is-open .card__chevron {
      transform: rotate(180deg);
    }
    /* open, the card itself shows the logo and the year right below: the row keeps the title */
    :global(.js) .card.is-open .card__mini,
    :global(.js) .card.is-open .card__state {
      visibility: hidden;
    }
    :global(.js) .card__body {
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows 260ms var(--ease-out),
        visibility 0s linear 260ms;
    }
    :global(.js) .card.is-open .card__body {
      grid-template-rows: 1fr;
      visibility: visible;
      transition-delay: 0s;
    }
    :global(.js) .card__inner {
      overflow: hidden;
    }
    /* (spacing as margins inside the clip: padding on the folding row would keep it from closing) */
    :global(.js) .card__top {
      margin-top: var(--s-1);
    }
    :global(.js) .card__part {
      margin-bottom: var(--s-2);
    }
  }
  @media (max-width: 47.99rem) and (prefers-reduced-motion: reduce) {
    :global(.js) .card__body {
      transition: none;
    }
  }
</style>

---
/**
 * One title on the portfolio page: a navy tile with the stage number, the game's generic pixel
 * icon, the title as a link to the game's store page (a new tab), the studio, a short description
 * and the platforms. The company's accent colours the details through --g-accent and --g-ink,
 * set on the group around the card. The whole tile is the link, through the title's ::after,
 * while the text sits above that layer so it can still be selected with the mouse.
 */
import type { CollectionEntry } from 'astro:content';
import GameIcon from './GameIcon.astro';
import ExternalLink from './ExternalLink.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  number: number;
  /** A tag under the title, such as "via Universally Speaking". */
  via?: string;
  delay?: number;
}
const { project: p, number, via, delay = 0 } = Astro.props;
const when = p.data.status === 'in-development' ? 'In development' : p.data.year;
---

<article class="stage tile--live" data-enter="place" style={`--enter-delay: ${delay}ms`}>
  <p class="stage__num">Stage {number}</p>
  <span class="stage__mark"><GameIcon name={p.data.icon} /></span>
  <h4 class="stage__title">
    {p.data.url ? <ExternalLink class="stage__link" href={p.data.url}>{p.data.title}</ExternalLink> : <span>{p.data.title}</span>}
  </h4>
  {via && <p class="stage__via">{via}</p>}
  <p class="stage__studio">{p.data.studio}</p>
  <p class="stage__summary">{p.data.summary}</p>
  <p class="stage__meta">
    {when}. {p.data.platforms.join(', ')}.
    {!p.data.public && ' Sample entry.'}
  </p>
</article>

<style>
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-1);
    padding: 5rem var(--s-3) var(--s-3);
    min-width: 0;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
    border-top: 0.25rem solid var(--g-accent, var(--accent-2));
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
  }
  .stage__num {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--g-ink, var(--accent-2));
    max-width: none;
  }
  .stage__mark {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    width: 3rem;
    height: 3rem;
  }
  .stage__mark :global(.gameicon) {
    width: 100%;
    height: 100%;
  }
  /* The icon takes the company's accent; its navy pixels stay navy. */
  .stage__mark :global(.gameicon rect:not(.px-navy)) {
    fill: var(--g-accent, var(--accent-2));
  }
  .stage__title {
    font-size: 2.25rem;
  }
  .stage__link {
    text-decoration-color: var(--g-ink, var(--accent-2));
  }
  /* The whole tile opens the title. */
  .stage__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  /* The text lives above that layer, so a drag selects it instead of dragging the link. */
  .stage__via,
  .stage__studio,
  .stage__summary,
  .stage__meta {
    position: relative;
    z-index: 1;
  }
  .stage__via {
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--g-ink, var(--accent-2));
    max-width: none;
  }
  .stage__studio {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--g-ink, var(--accent-2));
    max-width: none;
  }
  .stage__summary {
    font-size: 1rem;
    max-width: 44ch;
  }
  .stage__meta {
    font-size: 1rem;
    color: var(--muted);
    max-width: 44ch;
  }
  @media (max-width: 63.99rem) {
    .stage {
      min-height: 14rem;
      padding: 4rem var(--s-2) var(--s-3);
    }
    .stage__num,
    .stage__mark {
      top: var(--s-2);
    }
    .stage__num {
      left: var(--s-2);
    }
    .stage__mark {
      right: var(--s-2);
      width: 2.25rem;
    }
    .stage__title {
      font-size: 1.75rem;
    }
  }
</style>

---
import Lockup from '../assets/logo/logo-horizontal.svg';
import { nav, primaryAction, site } from '../config';

// The build writes file routes (/skills.html, /index.html); the nav compares the clean address.
const current = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '/').replace(/([^/])$/, '$1/');
---

<header class="header wrap">
  <div class="header__start">
    <a class="header__brand" href="/" aria-label={`${site.name}, home`}>
      <Lockup class="header__lockup" aria-hidden="true" role="presentation" />
    </a>
    <!-- Motion on or off for this site (with script): it follows the device's setting until the
         visitor chooses, and their choice wins either way -->
    <button type="button" class="motion" aria-pressed="true" data-motion>
      <span class="motion__label">Motion</span>
      <span class="motion__state" aria-hidden="true"><span class="motion__on">On</span><span class="motion__off">Off</span></span>
      <span class="motion__why" aria-hidden="true">(device setting)</span>
      <span class="visually-hidden" data-motion-note></span>
    </button>
  </div>

  <nav class="header__nav" aria-label="Site">
    <ul role="list" class="header__links">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="button header__action" href={primaryAction.href}>{primaryAction.label}</a>
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 4.5rem;
    position: relative;
    z-index: 5;
  }
  .header__brand {
    display: block;
    color: var(--ink);
    text-decoration: none;
    flex: none;
  }
  .header__brand:hover,
  .header__brand:focus-visible {
    color: var(--accent-2);
  }
  .header__lockup {
    height: 2rem;
    width: auto;
    transition: color var(--dur-fast) ease;
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .header__links {
    display: flex;
    gap: var(--s-3);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
  }
  .header__links a {
    display: inline-block;
    padding: 0.75rem 0.25rem;
    text-decoration: none;
    color: var(--ink);
    position: relative;
  }
  .header__links a::after {
    content: '';
    position: absolute;
    left: 0.25rem;
    right: 0.25rem;
    bottom: 0.35rem;
    height: 0.25rem;
    background: var(--accent-2);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .header__links a:hover::after,
  .header__links a:focus-visible::after,
  .header__links a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .header__links a[aria-current='page']::after {
    background: var(--accent);
  }
  /* Phones and tablets have the bottom bar (TabBar.astro) instead: the header keeps the logo, the
     way home. */
  @media (max-width: 63.99rem) {
    .header__nav {
      display: none;
    }
  }
  .header__start {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  /* The Motion switch: a small HUD toggle, its state in green (on) or muted (off). */
  .motion {
    display: none;
    align-items: center;
    gap: 0.5em;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 2px solid var(--surface-2);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.875rem;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  :global(.js) .motion {
    display: inline-flex;
  }
  .motion:hover {
    border-color: var(--accent-2);
  }
  .motion:focus-visible {
    outline-offset: 2px;
  }
  .motion__state {
    min-width: 2.25em;
    padding: 0.2em 0.4em;
    background: var(--accent);
    color: var(--pr-navy);
    text-align: center;
  }
  .motion__off,
  .motion[aria-pressed='false'] .motion__on {
    display: none;
  }
  .motion[aria-pressed='false'] .motion__off {
    display: inline;
  }
  .motion[aria-pressed='false'] .motion__state {
    background: var(--surface-2);
    color: var(--ink);
  }
  /* Off only because the device asks for reduced motion, until the visitor chooses: the reason
     beside the state, and on a phone, where the header is narrow, on a second line under it. */
  .motion__why {
    display: none;
    white-space: nowrap;
  }
  .motion.is-device .motion__why {
    display: inline;
  }
  @media (max-width: 47.99rem) {
    .motion.is-device {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.25rem 0.5em;
      padding-block: 0.25rem;
    }
    .motion.is-device .motion__why {
      flex-basis: 100%;
      font-size: 0.75rem;
      letter-spacing: 0;
      text-align: center;
    }
  }
  /* The narrowest phones (under about 340px): a slightly smaller logo and a tighter switch, so the
     header never runs past the screen's edge. */
  @media (max-width: 21.5rem) {
    .header__lockup {
      height: 1.625rem;
    }
    .header__start {
      gap: var(--s-1);
    }
    .motion {
      gap: 0.35em;
      padding: 0 0.5rem;
      font-size: 0.8125rem;
      letter-spacing: 0.04em;
    }
  }
</style>

<script>
  import { reducedMotion, offByDevice, setMotion, onMotionChange } from '../scripts/motion';
  const button = document.querySelector<HTMLButtonElement>('[data-motion]');
  const note = button?.querySelector<HTMLElement>('[data-motion-note]');
  if (button && note) {
    // On, Off, or Off (device setting) while it is off only because the device asks for reduced
    // motion; a press turns it on even then, and the choice is kept.
    const show = () => {
      const device = reducedMotion() && offByDevice();
      button.setAttribute('aria-pressed', String(!reducedMotion()));
      button.classList.toggle('is-device', device);
      note.textContent = device ? ', off by your device setting' : '';
    };
    button.addEventListener('click', () => setMotion(reducedMotion()));
    onMotionChange(show);
    show();
  }
</script>

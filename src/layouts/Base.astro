---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/400-italic.css';
import '@fontsource/montserrat/600.css';
import '../styles/global.css';
import montserrat400 from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hud from '../components/Hud.astro';
import { site } from '../config';

interface Props {
  title: string;
  description?: string;
  /** Full page title override (the home page uses the brand line). */
  fullTitle?: string;
  ogImage?: string;
}

const { title, description = site.description, fullTitle, ogImage = '/og.png' } = Astro.props;
const pageTitle = fullTitle ?? `${title} | ${site.name}, ${site.tagline}`;
// The build writes file routes (/about.html); the public address is the clean one (/about).
const canonical = new URL(Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, ''), Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />

    <link rel="preload" href="/fonts/PixelOperator.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserrat400} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      document.documentElement.classList.add('js');
      window.__playrunErrors = [];
      addEventListener('error', (e) => window.__playrunErrors.push(String(e.message || e)));
      addEventListener('unhandledrejection', (e) => window.__playrunErrors.push(String(e.reason || e)));
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Hud />
    <script>
      // Section entrances: once, in reading order, with the stagger set per element in --enter-delay.
      // Landings ([data-land]) are announced to the track, which fires its laser and lands them;
      // if nothing answers they land on their own.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll<HTMLElement>('[data-enter], [data-land]');
      const show = (el: Element) => {
        if (el.hasAttribute('data-land')) {
          if (el.classList.contains('is-landed') || el.hasAttribute('data-landing')) return;
          el.setAttribute('data-landing', '');
          if (reduce) {
            el.classList.add('is-landed');
            return;
          }
          document.dispatchEvent(new CustomEvent('playrun:land', { detail: el }));
          setTimeout(() => el.classList.add('is-landed'), 700);
          return;
        }
        el.classList.add('is-in');
      };
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach(show);
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                show(e.target);
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0 },
        );
        items.forEach((el) => io.observe(el));
        // Belt and braces: whatever is on screen shows on the next frame of every scroll, and
        // everything shows after a few seconds regardless, so no heading can stay clipped.
        const sweep = () => {
          for (const el of items) {
            if (el.classList.contains('is-in')) continue;
            const r = el.getBoundingClientRect();
            if (r.top < innerHeight && r.bottom > 0) show(el);
          }
        };
        setTimeout(sweep, 50);
        let queued = false;
        addEventListener(
          'scroll',
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              sweep();
            });
          },
          { passive: true },
        );
        setTimeout(() => items.forEach(show), 4000);
      }
    </script>
  </body>
</html>

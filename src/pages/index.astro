---
import { getCollection } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PassMark from '../components/PassMark.astro';
import CrossMark from '../components/CrossMark.astro';
import Bug from '../components/Bug.astro';
import Join from '../components/Join.astro';
import GameIcon from '../components/GameIcon.astro';
import HeroHalo from '../components/HeroHalo.astro';
import { suite } from '../data/suite';
import { logos } from '../data/logos';
import { contact, employers, leadRoles, listed, playrun, primaryAction, since, site } from '../config';

import portrait from '../assets/photos/nicolas.png';

// Every public title on the ticker, apart from one whose logo would repeat another's (`wall`).
// The biggest names lead the sequence, Cyberpunk 2077 in the middle of them, so they are on screen
// at the start; the rest follow in the order of the portfolio, by post, newest first.
const all = await getCollection('projects');
const shown = import.meta.env.DEV ? all : all.filter((p) => p.data.public);
const order = employers.map((e) => e.id);
const byPost = shown
  .filter((p) => p.data.wall)
  .sort((a, b) => {
    const g = order.indexOf(a.data.employer) - order.indexOf(b.data.employer);
    const aDev = a.data.status === 'in-development' ? 1 : 0;
    const bDev = b.data.status === 'in-development' ? 1 : 0;
    return g || aDev - bDev || (b.data.year ?? 0) - (a.data.year ?? 0);
  });
const FEATURED = ['beat-saber', 'nba-2k21', 'cyberpunk-2077', 'ghostbusters-rise-of-the-ghost-lord', 'lous-lagoon'];
// Each logo's size on the ticker, by eye rather than by one height: the same visual weight for a
// wide wordmark (shorter) and a tall stacked mark (narrower). From the file's own aspect ratio,
// in rem at desktop; the CSS scales the whole set down on tablets and phones.
const size = (id: string) => {
  const img = logos[id];
  if (!img) return '--lw: 12rem; --lh: 4rem';
  const ratio = img.width / img.height;
  let h = Math.min(7, Math.max(2, 7.9 / Math.sqrt(ratio)));
  let w = h * ratio;
  if (w > 18) {
    w = 18;
    h = w / ratio;
  }
  return `--lw: ${w.toFixed(2)}rem; --lh: ${h.toFixed(2)}rem`;
};
const wall = [...FEATURED.flatMap((id) => byPost.filter((p) => p.id === id)), ...byPost.filter((p) => !FEATURED.includes(p.id))];

// The numbers, counted from the data so they stay right as it grows. A VR game is one whose
// platform line names a headset, or one flagged `vr` (Londinium, whose platform line is Steam
// alone); a lead role is one flagged `lead` in the employers.
const isVR = (p: (typeof shown)[number]) => p.data.vr || p.data.platforms.some((name) => /VR|Quest/i.test(name));
// Each stat carries a short caption, shown under it while it is the active row: light, and true.
const stats = [
  { n: new Date().getFullYear() - since, suffix: '+', label: 'years in QA', cap: 'Started in 2021. Still finding things.' },
  { n: new Set(employers.map((e) => e.name)).size, suffix: '', label: 'companies', cap: 'From outsourced QA to in-house teams.' },
  { n: shown.length, suffix: '', label: 'games', cap: 'Released titles and games still in development.' },
  { n: shown.filter(isVR).length, suffix: '', label: 'VR games', cap: 'Headset tan included.' },
  { n: 10, suffix: '+', label: 'platforms', cap: 'Consoles, PC stores and VR headsets.' },
  { n: leadRoles.length, suffix: '', label: 'QA lead roles', cap: `At ${listed([...new Set(leadRoles.map((r) => r.at))])}.` },
];

const ALT = 'Nicolás Porras wearing a VR headset pushed up on his head';
// For the description: the lead roles counted from the data, in words.
const leadCount = leadRoles.length;
const numberWords = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];

// The run that built this page. GitHub Actions builds only after the suite has passed, so the
// numbers on the board are that run's. Local builds carry no run.
const runDate = suite.run ? suite.run.startedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : null;
// The eight live checks the button runs on this page, in the visitor's browser. Until they run,
// each panel shows the suite's own checks for that area (tagged in the spec files), from the run
// that built the page; the line above the board carries the whole suite's numbers.
const checks = [
  { id: 'pages', title: 'Pages load', detail: 'Every route answers 200 and renders one h1. No blank screens.' },
  { id: 'console', title: 'Zero console errors', detail: 'Nothing red in the console, no request left failing.' },
  { id: 'links', title: 'Internal links resolve', detail: 'Every internal link answers 200. No 404s hiding in the footer.' },
  { id: 'viewports', title: 'Three widths', detail: 'No sideways scroll at 375, 768 and 1440 pixels. Phones count.' },
  { id: 'a11y', title: 'Accessibility scan', detail: 'axe-core finds no violations. Keyboard and screen readers get the whole page.' },
  { id: 'brand', title: 'Brand assets', detail: 'Both typefaces load, the logo renders, favicon and Open Graph image present.' },
  { id: 'weight', title: 'Page weight', detail: 'Every page under its budget on a first visit: HTML, CSS, script, fonts and images.' },
  { id: 'html', title: 'Valid HTML', detail: 'Every page passes an HTML validator: elements, attributes, ids and the document.' },
];
---

<Base
  title="Home"
  kind="ProfilePage"
  fullTitle={`${contact.name}, Game QA Tester in London | ${site.name}`}
  description={`Game QA portfolio of ${contact.name} in London: testing console, PC and VR games since ${since}, from compliance (CQA) to release, including ${numberWords[leadCount]} QA lead roles.`}
>
  <!-- Level 1: the start screen. It stays pinned while the next level slides up over it. -->
  <section class="level level--navy level--sky hero" data-level="1" aria-labelledby="hero-title">
    <div class="level__head hero__head">
      <p class="flag" data-nosnippet data-load style="--d: 0ms"><span>Level 1 &middot; Start</span></p>
      <div class="hero__name">
        <h1 id="hero-title" class="hero__title">
          <span class="hero__mask"><span class="hero__line" style="--i: 0">Nicolás</span></span>{' '}
          <span class="hero__mask"><span class="hero__line" style="--i: 1">Porras</span></span>
        </h1>
        <!-- The glitch: four slices of a copy of the name, shown for a moment as the hero scrolls
             away (decorative; the real heading never moves) -->
        <div class="hero__title hero__glitch" aria-hidden="true" data-glitch>
          {[0, 1, 2, 3].map((i) => (
            <span class="hero__slice" style={`--i: ${i}`}>
              <span>Nicolás</span>{' '}
              <span>Porras</span>
            </span>
          ))}
        </div>
      </div>
      <p class="hero__post" data-load style="--d: 400ms">{playrun.role}, {site.name}</p>
      <p class="hero__value" data-load style="--d: 500ms">
        I'm a game QA tester in London. I've tested console, PC and VR games since {since}, and led QA teams at {listed([...new Set(leadRoles.map((r) => r.at))])}.{' '}
        <a class="textlink" href="/about/">More about me</a>
      </p>
    </div>
    <!-- The player character: the one photo on the site, standing on the bottom edge of the level -->
    <div class="hero__figure" data-load style="--d: 200ms">
      <!-- (the pixel halo behind it, drawn for the desktop photo and for the smaller one) -->
      <div class="hero__photo">
      <HeroHalo photo={500} class="hero__halo hero__halo--500" />
      <HeroHalo photo={380} class="hero__halo hero__halo--380" />
      <HeroHalo photo={264} class="hero__halo hero__halo--264" />
      <HeroHalo photo={200} class="hero__halo hero__halo--200" />
      <HeroHalo photo={160} class="hero__halo hero__halo--160" />
      <HeroHalo photo={110} class="hero__halo hero__halo--110" />
      <HeroHalo photo={80} class="hero__halo hero__halo--80" />
      <Picture
        src={portrait}
        alt={ALT}
        widths={[400, 640, 960, 1280]}
        sizes="(max-width: 63.99rem) 70vw, 36vw"
        formats={['avif']}
        fallbackFormat="webp"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      </div>
    </div>
    <Bug id="hero-1" style="left: 40%; top: 2rem" tablet="right: 4%; top: 0.5rem" walk="x 2rem" />
  </section>

  <!-- The card the glitch raises (the script docks it with the scoreboard, where the toasts open) -->
  <div class="glitchcard" data-glitch-card data-nosnippet hidden>
    <p class="glitchcard__text" tabindex="-1" aria-live="polite" data-glitch-text>Glitch on the name. Track it?</p>
    <div class="glitchcard__actions" data-glitch-actions>
      <button type="button" class="glitchcard__btn glitchcard__btn--yes" data-glitch-yes>
        <span aria-hidden="true"><PassMark /></span><span class="visually-hidden">Track the bug</span>
      </button>
      <button type="button" class="glitchcard__btn glitchcard__btn--no" data-glitch-no>
        <span aria-hidden="true"><CrossMark /></span><span class="visually-hidden">Ignore</span>
      </button>
    </div>
  </div>

  <!-- Level 2: the ticker of titles, their official logos in one colour, rolling slowly left. All
       centred, on the clouds at the top of the level and on the first screen: the label, the row of
       logos, then Pause and the link. The heading is for the outline and screen readers only. -->
  <section class="level level--blue level--tight has-join-top has-join-bottom wall" data-level="2" data-ticker aria-labelledby="wall-title">
    <Join kind="clouds" at="top" from="var(--pr-navy)" to="var(--field-blue)" seed="home-wall" />
    <Join kind="terrain" from="var(--field-blue)" to="var(--pr-navy)" seed="home-stats" />
    <div class="level__head wall__head">
      <p class="flag" data-nosnippet data-enter><span>Level 2 &middot; Games</span></p>
      <h2 id="wall-title" class="wall__title visually-hidden">Games I've tested</h2>
    </div>
    <div class="ticker">
      <div class="ticker__view">
        <div class="ticker__track" style={`--n: ${wall.length}`}>
          {
            [false, true].map((copy) => (
              <ul role="list" class:list={['ticker__seq', copy && 'ticker__copy']} aria-hidden={copy ? 'true' : undefined}>
                {wall.map((p, i) => (
                  <li class="wall__item">
                    <span class="wall__mark" style={size(p.id)}>
                      {logos[p.id] ? (
                        <Image
                          class="wall__logo"
                          src={logos[p.id]}
                          alt={copy ? '' : p.data.title}
                          height={120}
                          densities={[1, 2]}
                          loading={!copy && i < 5 ? 'eager' : 'lazy'}
                          fetchpriority={!copy && i < 5 ? 'high' : undefined}
                          decoding="async"
                        />
                      ) : p.data.wordmark ? (
                        <span class="wall__word">{p.data.title}</span>
                      ) : (
                        <span class="wall__name">
                          <GameIcon name={p.data.icon} />
                          <span>{p.data.title}</span>
                        </span>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>
    </div>
    <div class="level__actions wall__actions" data-enter style="--enter-delay: 80ms">
      <button type="button" class="ticker__pause" data-ticker-pause aria-label="Pause the logos">
        <svg class="ticker__glyph ticker__glyph--pause" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><path d="M1 0h2v7H1zM4 0h2v7H4z" fill="currentColor" /></svg>
        <svg class="ticker__glyph ticker__glyph--play" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><path d="M1 0h1v7H1zM2 1h1v5H2zM3 1h1v5H3zM4 2h1v3H4zM5 3h1v1H5z" fill="currentColor" /></svg>
        <span data-ticker-word>Pause</span>
      </button>
      <!-- the logos are pictures only; the way on to the games is this link -->
      <a class="textlink wall__more" href="/portfolio/">See every game I've tested</a>
    </div>
    <Bug id="wall-1" style="right: 5%; bottom: calc(var(--join-h) + 0.25rem)" tablet="right: 5%; bottom: calc(var(--join-h) + 0.25rem)" phone="right: 1rem; bottom: 0.25rem" walk="x -2rem" />
  </section>

  <!-- Level 3: the numbers, counted from the portfolio, on a drum that turns: five rows on show,
       the active one in the centre, the six stats three times over so the loop never ends and no
       stat shows twice at once (the outer copies hidden from assistive tech). A still list
       without script or under reduced motion. -->
  <section class="level level--navy has-join-bottom stats" data-level="3" aria-labelledby="stats-title">
    <Join kind="clouds" from="var(--pr-navy)" to="var(--field-green)" seed="home-proof" />
    <div class="stats__grid">
      <div class="level__head stats__head">
        <p class="flag" data-nosnippet data-enter><span>Level 3 &middot; Stats</span></p>
        <h2 id="stats-title" class="level__title stats__title" data-enter="wipe">My game QA career in numbers</h2>
      </div>
      <div class="drum level__body" data-drum data-count={stats.length} role="group" aria-labelledby="stats-title" data-enter style="--enter-delay: 120ms">
        <div class="drum__view">
          <ul role="list" class="drum__list">
            {
              [0, 1, 2].flatMap((copy) =>
                stats.map((s, k) => (
                  <li class:list={['drum__row', copy !== 1 && 'drum__clone']} aria-hidden={copy !== 1 ? 'true' : undefined} data-d={Math.min(2, Math.abs(copy * stats.length + k - stats.length))}>
                    <span class="drum__num num">
                      {s.n}
                      {s.suffix}
                    </span>
                    <span class="drum__text">
                      <span class="drum__label">{s.label}</span>
                      <span class="drum__cap">{s.cap}</span>
                    </span>
                  </li>
                )),
              )
            }
          </ul>
        </div>
        <div class="drum__controls">
          <button type="button" class="drum__button" data-drum-prev aria-label="Previous stat">
            <svg viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><path d="M3 1h1v1H3zM2 2h3v1H2zM1 3h5v1H1zM0 4h7v1H0z" fill="currentColor" /></svg>
          </button>
          <button type="button" class="drum__button" data-drum-next aria-label="Next stat">
            <svg viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><path d="M0 2h7v1H0zM1 3h5v1H1zM2 4h3v1H2zM3 5h1v1H3z" fill="currentColor" /></svg>
          </button>
          <button type="button" class="drum__button drum__button--pause" data-drum-pause aria-label="Pause the stats">
            <svg class="drum__glyph drum__glyph--pause" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><path d="M1 0h2v7H1zM4 0h2v7H4z" fill="currentColor" /></svg>
            <svg class="drum__glyph drum__glyph--play" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><path d="M1 0h1v7H1zM2 1h1v5H2zM3 1h1v5H3zM4 2h1v3H4zM5 3h1v1H5z" fill="currentColor" /></svg>
          </button>
        </div>
        <p class="visually-hidden" aria-live="polite" data-drum-live></p>
      </div>
    </div>
    <Bug id="stats-1" style="left: 42%; bottom: 1.5rem" tablet="right: 8%; bottom: 0.75rem" phone="right: 1rem; bottom: 0.25rem" walk="x 2rem" />
  </section>

  <!-- Level 4: proof as a scoreboard on a green field -->
  <section class="level level--green has-join-bottom proof" data-level="4" aria-labelledby="proof-title">
    <Join kind="terrain" from="var(--field-green)" to="var(--field-light)" seed="home-final" />
    <div class="level__head">
      <p class="flag" data-nosnippet data-enter><span>Level 4 &middot; Proof</span></p>
      <h2 id="proof-title" class="level__title" data-enter="wipe">This site, tested like my games</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">
        I test this site like a game: a Playwright suite checks every change, and nothing goes live until it passes. Try the checks yourself.
      </p>
      <div class="level__actions" data-enter style="--enter-delay: 160ms">
        <button class="button button--navy" type="button" id="selftest" aria-describedby="selftest-status">Test this page</button>
        <a class="textlink proof__link" href="/quality/">How I test this site</a>
      </div>
      <p id="selftest-status" class="proof__status" data-nosnippet aria-live="polite" data-enter style="--enter-delay: 200ms">
        {suite.run ? `${suite.passed} of ${suite.total} checks passed in the last run${runDate ? `, on ${runDate}` : ''}` : `${suite.total} checks run before every deploy`}
      </p>
      <p class="proof__score" id="selftest-score" data-nosnippet hidden>
        <span data-score-mark class="proof__scoremark"><PassMark /></span>
        <span data-score>Not run yet</span>
        <span data-score-word></span>
      </p>
    </div>
    <div class="proof__board level__body">
      {
        checks.map((g, i) => {
          const a = suite.areas[g.id] ?? { total: 0, passed: 0, failed: 0 };
          // From a run: ticked (or crossed) with its passes. A local build has only the list: the count, unticked.
          const state = suite.run ? (a.failed ? 'is-failed' : 'is-pass') : 'is-idle';
          return (
          <div class:list={['panel', state]} style={`--enter-delay: ${i * 60}ms`} data-check={g.id} data-enter="scan" data-from={suite.run ? 'run' : 'list'}>
            <div class="panel__mark" aria-hidden="true">
              <svg class="proof__idle" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><path d="M0 0h7v1H0zM0 6h7v1H0zM0 1h1v5H0zM6 1h1v5H6z" fill="currentColor" /></svg>
              <PassMark class="proof__pass" />
              <CrossMark class="proof__cross" />
            </div>
            <p class="panel__num num">
              {g.id === 'weight' && suite.homeWeight ? (
                <>
                  {/* (one line: no space before the comma) */}
                  <span data-count>{suite.homeWeight.kb} KB</span><span class="panel__of">, budget {suite.homeWeight.budget} KB</span>
                </>
              ) : (
                <>
                  <span data-count>{suite.run ? a.passed : a.total}</span>
                  <span class="panel__of">{suite.run ? ` of ${a.total}` : ' checks'}</span>
                </>
              )}
            </p>
            <h3 class="panel__title">{g.title}</h3>
            <p class="panel__detail" data-detail>{g.detail}</p>
          </div>
          );
        })
      }
    </div>
    <Bug id="proof-1" style="right: 12%; top: 1.5rem" tablet="right: 20%; top: 0.75rem" phone="left: 1rem; bottom: 0.25rem" walk="x -2rem" />
  </section>

  <!-- Level 5: after hours, and the one last button -->
  <section class="level level--light has-join-bottom final" data-level="5" aria-labelledby="final-title">
    <Join kind="terrain" from="var(--field-light)" to="var(--pr-navy)" seed="home-foot" />
    <div class="level__head">
      <p class="flag" data-nosnippet data-enter><span>Level 5 &middot; Final level</span></p>
      <h2 id="final-title" class="level__title" data-enter="wipe">After hours</h2>
      <p class="final__text" data-enter style="--enter-delay: 80ms">
        I play and pull apart games for the mechanics and the design choices, Helldivers, The Witcher and God of War
        lately. I play instruments and dance, music is a big part of my culture, and I am learning the drums. I watch
        and play most sports.
      </p>
      <div class="level__actions final__actions" data-enter style="--enter-delay: 160ms">
        <a class="button" href={primaryAction.href}>{primaryAction.label}</a>
        <a class="final__mail" href={`mailto:${contact.email}`}>{contact.email}</a>
      </div>
    </div>
    <Bug id="final-1" style="right: 10%; top: 2rem" tablet="right: 8%; bottom: 1rem" phone="right: 1rem; bottom: 0.25rem" walk="x -2rem" />
  </section>
</Base>

<style>
  /* Level 1: the text on the left, the figure on the right, the whole level a screen tall. When
     motion is allowed it is pinned, and Level 2 slides up and covers it like a curtain. */
  /* The first screen ends with the top of Level 2: its clouds and, resting on them, the row of
     logos (the peek). The hero is the rest of the screen under the header. */
  .hero,
  .wall {
    /* Level 2 is one centred block on the blue between its two cloud joins: the label, the row of
       logos, then Pause and the link, an even gap between them and the same gap to the clouds above
       and below. The label sits in a zone as tall as the Pause and link row, so the logos are in
       the middle of the blue. */
    --cell-h: 7rem; /* the logo row (the tallest logo is 7rem) */
    --zone: 2rem; /* the label's zone, and the Pause and link row */
    --gap: var(--s-2); /* between the label, the logos and the row */
    --edge: var(--s-3); /* between the block and the clouds */
    --peek: calc(var(--join-h) + var(--edge) + var(--zone) + var(--gap) + var(--cell-h));
  }
  .hero {
    min-height: calc(100svh - var(--hud-space, 0px) - 4.5rem - var(--peek));
    display: flex;
    flex-direction: column;
    justify-content: center;
    --hero-pt: var(--s-4);
    --hero-pb: var(--s-4);
    padding-top: var(--hero-pt);
    padding-bottom: var(--hero-pb);
  }
  @media (max-width: 63.99rem) {
    :global(.games) .hero {
      --hud-space: var(--hud-h);
    }
  }
  /* a phone's bottom bar is there with the games on or off */
  @media (max-width: 47.99rem) {
    .hero {
      --hud-space: var(--hud-h);
    }
  }
  .hero {
    position: sticky;
    top: var(--hero-top, 0px);
    z-index: 0;
    will-change: opacity; /* it fades as the name breaks: on its own layer, nothing repaints */
  }
  .hero__head {
    max-width: 58%;
    gap: var(--s-4);
  }
  .hero__head .flag {
    margin-bottom: 0;
  }
  .hero__name {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }
  .hero__title {
    font-size: var(--step-hero);
    font-size: round(min(var(--step-hero), calc((100svh - 4.5rem - var(--peek)) * 0.22)), 16px);
    line-height: 0.9;
    max-width: none;
    text-wrap: initial;
    margin-left: -0.03em;
  }
  .hero__mask {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero__line {
    display: block;
  }
  /* The glitch: four slices of a copy of the name over the real one (the heading's own size at
     every width), each jumping 12 to 20px sideways (8 to 12px on a phone) with a strong cyan and
     pink split, in two quick bursts over about 0.7 s: two flashes, and the script never starts
     another within 1.2 s, so never more than three a second. Shown only while the script holds it
     on (never with motion off). */
  .hero__glitch {
    display: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink);
  }
  .hero__glitch.is-on {
    display: block;
  }
  .hero__slice {
    --amp: 1;
    --split: 4px;
    position: absolute;
    inset: 0;
    text-shadow:
      calc(var(--split) * -1) 0 var(--pr-cyan),
      var(--split) 0 #ff5fa2;
  }
  @media (max-width: 47.99rem) {
    .hero__slice {
      --amp: 0.6;
      --split: 3px;
    }
  }
  .hero__slice span {
    display: block;
  }
  .hero__slice:nth-child(1) {
    clip-path: inset(6% 0 76% 0);
    --dx: calc(-15px * var(--amp));
  }
  .hero__slice:nth-child(2) {
    clip-path: inset(30% 0 54% 0);
    --dx: calc(18px * var(--amp));
  }
  .hero__slice:nth-child(3) {
    clip-path: inset(56% 0 30% 0);
    --dx: calc(-14px * var(--amp));
  }
  .hero__slice:nth-child(4) {
    clip-path: inset(80% 0 4% 0);
    --dx: calc(20px * var(--amp));
  }
  /* two bursts (0 to 0.24 s and 0.45 to 0.7 s), each a jump one way then the other, the copy gone
     between them */
  .hero__glitch.is-on .hero__slice {
    animation: glitch-slice 700ms steps(1, end) both;
  }
  @keyframes glitch-slice {
    0% {
      opacity: 1;
      transform: translateX(var(--dx));
    }
    17% {
      opacity: 1;
      transform: translateX(calc(var(--dx) * -0.75));
    }
    34% {
      opacity: 0;
      transform: none;
    }
    64% {
      opacity: 1;
      transform: translateX(calc(var(--dx) * -1));
    }
    82% {
      opacity: 1;
      transform: translateX(calc(var(--dx) * 0.7));
    }
    100% {
      opacity: 0;
      transform: none;
    }
  }
  /* The card the glitch raises: the toasts' family (the light field, navy ink, a navy outline,
     Pixel Operator), in the scoreboard's corner where they open, sliding in the same way. */
  .glitchcard {
    position: absolute;
    right: 0;
    bottom: 100%;
    margin-bottom: var(--s-1);
    display: flex;
    align-items: center;
    gap: var(--s-2);
    width: max-content;
    max-width: calc(100vw - 2 * var(--margin));
    padding: 0.5rem 0.5rem 0.5rem 0.75rem;
    background: var(--field-light);
    color: var(--field-light-ink);
    outline: 2px solid var(--pr-navy);
    font-family: var(--font-display);
    line-height: 1.1;
    opacity: 0;
    transform: translateX(calc(100% + var(--margin)));
    transition:
      transform var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }
  .glitchcard[hidden] {
    display: none;
  }
  .glitchcard.is-in {
    opacity: 1;
    transform: none;
  }
  .glitchcard__text {
    margin: 0;
    max-width: 16rem;
    font-size: 1.125rem;
    outline: 0;
  }
  .glitchcard__actions {
    display: flex;
    gap: 0.5rem;
  }
  .glitchcard__actions[hidden] {
    display: none;
  }
  .glitchcard__btn {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    background: var(--pr-navy);
    color: var(--ink);
    font-size: 1.25rem;
  }
  .glitchcard__btn--yes {
    color: var(--accent);
  }
  .glitchcard__btn:hover {
    background: var(--pr-blue);
  }
  .glitchcard__btn:focus-visible {
    outline: 3px solid var(--pr-navy);
    outline-offset: 2px;
  }
  /* Phones and tablets: above the bottom bar and the ship riding on it, inset from the edge. */
  @media (max-width: 63.99rem) {
    .glitchcard {
      right: var(--s-2);
      margin-bottom: calc(3px + var(--ship-w) + var(--s-1));
    }
  }
  /* The markers the hero's exit watches, from near the top of Level 2 to the end of the page
     (placed by the script; invisible, click-through). */
  :global(.wall__trip) {
    position: absolute;
    left: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  /* The post, right under the name. */
  .hero__post {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: var(--accent-2);
    max-width: none;
  }
  .hero__value {
    max-width: 52ch;
    font-size: var(--step-body);
  }
  /* The figure floats in the space the text leaves free, centred on the text block (the head is
     centred in the level, so the level's middle is the block's middle). `translate` keeps clear
     of the load animation's transform. */
  .hero__figure {
    position: absolute;
    right: var(--gutter);
    /* the middle of the content box (the level's top and bottom padding differ) */
    top: calc(var(--hero-pt) + (100% - var(--hero-pt) - var(--hero-pb)) / 2);
    translate: 0 -50%;
    /* (no taller than the hero, on a short screen) */
    width: min(36vw, 34rem, calc((100svh - 4.5rem - var(--peek)) * 0.95 / 1.0335));
    line-height: 0;
    z-index: 0;
  }
  /* The cutout fades at both ends: a short fade at the top so the headset softens into the navy
     without going, and the bottom quarter into the navy. The mask sits on the picture, not the
     figure, so the glow behind it is not cut at the figure's edges. */
  .hero__figure :global(picture) {
    display: block;
    /* The cutout is whole at the top and the sides (the headset and both shoulders sit inside the
       picture), so only the foot needs a fade, where the image edge cuts the arms: two masks meet
       (intersect), the vertical fade eased over the last 30% like fog, and an ellipse that takes
       the lower sides and the bottom corners, so the photo ends in a soft rounded shape. */
    -webkit-mask-image:
      linear-gradient(to bottom, #000 0%, #000 68%, rgba(0, 0, 0, 0.9) 75%, rgba(0, 0, 0, 0.68) 82%, rgba(0, 0, 0, 0.4) 89%, rgba(0, 0, 0, 0.15) 95%, transparent 100%),
      radial-gradient(ellipse 78% 92% at 50% 30%, #000 62%, rgba(0, 0, 0, 0.7) 78%, rgba(0, 0, 0, 0.3) 91%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to bottom, #000 0%, #000 68%, rgba(0, 0, 0, 0.9) 75%, rgba(0, 0, 0, 0.68) 82%, rgba(0, 0, 0, 0.4) 89%, rgba(0, 0, 0, 0.15) 95%, transparent 100%),
      radial-gradient(ellipse 78% 92% at 50% 30%, #000 62%, rgba(0, 0, 0, 0.7) 78%, rgba(0, 0, 0, 0.3) 91%, transparent 100%);
    mask-composite: intersect;
  }
  /* The halo (HeroHalo.astro): pixel bands behind the photo, drawn at a few sizes, as the 8px steps
     cannot scale with the photo. The one shown is the largest that fits the room either side of
     the photo (the clip reaches to the edge of the screen), so it is never cut by a straight edge:
     chosen by the photo's width on tablets and desktops, by its height on a phone, where it takes
     the height the text leaves. */
  :global(.hero__halo) {
    display: none;
  }
  .hero__figure {
    container: halo / inline-size;
  }
  @media (min-width: 48rem) {
    @container halo (min-width: 480px) {
      :global(.hero__halo--500) {
        display: block;
      }
    }
    @container halo (min-width: 330px) and (max-width: 479.98px) {
      :global(.hero__halo--380) {
        display: block;
      }
    }
    @container halo (max-width: 329.98px) {
      :global(.hero__halo--264) {
        display: block;
      }
    }
  }
  @media (max-width: 47.99rem) {
    .hero__figure {
      container: halo / size;
    }
    @container halo (min-height: 290px) {
      :global(.hero__halo--264) {
        display: block;
      }
    }
    @container halo (min-height: 207px) and (max-height: 289.98px) {
      :global(.hero__halo--200) {
        display: block;
      }
    }
    @container halo (min-height: 155px) and (max-height: 206.98px) {
      :global(.hero__halo--160) {
        display: block;
      }
    }
    @container halo (min-height: 120px) and (max-height: 154.98px) {
      :global(.hero__halo--110) {
        display: block;
      }
    }
    @container halo (max-height: 119.98px) {
      :global(.hero__halo--80) {
        display: block;
      }
    }
  }
  .hero__figure :global(img) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }
  .hero__photo {
    position: relative;
  }
  /* A short desktop screen (1280 by 720): the hero's gaps close up a little. */
  @media (min-width: 64rem) and (max-height: 50rem) {
    .hero__head {
      gap: var(--s-2);
    }
    .hero {
      --hero-pt: var(--s-3);
      --hero-pb: var(--s-2);
    }
    .hero,
    .wall {
      --edge: var(--s-2);
      --cell-h: 6rem;
    }
    .wall .ticker {
      --k: 0.85; /* (the tallest logo at 6rem) */
    }
    .hero__title {
      font-size: round(min(var(--step-hero), calc((100svh - 4.5rem - var(--peek)) * 0.2)), 16px);
    }
  }

  @media (max-width: 63.99rem) {
    .hero__head {
      max-width: 62%;
    }
    .hero__figure {
      width: min(34vw, 20rem);
    }
  }
  @media (max-width: 47.99rem) {
    .hero {
      min-height: 0;
      justify-content: flex-start;
      padding-top: var(--s-2);
      padding-bottom: 0;
    }
    :global(.games) .hero {
      min-height: 0;
    }
    .hero__head {
      max-width: none;
      gap: var(--s-2);
    }
    .hero__title {
      font-size: round(17vw, 8px);
    }
    .hero__post {
      font-size: 1.25rem;
    }
    .hero__value {
      font-size: 1rem;
    }
    /* On a phone the photo comes under the text, on the bottom edge, as tall as the room the text
       leaves above the peek of the next level (and no wider than before). */
    .hero {
      height: max(calc(100svh - var(--hud-h) - 4.5rem - var(--peek)), 30rem);
    }
    .hero__figure {
      position: relative;
      right: auto;
      top: auto;
      translate: none;
      flex: 1 1 0;
      min-height: 0;
      max-height: calc(min(70vw, 20rem) * 1.0335);
      width: auto;
      display: flex;
      justify-content: flex-end;
      margin: var(--s-2) 0 0;
    }
    .hero__photo {
      height: 100%;
    }
    .hero__figure :global(picture) {
      height: 100%;
    }
    .hero__figure :global(img) {
      width: auto;
      height: 100%;
    }
  }

  /* The boot. Everything is in the HTML and visible on the very first paint: the name, the post,
     the intro and the photo never start hidden or wait for a font or an animation. The arrival only
     settles them into place with a small rise (transform only), over by about 0.8s. */
  :global(.js:not(.motion-off)) .hero__line {
    animation: boot-line var(--dur-reveal) var(--ease-expo) both;
    animation-delay: calc(var(--i) * 80ms);
  }
  :global(.js:not(.motion-off)) .hero [data-load] {
    animation: load-rise 500ms var(--ease-out) both;
    animation-delay: calc(var(--d, 0ms) / 4);
  }
  @keyframes boot-line {
    from {
      transform: translateY(0.12em);
    }
    to {
      transform: none;
    }
  }
  @keyframes load-rise {
    from {
      transform: translateY(8px);
    }
    to {
      transform: none;
    }
  }

  /* Level 2: the ticker. The logos are plain images (named by their alt text, not links) floating
     on the blue field, no boxes, rolling slowly to the left in a loop: the sequence twice, the
     copy hidden from assistive tech, the track sliding half its width then starting over. It
     pauses under the pointer and with the button. Under reduced motion it is a still row that
     scrolls by hand. */
  .wall {
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .wall.has-join-top {
    padding-top: calc(var(--join-h) + var(--edge));
  }
  .wall.has-join-bottom {
    padding-bottom: calc(var(--edge) + var(--join-h));
  }
  /* the label, at the foot of its zone, just above the logos */
  .wall__head {
    height: var(--zone);
    justify-content: flex-end;
    align-items: center;
    gap: 0;
  }
  .wall__head .flag {
    margin: 0;
  }
  /* the row of logos, the whole width of the column */
  .wall .ticker {
    align-self: stretch;
    margin-top: var(--gap);
  }
  /* A desktop: the scoreboard's pill stands bottom right, beside the column on a wide screen and
     over its end on a narrower one. The row stops short of the pill's column at both ends (so it
     stays centred), and the pill never covers a logo, wherever the page is scrolled. */
  @media (min-width: 64rem) {
    .wall .ticker {
      margin-inline: max(0px, calc(13rem - max(clamp(1.25rem, 5vw, 6rem), calc((100vw - 77.5rem) / 2))));
    }
  }
  /* Pause and the link, side by side under the row */
  .wall__actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    height: var(--zone);
    margin-top: var(--gap);
  }
  .ticker {
    --k: 1; /* the scale of every logo: smaller on tablets and phones */
  }
  /* The row fades out at both ends, so the logos glide in and out. */
  .ticker__view {
    container-type: inline-size;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .ticker__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: ticker calc(var(--n, 20) * 7s) linear infinite;
  }
  .wall.is-paused .ticker__track {
    animation-play-state: paused;
  }
  @media (hover: hover) {
    .ticker__view:hover .ticker__track {
      animation-play-state: paused;
    }
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
  .ticker__seq {
    display: flex;
    flex: none;
  }
  .wall__item {
    flex: none;
  }
  .wall__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--cell-h);
    padding: 0 calc(var(--s-4) * var(--k));
    color: var(--ink);
  }
  .wall__mark :global(.wall__logo) {
    width: calc(var(--lw) * var(--k));
    height: calc(var(--lh) * var(--k));
    object-fit: contain;
  }
  /* The pause button: small and light, a thin outline in the field's ink. */
  .ticker__pause {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    min-height: 2rem;
    padding: 0.3rem 0.625rem;
    border: 1px solid color-mix(in srgb, var(--ink) 55%, transparent);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }
  .ticker__pause:hover {
    border-color: var(--ink);
  }
  .ticker__glyph {
    width: 0.75rem;
    height: 0.75rem;
  }
  .ticker__glyph--play,
  .wall.is-paused .ticker__glyph--pause {
    display: none;
  }
  .wall.is-paused .ticker__glyph--play {
    display: block;
  }
  :global(html:not(.js)) .ticker__pause {
    display: none;
  }
  /* Still with motion off (the device's setting until the visitor chooses, or the switch): one
     centred row of as many whole logos as fit the width. The list wraps and the view shows its
     first line only, so no logo is ever cut and nothing scrolls; no fade at the ends, no copy, no
     Pause. (Without script, the device's setting decides: the media query below.) */
  @media (prefers-reduced-motion: reduce) {
    :global(html:not(.js)) .ticker__track {
      animation: none;
      width: auto;
    }
    :global(html:not(.js)) .ticker__copy {
      display: none;
    }
    :global(html:not(.js)) .ticker__view {
      height: var(--cell-h);
      -webkit-mask-image: none;
      mask-image: none;
    }
    :global(html:not(.js)) .ticker__seq {
      flex: auto;
      flex-wrap: wrap;
      justify-content: center;
    }
    :global(html:not(.js)) .hero {
      position: relative;
      top: auto;
    }
  }
  :global(.motion-off) .ticker__track {
    animation: none;
    width: auto;
  }
  :global(.motion-off) .ticker__copy,
  :global(.motion-off) .ticker__pause {
    display: none;
  }
  :global(.motion-off) .ticker__view {
    height: var(--cell-h);
    -webkit-mask-image: none;
    mask-image: none;
  }
  :global(.motion-off) .ticker__seq {
    flex: auto;
    flex-wrap: wrap;
    justify-content: center;
  }
  /* with motion off the hero is not pinned: it simply scrolls away */
  :global(.motion-off) .hero {
    position: relative;
    top: auto;
  }
  .wall__more {
    max-width: none;
  }
  /* A title with no clean official logo: its name set in Pixel Operator at the logos' height. */
  .wall__word {
    font-family: var(--font-display);
    font-size: calc(3.5rem * var(--k));
    line-height: 1;
  }
  /* Or its pixel icon and its name. */
  .wall__name {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    text-align: center;
    text-wrap: balance;
  }
  .wall__name :global(.gameicon) {
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
  }
  .wall__name :global(.gameicon rect:not(.px-navy)) {
    fill: var(--ink);
  }
  @media (max-width: 63.99rem) {
    .ticker {
      --k: 0.72;
    }
    .hero,
    .wall {
      --cell-h: 5.25rem; /* (the logos at 0.72) */
    }
    .wall__name {
      font-size: 1.25rem;
    }
    .wall__word {
      font-size: 2.25rem;
    }
  }
  @media (max-width: 47.99rem) {
    .ticker {
      --k: 0.5;
    }
    .hero,
    .wall {
      --cell-h: 3.75rem; /* (the logos at half size) */
      --gap: 0.75rem;
      --edge: var(--s-2);
      /* (a phone's first screen shows the clouds and the label peeking in; the photo keeps its size) */
      --peek: calc(var(--join-h) + var(--edge) + var(--zone) + 0.5rem);
    }
    .wall__name {
      font-size: 1rem;
      gap: 0.5rem;
    }
    .wall__word {
      font-size: 1.75rem;
    }
    .wall__name :global(.gameicon) {
      width: 1.75rem;
      height: 1.75rem;
    }
  }

  /* Level 3: the statement on the left, the drum on the right. The drum shows five rows, the
     active one in the centre: its number in green, its label white; the rows either side white at
     half strength and shifted right; the outer rows at a quarter and shifted twice as far, the
     stepped offsets giving the curve of a drum. The same type size on every row: the emphasis is
     only colour, opacity and offset, and all three move smoothly as the drum turns. */
  /* The terrain at the foot of the ticker is the breathing room above the stats: less padding here. */
  .stats {
    padding-top: var(--s-5);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--s-6);
    align-items: center;
  }
  .stats__grid .level__body {
    margin-top: 0;
  }
  /* The numbers are the biggest thing in the level; the statement beside them is smaller. */
  .stats__title {
    font-size: clamp(2rem, 1rem + 2.2vw, 3rem);
  }
  /* One size rules the drum: the number, 96px from 1440 up and 36px at 375; the row is the number
     and 2.5rem, room for the label and a caption on two lines, and the offsets a third and two
     thirds of it (32px and 64px on a desktop). */
  .drum {
    --num: clamp(2.25rem, 1rem + 5.6vw, 6rem);
    --row: calc(var(--num) + 2.5rem);
    --shift: calc(var(--num) / 3);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--s-4);
    align-items: center;
  }
  .drum__view {
    min-width: 0;
  }
  .drum__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .drum__row {
    display: flex;
    align-items: baseline;
    gap: 0.25em;
    min-height: var(--row);
    /* room for the furthest offset, so a shifted row still fits inside the view */
    padding-right: calc(var(--shift) * 2);
    color: #ffffff;
  }
  .drum__num {
    flex: none;
    font-family: var(--font-display);
    font-size: var(--num);
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .drum__text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }
  .drum__label {
    font-family: var(--font-text);
    font-size: clamp(1rem, 0.5rem + 1.1vw, 1.5rem);
    line-height: 1.2;
  }
  /* The caption: a short line of personality under the stat, Montserrat italic in cyan, 17px on a
     desktop and 15px on a phone. On the turning drum only the active row's shows, fading in as
     the row arrives; the still list shows every caption under its stat. */
  .drum__cap {
    font-family: var(--font-text);
    font-style: italic;
    font-size: clamp(0.9375rem, 0.875rem + 0.2vw, 1.0625rem);
    line-height: 1.3;
    color: var(--accent-2);
    max-width: 40ch;
  }
  .drum__controls {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
  }
  .drum__button {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--pr-light) 45%, transparent);
    background: transparent;
    color: var(--ink);
    transition:
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }
  .drum__button svg {
    width: 1rem;
    height: 1rem;
  }
  .drum__button:hover {
    border-color: var(--ink);
    color: var(--accent);
  }
  .drum__button--pause {
    margin-top: 0.5rem;
  }
  .drum__glyph--play,
  .drum.is-paused .drum__glyph--pause {
    display: none;
  }
  .drum.is-paused .drum__glyph--play {
    display: block;
  }
  /* Still, without script or under reduced motion: the four stats as a list, the copies gone. */
  .drum:not(.is-live) .drum__clone {
    display: none;
  }
  .drum:not(.is-live) .drum__row {
    min-height: 0;
    padding: var(--s-2) 0;
  }
  .drum:not(.is-live) .drum__row:not(:last-child) {
    border-bottom: 1px solid var(--rule);
  }
  .drum:not(.is-live) .drum__num {
    color: var(--accent);
  }
  /* Turning: the view is five rows tall, the list slides so row --i sits in the middle. */
  .drum.is-live .drum__view {
    height: calc(var(--row) * 5);
    overflow: hidden;
  }
  .drum.is-live .drum__list {
    transform: translateY(calc(var(--row) * (2 - var(--i, 4))));
    transition: transform 600ms var(--ease-out);
    will-change: transform;
  }
  .drum.is-live .drum__row {
    opacity: 0.25;
    transform: translateX(calc(var(--shift) * 2));
    visibility: visible;
    transition:
      opacity 600ms var(--ease-out),
      transform 600ms var(--ease-out),
      color 600ms ease,
      visibility 0s linear 0s;
  }
  /* rows beyond the five on show are clipped by the view and hidden outright, so nothing reads
     them; a row on its way out stays visible until the slide has carried it off */
  .drum.is-live .drum__row:not([data-d='0']):not([data-d='1']):not([data-d='2']) {
    visibility: hidden;
    transition:
      opacity 600ms var(--ease-out),
      transform 600ms var(--ease-out),
      color 600ms ease,
      visibility 0s linear 600ms;
  }
  .drum.is-live .drum__row[data-d='1'] {
    opacity: 0.5;
    transform: translateX(var(--shift));
  }
  .drum.is-live .drum__row[data-d='0'] {
    opacity: 1;
    transform: none;
  }
  .drum.is-live .drum__num {
    transition: color 600ms ease;
  }
  .drum.is-live .drum__row[data-d='0'] .drum__num {
    color: var(--accent);
  }
  .drum.is-live .drum__cap {
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .drum.is-live .drum__row[data-d='0'] .drum__cap {
    opacity: 1;
    transition-delay: 200ms;
  }
  .drum.is-live .drum__controls {
    display: flex;
  }
  @media (max-width: 63.99rem) {
    .stats__grid {
      grid-template-columns: 1fr;
      row-gap: var(--s-4);
    }
  }
  @media (max-width: 47.99rem) {
    .drum {
      column-gap: var(--s-2);
    }
    .drum__button {
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  /* Level 4: the scoreboard */
  .proof__link {
    color: var(--pr-navy);
  }
  .proof__status {
    font-family: var(--font-display);
    font-size: 1.25rem;
    max-width: none;
  }
  .proof__score {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    max-width: none;
  }
  .proof__score[hidden] {
    display: none;
  }
  .proof__scoremark {
    font-size: 3rem;
    line-height: 0;
  }
  .proof__score.is-fail .proof__scoremark {
    display: none;
  }
  .proof__score.is-in {
    animation: boot-pop 360ms var(--ease-out) both;
  }
  @keyframes boot-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .proof__board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--s-4);
  }
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-3) 0 var(--s-4);
    min-width: 0;
    overflow: hidden;
    border-top: 1px solid var(--rule);
  }
  .panel__mark {
    font-size: 2.5rem;
    line-height: 0;
    transition: color var(--dur-base) ease;
  }
  .panel__mark :global(.proof__cross),
  .panel__mark .proof__idle {
    display: none;
  }
  .proof__idle {
    width: 1em;
    height: 1em;
  }
  /* A build with no run to read (a local one) ticks nothing: an empty box and the count of checks;
     while the live checks run, the same box */
  .panel.is-idle .panel__mark .proof__idle {
    display: block;
  }
  .panel.is-idle .panel__mark :global(.proof__pass),
  .panel.is-pending .panel__mark :global(.proof__pass) {
    display: none;
  }
  .panel.is-pending .panel__mark .proof__idle {
    display: block;
  }
  .panel.is-failed :global(.proof__pass) {
    display: none;
  }
  .panel.is-failed :global(.proof__cross) {
    display: block;
  }
  .panel.is-pass .panel__mark {
    animation: mark-pop 320ms var(--ease-out);
  }
  @keyframes mark-pop {
    from {
      transform: scale(0.6);
    }
    to {
      transform: none;
    }
  }
  .panel__num {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 0.9;
    max-width: none;
  }
  .panel__of {
    font-size: 1.25rem;
  }
  .panel__title {
    font-size: 1.75rem;
  }
  .panel__detail {
    font-size: 1rem;
    max-width: none;
  }
  @media (max-width: 63.99rem) {
    .proof__board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-3);
    }
    .panel__num {
      font-size: 3rem;
    }
    .panel__title {
      font-size: 1.5rem;
    }
  }
  @media (max-width: 47.99rem) {
    .proof__board {
      grid-template-columns: 1fr;
    }
    .panel {
      padding: var(--s-2) 0 var(--s-3);
      gap: 0.25rem;
    }
    .panel__num {
      font-size: 2.25rem;
    }
    .panel__title {
      font-size: 1.25rem;
    }
    .panel__detail {
      font-size: 0.8125rem;
    }
  }

  /* Level 5: after hours, then the last button */
  .final__text {
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: 52ch;
  }
  .final__actions {
    margin-top: var(--s-3);
  }
  .final__actions .button {
    font-size: 1.5rem;
    min-height: 3.5rem;
    padding-inline: 2rem;
  }
  .final__mail {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--pr-navy);
  }
  .final__mail:hover {
    color: var(--pr-blue);
  }
</style>

<script>
  import { startHeroExit } from '../scripts/glitch';
  import { checks as engine } from '../scripts/checks';
  import { reducedMotion, whenMotion } from '../scripts/motion';
  const reduce = reducedMotion();
  startHeroExit();
  // (the curtain, the ticker's button and the drum start with motion: at once, or when the visitor
  // turns the Motion switch on)

  // The curtain: the hero is pinned while the next level slides over it. A hero taller than the
  // screen (a phone) pins with its bottom edge on the bottom of the screen instead of its top.
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) whenMotion(() => {
    const pin = () => {
      // The room the bottom bar takes; the desktop track stands in the gutter and takes none (the
      // body's bottom padding there is only a strip at the end of the page for the scoreboard).
      const bar = matchMedia('(min-width: 64rem)').matches ? 0 : parseFloat(getComputedStyle(document.body).paddingBottom) || 0;
      hero.style.setProperty('--hero-top', `${Math.min(0, innerHeight - bar - hero.offsetHeight)}px`);
    };
    pin();
    addEventListener('resize', pin);
    addEventListener('load', pin);
    document.fonts?.ready.then(pin);
  });

  // The ticker: the button pauses and plays it. Still with motion off, so nothing to do until then.
  const tick = document.querySelector<HTMLElement>('[data-ticker]');
  if (tick) whenMotion(() => {
    const pause = tick.querySelector<HTMLButtonElement>('[data-ticker-pause]')!;
    const word = pause.querySelector<HTMLElement>('[data-ticker-word]')!;
    pause.addEventListener('click', () => {
      const paused = tick.classList.toggle('is-paused');
      word.textContent = paused ? 'Play' : 'Pause';
      pause.setAttribute('aria-label', paused ? 'Play the logos' : 'Pause the logos');
    });
  });

  // The drum: the four stats three times over; row --i (a float index into the list) sits in the
  // centre. It turns one row every 3.5 s with a 0.6 s slide, and keeps turning after the arrows.
  // At the end of the middle copy it slides onto the next copy, then jumps back a copy with no
  // transition, which looks the same. It rests under a mouse, while holding keyboard focus, when
  // paused, for a few seconds after a tap, and while the level is off screen. Still under reduced
  // motion.
  const drum = document.querySelector<HTMLElement>('[data-drum]');
  if (drum) whenMotion(() => {
    const list = drum.querySelector<HTMLElement>('.drum__list')!;
    const rows = Array.from(list.children) as HTMLElement[];
    const live = drum.querySelector<HTMLElement>('[data-drum-live]')!;
    const pause = drum.querySelector<HTMLButtonElement>('[data-drum-pause]')!;
    const n = Number(drum.dataset.count) || rows.length / 3;
    let i = n;
    let timer = 0;
    let hovered = false;
    let focused = false;
    let seen = false;
    let paused = false;
    let moving = false;
    const paint = (animate: boolean) => {
      if (!animate) {
        list.style.transition = 'none';
        rows.forEach((r) => (r.style.transition = 'none'));
      }
      list.style.setProperty('--i', String(i));
      rows.forEach((r, k) => (r.dataset.d = String(Math.abs(k - i))));
      if (!animate) {
        void list.offsetHeight;
        requestAnimationFrame(() => {
          list.style.transition = '';
          rows.forEach((r) => (r.style.transition = ''));
        });
      }
    };
    const announce = () => {
      const row = rows[i];
      live.textContent = `${row.querySelector('.drum__num')?.textContent?.trim()} ${row.querySelector('.drum__label')?.textContent?.trim()}. ${row.querySelector('.drum__cap')?.textContent?.trim() ?? ''}`;
    };
    const go = (dir: 1 | -1) => {
      if (moving) return;
      moving = true;
      i += dir;
      paint(true);
      announce();
      window.setTimeout(() => {
        if (i >= 2 * n || i < n) {
          i = i >= 2 * n ? i - n : i + n;
          paint(false);
        }
        moving = false;
      }, 620);
    };
    // A tap rests it a moment, then it carries on.
    let touchedUntil = 0;
    // (motion off from the switch: a still drum)
    const resting = () => hovered || focused || paused || !seen || performance.now() < touchedUntil || reducedMotion();
    const tick = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (!resting()) go(1);
        tick();
      }, 3500);
    };
    drum.querySelector('[data-drum-next]')!.addEventListener('click', () => {
      go(1);
      tick();
    });
    drum.querySelector('[data-drum-prev]')!.addEventListener('click', () => {
      go(-1);
      tick();
    });
    pause.addEventListener('click', () => {
      paused = !paused;
      drum.classList.toggle('is-paused', paused);
      pause.setAttribute('aria-label', paused ? 'Play the stats' : 'Pause the stats');
      pause.setAttribute('aria-pressed', String(paused));
    });
    pause.setAttribute('aria-pressed', 'false');
    // Hover is a mouse's: a finger on a phone fires the same pointer events and would hold the
    // drum still for good. Focus counts when it is the keyboard's (a tapped button keeps focus too).
    drum.addEventListener('pointerenter', (e) => (hovered = e.pointerType === 'mouse'));
    drum.addEventListener('pointerleave', () => (hovered = false));
    drum.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') touchedUntil = performance.now() + 4000;
    });
    drum.addEventListener('focusin', (e) => (focused = (e.target as HTMLElement).matches(':focus-visible')));
    drum.addEventListener('focusout', (e) => {
      if (!drum.contains(e.relatedTarget as Node | null)) focused = false;
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => entries.forEach((e) => (seen = e.isIntersecting)), { threshold: 0.3 }).observe(drum);
    } else {
      seen = true;
    }
    drum.classList.add('is-live');
    paint(false);
    tick();
  });

  // The live thing: real checks on this page, run in the visitor's browser, from the shared engine
  // the Quality page uses too.
  const button = document.getElementById('selftest') as HTMLButtonElement | null;
  const status = document.getElementById('selftest-status');
  const tiles = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-check]').forEach((t) => tiles.set(t.dataset.check!, t));
  const checks = ['pages', 'console', 'links', 'viewports', 'a11y', 'brand', 'weight', 'html'].map((id) => engine[id]);

  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const score = document.getElementById('selftest-score');

  button?.addEventListener('click', async () => {
    button.disabled = true;
    if (status) status.textContent = `Running ${checks.length} checks`;
    if (score) {
      score.hidden = true;
      score.classList.remove('is-in', 'is-fail');
    }
    for (const t of tiles.values()) {
      t.classList.remove('is-idle', 'is-pass', 'is-failed');
      t.classList.add('is-pending');
      t.dataset.from = 'live';
    }
    let passedAll = 0;
    let failedAll = 0;
    let tilesPassed = 0;
    for (const check of checks) {
      const tile = tiles.get(check.id);
      const { passed, failed, detail, value, of: ofText } = await check.run();
      if (!reduce) await wait(260);
      passedAll += passed;
      failedAll += failed;
      if (failed === 0) tilesPassed++;
      if (tile) {
        tile.classList.remove('is-pending', 'is-pass');
        tile.classList.toggle('is-failed', failed > 0);
        if (failed === 0) tile.classList.add('is-pass');
        const count = tile.querySelector('[data-count]');
        const of = tile.querySelector('.panel__of');
        const det = tile.querySelector('[data-detail]');
        if (count) count.textContent = value ?? String(passed);
        if (of) of.textContent = ofText ?? ` of ${passed + failed}`;
        if (det) det.textContent = detail;
      }
    }
    if (status) status.textContent = failedAll ? `${passedAll} passed, ${failedAll} failed on your device` : `${passedAll} of ${passedAll} passed on your device`;
    if (score) {
      const value = score.querySelector('[data-score]');
      const word = score.querySelector('[data-score-word]');
      if (value) value.textContent = `${tilesPassed}/${checks.length}`;
      if (word) word.textContent = failedAll ? 'Fail' : 'Pass';
      score.classList.toggle('is-fail', failedAll > 0);
      score.hidden = false;
      score.classList.add('is-in');
    }
    button.disabled = false;
    button.textContent = 'Run again';
    document.dispatchEvent(new CustomEvent('playrun:achieve', { detail: 'selftest' }));
  });
</script>

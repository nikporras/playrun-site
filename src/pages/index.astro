---
import { getCollection } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PassMark from '../components/PassMark.astro';
import CrossMark from '../components/CrossMark.astro';
import Bug from '../components/Bug.astro';
import GameIcon from '../components/GameIcon.astro';
import { suite } from '../data/suite';
import { logos } from '../data/logos';
import { contact, employers, playrun, primaryAction, since, site } from '../config';

import portrait from '../assets/photos/nicolas.png';

// Every public title on the ticker, apart from one whose logo would repeat another's (`wall`).
// The biggest names lead the sequence, Cyberpunk 2077 in the middle of them, so they are on screen
// at the start; the rest follow in the order of the portfolio, by post, newest first.
const all = await getCollection('projects');
const shown = import.meta.env.DEV ? all : all.filter((p) => p.data.public);
const order = employers.map((e) => e.id);
const byPost = shown
  .filter((p) => p.data.wall)
  .sort((a, b) => {
    const g = order.indexOf(a.data.employer) - order.indexOf(b.data.employer);
    const aDev = a.data.status === 'in-development' ? 1 : 0;
    const bDev = b.data.status === 'in-development' ? 1 : 0;
    return g || aDev - bDev || (b.data.year ?? 0) - (a.data.year ?? 0);
  });
const FEATURED = ['beat-saber', 'nba-2k21', 'cyberpunk-2077', 'ghostbusters-rise-of-the-ghost-lord', 'lous-lagoon'];
const wall = [...FEATURED.flatMap((id) => byPost.filter((p) => p.id === id)), ...byPost.filter((p) => !FEATURED.includes(p.id))];

// The numbers, counted from the data so they stay right as it grows.
const stats = [
  { n: new Date().getFullYear() - since, suffix: '+', label: 'years in QA' },
  { n: new Set(employers.map((e) => e.name)).size, suffix: '', label: 'companies' },
  { n: shown.length, suffix: '', label: 'games' },
  { n: 10, suffix: '+', label: 'platforms' },
];

const ALT = 'Nicolás Porras wearing a VR headset pushed up on his head';

// The run that built this page. GitHub Actions builds only after the suite has passed, so the
// numbers on the board are that run's. Local builds carry no run.
const runDate = suite.run ? suite.run.startedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : null;
// The six live checks the button runs on this page, in the visitor's browser. Their counts are
// filled in when they run; the line above the board carries the suite's own numbers.
const checks = [
  { id: 'pages', title: 'Pages load', detail: 'Every route answers 200 and renders one h1. No blank screens.' },
  { id: 'console', title: 'Zero console errors', detail: 'Nothing red in the console, no request left failing.' },
  { id: 'links', title: 'Internal links resolve', detail: 'Every internal link answers 200. No 404s hiding in the footer.' },
  { id: 'viewports', title: 'Three widths', detail: 'No sideways scroll at 375, 768 and 1440 pixels. Phones count.' },
  { id: 'a11y', title: 'Accessibility scan', detail: 'axe-core finds no violations. Keyboard and screen readers get the whole page.' },
  { id: 'brand', title: 'Brand assets', detail: 'Both typefaces load, the logo renders, favicon and Open Graph image present.' },
];
---

<Base title="Home" fullTitle={`${site.name}, the game QA portfolio of Nicolás Porras, London`}>
  <!-- Level 1: the start screen. It stays pinned while the next level slides up over it. -->
  <section class="level level--navy hero" data-level="1" aria-labelledby="hero-title">
    <div class="level__head hero__head">
      <p class="flag" data-load style="--d: 0ms"><span>Level 1 &middot; Start</span></p>
      <div class="hero__name">
        <h1 id="hero-title" class="hero__title">
          <span class="hero__mask"><span class="hero__line" style="--i: 0">Nicolás</span></span>
          <span class="hero__mask"><span class="hero__line" style="--i: 1">Porras</span></span>
        </h1>
        <!-- The visual copy of the name for the break, and the ticket it raises -->
        <canvas class="hero__break" aria-hidden="true" hidden></canvas>
        <aside class="hero__ticket" aria-hidden="true" hidden>
          <p class="ticket__key">BUG-001</p>
          <p class="ticket__title">Headline broke</p>
          <dl class="ticket__meta">
            <dt>Severity</dt>
            <dd>Cosmetic</dd>
            <dt>Status</dt>
            <dd class="ticket__status" data-ticket-status>Open</dd>
          </dl>
        </aside>
      </div>
      <p class="hero__post" data-load style="--d: 400ms">{playrun.role}, {site.name}</p>
      <p class="hero__role" data-load style="--d: 440ms">Game QA, platform compliance &amp; release testing</p>
      <p class="hero__value" data-load style="--d: 500ms">
        I've been testing games since 2021 and leading QA teams since 2022, at nDreams and Historic VR, and on indie
        titles through to their multi-platform console and PC releases. I plan the testing, run it on real hardware,
        and write reports developers can act on.
      </p>
      <div class="level__actions hero__actions" data-load style="--d: 560ms">
        <a class="button" href={primaryAction.href}>{primaryAction.label}</a>
        <a class="textlink hero__secondary" href="/quality">See how I test this site</a>
      </div>
    </div>
    <!-- The player character: the one photo on the site, standing on the bottom edge of the level -->
    <div class="hero__figure" data-load style="--d: 200ms">
      <Picture
        src={portrait}
        alt={ALT}
        widths={[400, 640, 960, 1280]}
        sizes="(max-width: 63.99rem) 70vw, 36vw"
        formats={['avif']}
        fallbackFormat="webp"
        loading="eager"
        decoding="async"
      />
    </div>
    <Bug id="hero-1" style="right: 42%; top: 8rem" tablet="right: 6%; top: 8rem" walk="x -2rem" />
  </section>

  <!-- Level 2: the ticker of titles, their official logos in one colour, rolling slowly left -->
  <section class="level level--blue wall" data-level="2" aria-labelledby="wall-title">
    <div class="level__head">
      <p class="flag" data-enter><span>Level 2 &middot; Portfolio</span></p>
      <h2 id="wall-title" class="level__title" data-enter="wipe">Games I've tested</h2>
    </div>
    <div class="ticker level__body" data-ticker data-enter style="--enter-delay: 120ms">
      <div class="ticker__view">
        <div class="ticker__track" style={`--n: ${wall.length}`}>
          {
            [false, true].map((copy) => (
              <ul role="list" class:list={['ticker__seq', copy && 'ticker__copy']} aria-hidden={copy ? 'true' : undefined}>
                {wall.map((p) => (
                  <li class="wall__item">
                    <a class="wall__link" href="/portfolio" aria-label={p.data.title} tabindex={copy ? -1 : undefined}>
                      {logos[p.id] ? (
                        <Image class="wall__logo" src={logos[p.id]} alt="" height={64} densities={[1, 2]} loading="lazy" decoding="async" />
                      ) : p.data.wordmark ? (
                        <span class="wall__word" aria-hidden="true">
                          {p.data.title}
                        </span>
                      ) : (
                        <span class="wall__name" aria-hidden="true">
                          <GameIcon name={p.data.icon} />
                          <span>{p.data.title}</span>
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>
      <button type="button" class="ticker__pause" data-ticker-pause aria-label="Pause the logos">
        <svg class="ticker__glyph ticker__glyph--pause" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><path d="M1 0h2v7H1zM4 0h2v7H4z" fill="currentColor" /></svg>
        <svg class="ticker__glyph ticker__glyph--play" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><path d="M1 0h1v7H1zM2 1h1v5H2zM3 1h1v5H3zM4 2h1v3H4zM5 3h1v1H5z" fill="currentColor" /></svg>
        <span data-ticker-word>Pause</span>
      </button>
    </div>
    <Bug id="wall-1" style="right: 12%; top: 9rem" tablet="right: 10%; top: 0.75rem" phone="right: 1rem; bottom: 0.25rem" walk="x -2rem" />
  </section>

  <!-- Level 3: the numbers, counted from the portfolio -->
  <section class="level level--cyan stats" data-level="3" aria-labelledby="stats-title">
    <div class="level__head">
      <p class="flag" data-enter><span>Level 3 &middot; Stats</span></p>
      <h2 id="stats-title" class="level__title" data-enter="wipe">The score so far</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">Counted from the portfolio, so they stay right as it grows.</p>
    </div>
    <ul role="list" class="stats__board level__body">
      {
        stats.map((s, i) => (
          <li class="stat" data-enter="place" style={`--enter-delay: ${i * 70}ms`}>
            <p class="stat__num num">
              <span data-count-to={s.n}>{s.n}</span>{s.suffix}
            </p>
            <p class="stat__label">{s.label}</p>
          </li>
        ))
      }
    </ul>
    <Bug id="stats-1" style="right: 20%; bottom: 1rem" tablet="left: 40%; bottom: 1rem" phone="right: 1rem; top: 0.25rem" walk="x 2rem" />
  </section>

  <!-- Level 4: proof as a scoreboard on a green field -->
  <section class="level level--green proof" data-level="4" aria-labelledby="proof-title">
    <div class="level__head">
      <p class="flag" data-enter><span>Level 4 &middot; Proof</span></p>
      <h2 id="proof-title" class="level__title" data-enter="wipe">Tested like my games</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">
        A Playwright suite runs on every push, and the site deploys only if it passes. Run the same kind of checks on this page now.
      </p>
      <div class="level__actions" data-enter style="--enter-delay: 160ms">
        <button class="button button--navy" type="button" id="selftest" aria-describedby="selftest-status">Test this page</button>
        <a class="textlink proof__link" href="/quality">How I test this site</a>
      </div>
      <p id="selftest-status" class="proof__status" aria-live="polite" data-enter style="--enter-delay: 200ms">
        {suite.run ? `${suite.passed} of ${suite.total} checks passed in the last run${runDate ? `, on ${runDate}` : ''}` : `${suite.total} checks run before every deploy`}
      </p>
      <p class="proof__score" id="selftest-score" hidden>
        <span data-score-mark class="proof__scoremark"><PassMark /></span>
        <span data-score>Not run yet</span>
        <span data-score-word></span>
      </p>
    </div>
    <div class="proof__board level__body">
      {
        checks.map((g, i) => (
          <div class="panel is-idle" style={`--enter-delay: ${i * 60}ms`} data-check={g.id} data-enter="scan">
            <div class="panel__mark" aria-hidden="true">
              <svg class="proof__idle" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><path d="M0 0h7v1H0zM0 6h7v1H0zM0 1h1v5H0zM6 1h1v5H6z" fill="currentColor" /></svg>
              <PassMark class="proof__pass" />
              <CrossMark class="proof__cross" />
            </div>
            <p class="panel__num num">
              <span data-count>&ndash; &ndash;</span>
              <span class="panel__of"></span>
            </p>
            <h3 class="panel__title">{g.title}</h3>
            <p class="panel__detail" data-detail>{g.detail}</p>
          </div>
        ))
      }
    </div>
    <Bug id="proof-1" style="right: 12%; top: 10rem" tablet="right: 20%; top: 0.75rem" phone="left: 1rem; bottom: 0.25rem" walk="x -2rem" />
  </section>

  <!-- Level 5: after hours, and the one last button -->
  <section class="level level--light final" data-level="5" aria-labelledby="final-title">
    <div class="level__head">
      <p class="flag" data-enter><span>Level 5 &middot; Final level</span></p>
      <h2 id="final-title" class="level__title" data-enter="wipe">After hours</h2>
      <p class="final__text" data-enter style="--enter-delay: 80ms">
        I play and pull apart games for the mechanics and the design choices, Helldivers, The Witcher and God of War
        lately. I play instruments and dance, music is a big part of my culture, and I am learning the drums. I watch
        and play most sports.
      </p>
      <div class="level__actions final__actions" data-enter style="--enter-delay: 160ms">
        <a class="button" href={primaryAction.href}>{primaryAction.label}</a>
        <a class="final__mail" href={`mailto:${contact.email}`}>{contact.email}</a>
      </div>
    </div>
    <Bug id="final-1" style="right: 10%; top: 2rem" tablet="right: 8%; bottom: 1rem" phone="right: 1rem; bottom: 0.25rem" walk="x -2rem" />
  </section>
</Base>

<style>
  /* Level 1: the text on the left, the figure on the right, the whole level a screen tall. When
     motion is allowed it is pinned, and Level 2 slides up and covers it like a curtain. */
  .hero {
    min-height: calc(100svh - var(--hud-space, 0px));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: var(--s-4);
    padding-bottom: var(--s-6);
  }
  @media (max-width: 63.99rem) {
    :global(.games) .hero {
      --hud-space: var(--hud-h);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero {
      position: sticky;
      top: var(--hero-top, 0px);
      z-index: 0;
    }
  }
  .hero__head {
    max-width: 58%;
    gap: var(--s-4);
  }
  .hero__head .flag {
    margin-bottom: 0;
  }
  .hero__name {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }
  .hero__title {
    font-size: var(--step-hero);
    font-size: round(var(--step-hero), 16px);
    line-height: 0.9;
    max-width: none;
    text-wrap: initial;
    margin-left: -0.03em;
  }
  .hero__mask {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero__line {
    display: block;
  }
  /* The break: the real heading fades while its pixel copy is up; the copy is one canvas. */
  .hero__title.is-broken {
    opacity: 0;
  }
  .hero__break {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    z-index: 1;
  }
  .hero__break[hidden] {
    display: none;
  }
  /* The ticket: a small tracker card beside the name, transform and opacity only. */
  .hero__ticket {
    position: absolute;
    left: calc(100% + var(--s-4));
    top: 0.25em;
    width: 18rem;
    z-index: 2;
    padding: 0.875rem 1rem;
    background: var(--surface);
    border-left: 4px solid var(--accent-2);
    font-family: var(--font-display);
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateX(-0.5rem) scale(0.9);
    transform-origin: left top;
    visibility: hidden;
    transition:
      transform 320ms var(--ease-out),
      opacity 240ms ease,
      visibility 0s linear 240ms;
  }
  .hero__ticket[hidden] {
    display: none;
  }
  .hero__ticket.is-in {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition-delay: 0s;
  }
  .hero__ticket[data-status='fixed'] {
    border-left-color: var(--accent);
  }
  .ticket__key {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-2);
    max-width: none;
  }
  .ticket__title {
    font-size: 1.25rem;
    margin: 0.2em 0 0.4em;
    max-width: none;
  }
  .ticket__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1em 0.75em;
    margin: 0;
    color: var(--muted);
  }
  .ticket__meta dd {
    margin: 0;
  }
  .ticket__status {
    color: var(--accent-2);
  }
  .hero__ticket[data-status='fixed'] .ticket__status {
    color: var(--accent);
  }
  .hero__ticket[data-status='fixed'] .ticket__status::before {
    content: '✓ ';
  }
  /* The post, then the line on the work: one block, tighter than the rest of the head. */
  .hero__post {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: var(--ink);
    max-width: none;
    margin-bottom: calc(var(--s-1) - var(--s-4));
  }
  .hero__role {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--accent-2);
    max-width: none;
  }
  .hero__value {
    max-width: 52ch;
    font-size: var(--step-body);
  }
  .hero__actions {
    margin-top: var(--s-2);
  }
  .hero__secondary {
    color: var(--ink);
  }
  /* The figure stands on the bottom edge of the level, in the space the text leaves free. */
  .hero__figure {
    position: absolute;
    right: var(--gutter);
    bottom: 0;
    width: min(36vw, 34rem);
    line-height: 0;
    z-index: 0;
  }
  .hero__figure::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 180%;
    height: 95%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse 55% 75% at 50% 100%, rgba(86, 189, 218, 0.4), rgba(81, 108, 179, 0.2) 55%, transparent 75%);
    pointer-events: none;
  }
  .hero__figure :global(img) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 63.99rem) {
    .hero__head {
      max-width: 62%;
    }
    .hero__figure {
      width: min(34vw, 20rem);
    }
  }
  @media (max-width: 47.99rem) {
    .hero {
      min-height: 0;
      justify-content: flex-start;
      padding-top: var(--s-3);
      padding-bottom: 0;
    }
    :global(.games) .hero {
      min-height: 0;
    }
    .hero__head {
      max-width: none;
      gap: var(--s-3);
    }
    .hero__title {
      font-size: round(17vw, 8px);
    }
    .hero__post,
    .hero__role {
      font-size: 1.25rem;
    }
    .hero__post {
      margin-bottom: calc(var(--s-1) - var(--s-3));
    }
    .hero__value {
      font-size: 1rem;
    }
    .hero__actions {
      gap: var(--s-2);
    }
    .hero__actions .button {
      width: 100%;
    }
    /* On a phone the ticket pins to the top of the screen, where the toast goes too. */
    .hero__ticket {
      position: fixed;
      left: 0.5rem;
      right: 0.5rem;
      top: 0.5rem;
      width: auto;
      transform: translateY(-0.5rem) scale(0.96);
      transform-origin: top center;
    }
    /* On a phone the photo comes under the text, still on the bottom edge. */
    .hero__figure {
      position: relative;
      right: auto;
      width: min(70vw, 20rem);
      margin: var(--s-4) 0 0 auto;
    }
  }

  /* The boot: the one loud moment. Everything is in the HTML on the first frame; the sequence only
     adds arrival and is over by 1.2s. The two name lines rise from their masks, the rest follows. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero__line {
      transform: translateY(105%);
      animation: boot-line var(--dur-reveal) var(--ease-expo) forwards;
      animation-delay: calc(260ms + var(--i) * 110ms);
    }
    :global(.js) .hero [data-load] {
      animation: load-rise 500ms var(--ease-out) both;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes boot-line {
    to {
      transform: none;
    }
  }
  @keyframes load-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Level 2: the ticker. A navy board on the blue field, the logos in equal cells divided by
     hairlines of the field, rolling slowly to the left in a loop: the sequence twice, the copy
     hidden from assistive tech, the track sliding half its width then starting over. It pauses
     under the pointer, while a logo has focus, and with the button; a focused logo is brought
     into view by the script. Under reduced motion it is a still row that scrolls by hand. */
  .wall {
    z-index: 1;
  }
  .ticker {
    --cell: 15rem;
    --cell-h: 8rem;
  }
  .ticker__view {
    container-type: inline-size;
    overflow: hidden;
    background: var(--bg);
    border: 2px solid var(--bg);
  }
  .ticker__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: ticker calc(var(--n, 20) * 5s) linear infinite;
  }
  .ticker.is-paused .ticker__track,
  .ticker__view:focus-within .ticker__track {
    animation-play-state: paused;
  }
  @media (hover: hover) {
    .ticker__view:hover .ticker__track {
      animation-play-state: paused;
    }
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
  .ticker__seq {
    display: flex;
    flex: none;
  }
  .wall__item {
    flex: none;
    width: var(--cell);
    background: var(--bg);
    border-left: 2px solid var(--field-blue);
  }
  .ticker__seq:first-child .wall__item:first-child {
    border-left: 0;
  }
  .wall__link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--cell-h);
    padding: var(--s-3);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--dur-fast) ease;
  }
  .wall__link:hover,
  .wall__link:focus-visible {
    background: var(--surface-2);
    color: var(--ink);
  }
  .wall__link:focus-visible {
    outline-offset: -4px;
  }
  .wall__link :global(.wall__logo) {
    width: auto;
    height: auto;
    max-height: 4rem;
    max-width: 100%;
    object-fit: contain;
  }
  /* The pause button, small, under the board on its right. */
  .ticker__pause {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: var(--s-2) 0 0 auto;
    min-height: 2.25rem;
    padding: 0.4rem 0.75rem;
    border: 2px solid var(--pr-navy);
    background: transparent;
    color: var(--pr-navy);
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }
  .ticker__pause:hover {
    background: var(--pr-navy);
    color: var(--ink);
  }
  .ticker__glyph {
    width: 0.875rem;
    height: 0.875rem;
  }
  .ticker__glyph--play,
  .ticker.is-paused .ticker__glyph--pause {
    display: none;
  }
  .ticker.is-paused .ticker__glyph--play {
    display: block;
  }
  :global(html:not(.js)) .ticker__pause {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
    }
    .ticker__copy,
    .ticker__pause {
      display: none;
    }
    .ticker__view {
      overflow-x: auto;
      scrollbar-color: var(--accent-2) var(--bg);
    }
  }
  /* A title with no clean official logo: its name set in Pixel Operator at the logos' height. */
  .wall__word {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
  }
  /* Or its pixel icon and its name. */
  .wall__name {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    text-align: center;
    text-wrap: balance;
  }
  .wall__name :global(.gameicon) {
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
  }
  .wall__name :global(.gameicon rect:not(.px-navy)) {
    fill: var(--ink);
  }
  @media (max-width: 63.99rem) {
    .ticker {
      --cell: 11rem;
      --cell-h: 6.5rem;
    }
    .wall__link {
      padding: var(--s-2);
    }
    .wall__link :global(.wall__logo) {
      max-height: 3.25rem;
    }
    .wall__name {
      font-size: 1.25rem;
    }
    .wall__word {
      font-size: 2.25rem;
    }
  }
  @media (max-width: 47.99rem) {
    .ticker {
      --cell: 7.5rem;
      --cell-h: 5rem;
    }
    .wall__link :global(.wall__logo) {
      max-height: 2.5rem;
    }
    .wall__name {
      font-size: 1rem;
      gap: 0.5rem;
    }
    .wall__word {
      font-size: 1.75rem;
    }
    .wall__name :global(.gameicon) {
      width: 1.75rem;
      height: 1.75rem;
    }
  }

  /* Level 3: four big pixel numbers on the field, divided by thin rules, counted up into view. */
  .stats__board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .stat {
    padding: var(--s-2) var(--s-3) var(--s-2) var(--s-3);
    border-left: 1px solid var(--rule);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stat__num {
    font-family: var(--font-display);
    font-size: clamp(4rem, 2rem + 5vw, 7rem);
    font-size: round(clamp(4rem, 2rem + 5vw, 7rem), 16px);
    line-height: 0.9;
    max-width: none;
  }
  .stat__label {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
    max-width: none;
  }
  @media (max-width: 63.99rem) {
    .stats__board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--s-4);
    }
    .stat:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
    .stat__label {
      font-size: 1.25rem;
    }
  }

  /* Level 4: the scoreboard */
  .proof__link {
    color: var(--pr-navy);
  }
  .proof__status {
    font-family: var(--font-display);
    font-size: 1.25rem;
    max-width: none;
  }
  .proof__score {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    max-width: none;
  }
  .proof__score[hidden] {
    display: none;
  }
  .proof__scoremark {
    font-size: 3rem;
    line-height: 0;
  }
  .proof__score.is-fail .proof__scoremark {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .proof__score.is-in {
      animation: boot-pop 360ms var(--ease-out) both;
    }
  }
  @keyframes boot-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .proof__board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--s-4);
  }
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-3) 0 var(--s-4);
    min-width: 0;
    overflow: hidden;
    border-top: 1px solid var(--rule);
  }
  .panel__mark {
    font-size: 2.5rem;
    line-height: 0;
    transition: color var(--dur-base) ease;
  }
  .panel__mark :global(.proof__cross),
  .panel__mark .proof__idle {
    display: none;
  }
  .proof__idle {
    width: 1em;
    height: 1em;
  }
  /* Before the test runs nothing is ticked: an empty box and a blank count */
  .panel.is-idle .panel__mark .proof__idle {
    display: block;
  }
  .panel.is-idle .panel__mark :global(.proof__pass),
  .panel.is-pending .panel__mark :global(.proof__pass) {
    display: none;
  }
  .panel.is-pending .panel__mark .proof__idle {
    display: block;
  }
  .panel.is-failed :global(.proof__pass) {
    display: none;
  }
  .panel.is-failed :global(.proof__cross) {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .panel.is-pass .panel__mark {
      animation: mark-pop 320ms var(--ease-out);
    }
  }
  @keyframes mark-pop {
    from {
      transform: scale(0.6);
    }
    to {
      transform: none;
    }
  }
  .panel__num {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 0.9;
    max-width: none;
  }
  .panel__of {
    font-size: 1.25rem;
  }
  .panel__title {
    font-size: 1.75rem;
  }
  .panel__detail {
    font-size: 1rem;
    max-width: none;
  }
  @media (max-width: 63.99rem) {
    .proof__board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-3);
    }
    .panel__num {
      font-size: 3rem;
    }
    .panel__title {
      font-size: 1.5rem;
    }
  }
  @media (max-width: 47.99rem) {
    .proof__board {
      grid-template-columns: 1fr;
    }
    .panel {
      padding: var(--s-2) 0 var(--s-3);
      gap: 0.25rem;
    }
    .panel__num {
      font-size: 2.25rem;
    }
    .panel__title {
      font-size: 1.25rem;
    }
    .panel__detail {
      font-size: 0.8125rem;
    }
  }

  /* Level 5: after hours, then the last button */
  .final__text {
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: 52ch;
  }
  .final__actions {
    margin-top: var(--s-3);
  }
  .final__actions .button {
    font-size: 1.5rem;
    min-height: 3.5rem;
    padding-inline: 2rem;
  }
  .final__mail {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--pr-navy);
  }
  .final__mail:hover {
    color: var(--pr-blue);
  }
</style>

<script>
  import { startBreak } from '../scripts/break';
  import { checks as engine } from '../scripts/checks';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  startBreak();

  // The curtain: the hero is pinned while the next level slides over it. A hero taller than the
  // screen (a phone) pins with its bottom edge on the bottom of the screen instead of its top.
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero && !reduce) {
    const pin = () => {
      // The room the bottom bar takes; the desktop track stands in the gutter and takes none (the
      // body's bottom padding there is only a strip at the end of the page for the scoreboard).
      const bar = matchMedia('(min-width: 64rem)').matches ? 0 : parseFloat(getComputedStyle(document.body).paddingBottom) || 0;
      hero.style.setProperty('--hero-top', `${Math.min(0, innerHeight - bar - hero.offsetHeight)}px`);
    };
    pin();
    addEventListener('resize', pin);
    addEventListener('load', pin);
    document.fonts?.ready.then(pin);
  }

  // The ticker: the button pauses and plays it; a logo that gets keyboard focus is brought into
  // view by jumping the animation to the moment it passes the middle of the board (the animation
  // itself pauses while anything inside has focus). Static under reduced motion, so nothing to do.
  const tick = document.querySelector<HTMLElement>('[data-ticker]');
  if (tick && !reduce) {
    const view = tick.querySelector<HTMLElement>('.ticker__view')!;
    // Focus scrolls the hidden overflow itself; the transform does that job, so the scroll stays 0.
    view.addEventListener('scroll', () => (view.scrollLeft = 0));
    const track = tick.querySelector<HTMLElement>('.ticker__track')!;
    const pause = tick.querySelector<HTMLButtonElement>('[data-ticker-pause]')!;
    const word = pause.querySelector<HTMLElement>('[data-ticker-word]')!;
    pause.addEventListener('click', () => {
      const paused = tick.classList.toggle('is-paused');
      word.textContent = paused ? 'Play' : 'Pause';
      pause.setAttribute('aria-label', paused ? 'Play the logos' : 'Pause the logos');
    });
    tick.addEventListener('focusin', (e) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('.wall__item');
      const anim = track.getAnimations()[0];
      view.scrollLeft = 0;
      if (!item || !anim) return;
      const half = track.scrollWidth / 2;
      const want = Math.max(0, item.offsetLeft + item.offsetWidth / 2 - view.clientWidth / 2);
      const duration = Number(anim.effect?.getComputedTiming().duration ?? 0);
      if (duration) anim.currentTime = Math.min(0.999, want / half) * duration;
    });
  }

  // The numbers count up once, as the stats come into view. The real number is in the HTML.
  const counters = document.querySelectorAll<HTMLElement>('[data-count-to]');
  if (counters.length && !reduce && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const to = Number(el.dataset.countTo);
      const t0 = performance.now();
      const ms = 1400;
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / ms);
        const eased = 1 - Math.pow(1 - k, 3);
        el.textContent = String(Math.round(to * eased));
        if (k < 1) requestAnimationFrame(tick);
      };
      el.textContent = '0';
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          run(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      },
      { threshold: 0.5 },
    );
    counters.forEach((el) => io.observe(el));
  }

  // The live thing: real checks on this page, run in the visitor's browser, from the shared engine
  // the Quality page uses too.
  const button = document.getElementById('selftest') as HTMLButtonElement | null;
  const status = document.getElementById('selftest-status');
  const tiles = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-check]').forEach((t) => tiles.set(t.dataset.check!, t));
  const checks = ['pages', 'console', 'links', 'viewports', 'a11y', 'brand'].map((id) => engine[id]);

  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const score = document.getElementById('selftest-score');

  button?.addEventListener('click', async () => {
    button.disabled = true;
    if (status) status.textContent = `Running ${checks.length} checks`;
    if (score) {
      score.hidden = true;
      score.classList.remove('is-in', 'is-fail');
    }
    for (const t of tiles.values()) {
      t.classList.remove('is-idle');
      t.classList.add('is-pending');
    }
    let passedAll = 0;
    let failedAll = 0;
    let tilesPassed = 0;
    for (const check of checks) {
      const tile = tiles.get(check.id);
      const { passed, failed, detail } = await check.run();
      if (!reduce) await wait(260);
      passedAll += passed;
      failedAll += failed;
      if (failed === 0) tilesPassed++;
      if (tile) {
        tile.classList.remove('is-pending', 'is-pass');
        tile.classList.toggle('is-failed', failed > 0);
        if (failed === 0) tile.classList.add('is-pass');
        const count = tile.querySelector('[data-count]');
        const of = tile.querySelector('.panel__of');
        const det = tile.querySelector('[data-detail]');
        if (count) count.textContent = String(passed);
        if (of) of.textContent = ` of ${passed + failed}`;
        if (det) det.textContent = detail;
      }
    }
    if (status) status.textContent = failedAll ? `${passedAll} passed, ${failedAll} failed on your device` : `${passedAll} of ${passedAll} passed on your device`;
    if (score) {
      const value = score.querySelector('[data-score]');
      const word = score.querySelector('[data-score-word]');
      if (value) value.textContent = `${tilesPassed}/${checks.length}`;
      if (word) word.textContent = failedAll ? 'Fail' : 'Pass';
      score.classList.toggle('is-fail', failedAll > 0);
      score.hidden = false;
      score.classList.add('is-in');
    }
    button.disabled = false;
    button.textContent = 'Run again';
    document.dispatchEvent(new CustomEvent('playrun:achieve', { detail: 'selftest' }));
  });
</script>

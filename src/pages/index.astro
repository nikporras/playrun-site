<script>
  // The live thing: real checks on this page, run in the visitor's browser.
  type Check = { id: string; run: () => Promise<[number, number, string]> };

  const button = document.getElementById('selftest') as HTMLButtonElement | null;
  const status = document.getElementById('selftest-status');
  const tiles = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-check]').forEach((t) => tiles.set(t.dataset.check!, t));

  // Only links to routes that exist in this build are checked, so unbuilt pages never fail the test.
  const builtRoutes: string[] = JSON.parse(document.querySelector('.proof')?.getAttribute('data-routes') ?? '[]');
  const routeOf = (href: string) => new URL(href).pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
  const internalLinks = () =>
    Array.from(document.querySelectorAll<HTMLAnchorElement>('a[href]'))
      .map((a) => a.href)
      .filter((h) => h.startsWith(location.origin) && !h.includes('#') && builtRoutes.includes(routeOf(h)))
      .filter((h, i, arr) => arr.indexOf(h) === i);

  const checks: Check[] = [
    {
      id: 'pages',
      run: async () => {
        const h1 = document.querySelectorAll('h1').length;
        return [h1 === 1 ? 1 : 0, h1 === 1 ? 0 : 1, h1 === 1 ? 'This page has exactly one h1' : `Found ${h1} h1 elements`];
      },
    },
    {
      id: 'console',
      run: async () => {
        const errors = (window as unknown as { __playrunErrors: string[] }).__playrunErrors ?? [];
        return [errors.length ? 0 : 1, errors.length ? 1 : 0, errors.length ? `${errors.length} script errors since load` : 'No script errors since this page loaded'];
      },
    },
    {
      id: 'links',
      run: async () => {
        const links = internalLinks();
        const results = await Promise.all(
          links.map(async (href) => {
            try {
              const r = await fetch(href, { method: 'HEAD', cache: 'no-store' });
              return r.ok;
            } catch {
              return false;
            }
          }),
        );
        const ok = results.filter(Boolean).length;
        return [ok, links.length - ok, `${ok} of ${links.length} links to built pages answered 200`];
      },
    },
    {
      id: 'viewports',
      run: async () => {
        const over = document.documentElement.scrollWidth > document.documentElement.clientWidth;
        return [over ? 0 : 1, over ? 1 : 0, over ? `Sideways overflow at ${innerWidth}px` : `No sideways overflow at ${innerWidth}px wide`];
      },
    },
    {
      id: 'a11y',
      run: async () => {
        const problems: string[] = [];
        if (!document.documentElement.lang) problems.push('missing lang');
        if (document.querySelectorAll('main').length !== 1) problems.push('main landmark');
        document.querySelectorAll('img').forEach((img) => {
          if (!img.hasAttribute('alt')) problems.push('image without alt');
        });
        document.querySelectorAll<HTMLElement>('a, button').forEach((el) => {
          const name = (el.getAttribute('aria-label') || el.textContent || '').trim();
          if (!name) problems.push('control without a name');
        });
        const n = problems.length;
        return [n ? 0 : 1, n ? 1 : 0, n ? `${n} problems: ${problems.slice(0, 2).join(', ')}` : 'Language set, one main landmark, every image and control named'];
      },
    },
    {
      id: 'brand',
      run: async () => {
        await document.fonts.ready;
        const pixel = document.fonts.check('16px "Pixel Operator"');
        const mont = document.fonts.check('16px Montserrat');
        const favicon = !!document.querySelector('link[rel="icon"]');
        const passed = [pixel, mont, favicon].filter(Boolean).length;
        return [passed, 3 - passed, passed === 3 ? 'Pixel Operator and Montserrat loaded, favicon present' : 'A brand asset did not load'];
      },
    },
  ];

  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const score = document.getElementById('selftest-score');

  button?.addEventListener('click', async () => {
    button.disabled = true;
    if (status) status.textContent = `Running ${checks.length} checks`;
    if (score) {
      score.hidden = true;
      score.classList.remove('is-in', 'is-fail');
    }
    for (const t of tiles.values()) {
      t.classList.remove('is-idle');
      t.classList.add('is-pending');
    }
    let passedAll = 0;
    let failedAll = 0;
    let tilesPassed = 0;
    for (const check of checks) {
      const tile = tiles.get(check.id);
      const [passed, failed, detail] = await check.run();
      if (!reduce) await wait(260);
      passedAll += passed;
      failedAll += failed;
      if (failed === 0) tilesPassed++;
      if (tile) {
        tile.classList.remove('is-pending', 'is-pass');
        tile.classList.toggle('is-failed', failed > 0);
        if (failed === 0) tile.classList.add('is-pass');
        const count = tile.querySelector('[data-count]');
        const of = tile.querySelector('.panel__of');
        const det = tile.querySelector('[data-detail]');
        if (count) count.textContent = String(passed);
        if (of) of.textContent = ` of ${passed + failed}`;
        if (det) det.textContent = detail;
      }
    }
    if (status) status.textContent = failedAll ? `${passedAll} passed, ${failedAll} failed on your device` : `${passedAll} of ${passedAll} passed on your device`;
    if (score) {
      const value = score.querySelector('[data-score]');
      const word = score.querySelector('[data-score-word]');
      if (value) value.textContent = `${tilesPassed}/${checks.length}`;
      if (word) word.textContent = failedAll ? 'Fail' : 'Pass';
      score.classList.toggle('is-fail', failedAll > 0);
      score.hidden = false;
      score.classList.add('is-in');
    }
    button.disabled = false;
    button.textContent = 'Run again';
    document.dispatchEvent(new CustomEvent('playrun:achieve', { detail: 'selftest' }));
  });

  // Rolling figures in the facts tile: digit columns roll up once as part of the boot.
  (() => {
    const els = Array.from(document.querySelectorAll<HTMLElement>('[data-roll]'));
    if (!els.length || reduce) return;
    els.forEach((el) => {
      const value = el.textContent?.trim() ?? '';
      const said = Object.assign(document.createElement('span'), { className: 'visually-hidden', textContent: value });
      const shown = Object.assign(document.createElement('span'), { className: 'roll__digits' });
      shown.setAttribute('aria-hidden', 'true');
      let i = 0;
      for (const ch of value) {
        if (!/\d/.test(ch)) {
          shown.append(ch);
          continue;
        }
        const col = Object.assign(document.createElement('span'), { className: 'roll__col' });
        col.style.setProperty('--d', ch);
        col.style.setProperty('--i', String(i++));
        shown.append(col);
      }
      el.classList.add('roll');
      el.replaceChildren(said, shown);
    });
    requestAnimationFrame(() => requestAnimationFrame(() => els.forEach((el) => el.classList.add('is-in'))));
  })();
</script>

---
import Breakable from '../components/Breakable.astro';
import Base from '../layouts/Base.astro';
import Bug from '../components/Bug.astro';
import Join from '../components/Join.astro';
import Swipe from '../components/Swipe.astro';
import PassMark from '../components/PassMark.astro';
import CrossMark from '../components/CrossMark.astro';
import { Image } from 'astro:assets';
import { browsers, bugSweep, liveDay, suite } from '../data/suite';
import { listed } from '../config';
import { testPlan, tickets } from '../data/qalab';
import { bugReportTemplate } from '../data/samples';
import qa001 from '../assets/qa-lab/qa-001.webp';
import qa002 from '../assets/qa-lab/qa-002.png';

// Level 3 and 4: the dates read in words, the run that deployed the page (or the build, locally)
const day = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/London' });
const deployed = suite.run ? day(suite.run.startedAt) : null;
const evidence: Record<string, ImageMetadata> = { 'QA-001': qa001, 'QA-002': qa002 };
const template = bugReportTemplate(`playrunqa.com, ${deployed ? `deployed ${deployed}` : `built ${day(new Date())}`}`);

// The run that deployed this page: GitHub Actions builds only after the suite has passed and
// hands the build that run's report (src/data/suite.ts). A local build has no run.
// The report card's two lines on the suite, from its data: the checks that passed in the run that
// deployed the page (a local build has only the list), and where they run.
const suiteLine = suite.run ? `${suite.checks} checks passed before this page went live.` : `${suite.checks} checks run before this page goes live.`;
const whereLine = `Run in ${listed(browsers)} on every push${liveDay ? `, and against the live site every ${liveDay}` : ''}.`;
// The report card's icon: a sheet with lines, in the steps' 8x8 pixel style.
const reportIcon = ['.######.', '.#....#.', '.#.##.#.', '.#....#.', '.#.##.#.', '.#....#.', '.#.##.#.', '.######.'];

// The test plan: five steps, each a set of live checks from the engine, then how to see the same
// thing yourself on the device you are testing on, picked at the top of the plan (Chrome or Edge,
// Firefox, Safari, iPhone, Android): numbered steps, one action each with that browser's shortcut
// or menu, and what you should see when all is well. On a phone: what the phone itself can show,
// and Pocket DevTools for the rest. Without script every option shows, each under its name.
type Device = 'chrome' | 'firefox' | 'safari' | 'iphone' | 'android';
type Browser = 'chrome' | 'firefox' | 'safari';
type How = { do: string; key?: string; see: string; note?: string };
const devices: { id: Device; label: string; title: string }[] = [
  { id: 'chrome', label: 'Chrome or Edge', title: 'Check it yourself in Chrome or Edge' },
  { id: 'firefox', label: 'Firefox', title: 'Check it yourself in Firefox' },
  { id: 'safari', label: 'Safari', title: 'Check it yourself in Safari on a Mac' },
  { id: 'iphone', label: 'iPhone', title: 'Check it yourself on an iPhone' },
  { id: 'android', label: 'Android', title: 'Check it yourself on an Android phone' },
];
const openTools = (b: Browser): How => ({
  do: 'Open the developer tools.',
  key:
    b === 'safari'
      ? 'First turn the Develop menu on, once: Safari menu, Settings, Advanced, tick Show features for web developers. Then press Cmd+Option+I.'
      : 'Press F12, or Ctrl+Shift+I (Cmd+Option+I on a Mac).',
  see: 'A panel opens at the side or the foot of the window, with a row of tabs along its top.',
});
const reload = (b: Browser) => (b === 'safari' ? 'Cmd+R' : 'Ctrl+R (Cmd+R on a Mac)');
// (the phones' Reduce motion line, the same ending on both)
const motionLine = (lead: string) => `${lead}come back: the games, the curtain and every animation stop, unless you've turned Motion on in the header.`;
// Each step's accent (its border, number and title) and its 8 by 8 pixel icon.
const looks: Record<string, { accent: string; icon: string[] }> = {
  // a puff of smoke, two small ones rising from it
  smoke: { accent: 'var(--accent-sky)', icon: ['.....#..', '....#.#.', '.....#..', '..##....', '.####...', '######..', '#######.', '.######.'] },
  // a phone
  responsive: { accent: 'var(--pr-cyan)', icon: ['.######.', '.#....#.', '.#....#.', '.#....#.', '.#....#.', '.######.', '.###.##.', '.######.'] },
  // an eye
  a11y: { accent: 'var(--pr-blue-ink)', icon: ['........', '..####..', '.#....#.', '#..##..#', '#..##..#', '.#....#.', '..####..', '........'] },
  // a chain link
  links: { accent: 'var(--accent-steel)', icon: ['....###.', '...#...#', '...#..#.', '.###.#..', '#..#.##.', '.#..#...', '#...#...', '.###....'] },
  // a lightning bolt
  performance: { accent: 'var(--accent-indigo)', icon: ['....###.', '...###..', '..###...', '.######.', '...###..', '..###...', '.##.....', '#.......'] },
};
const iconPath = (rows: string[]) => rows.flatMap((row, y) => [...row].map((c, x) => (c === '#' ? `M${x} ${y}h1v1H${x}z` : ''))).join('');
const steps: { id: string; title: string; ask: string; checks: string[]; computer: (b: Browser) => How[]; iphone: string[]; android: string[] }[] = [
  {
    id: 'smoke',
    title: 'Smoke test',
    ask: 'Does the page load clean?',
    checks: ['pages', 'console'],
    computer: (b) => [
      openTools(b),
      { do: `Click the Console tab in that row, then reload the page with ${reload(b)}.`, see: 'No red lines in the Console. Grey or blue lines are only information.' },
    ],
    iphone: ['Pocket DevTools, further down, lists the console errors this page has caught since it loaded. It should say none.'],
    android: ['Pocket DevTools, further down, lists the console errors this page has caught since it loaded. It should say none.'],
  },
  {
    id: 'responsive',
    title: 'Responsive',
    ask: 'Does it fit the screen?',
    checks: ['viewports'],
    computer: (b) => [
      { do: 'Open the developer tools, as in Step 1 of the Smoke test.', see: 'The panel is open.' },
      {
        do: 'Turn on the phone-sized view.',
        key: b === 'chrome' ? 'Press Ctrl+Shift+M (Cmd+Shift+M on a Mac).' : b === 'firefox' ? 'Press Ctrl+Shift+M (Cmd+Option+M on a Mac).' : 'Develop menu, Enter Responsive Design Mode.',
        see: 'The page sits in a phone-sized frame, with a width box in the bar above it.',
        note: "The page switches to its phone layout. That's expected, it's what you're testing.",
      },
      { do: 'Click the width box, type 375 and press Enter. Then do the same with 768.', see: 'No sideways scrollbar, nothing cut off, and the bar of pages along the bottom.' },
    ],
    iphone: ['Rotate the phone: the page should reflow with no sideways scroll.', 'Pinch to zoom: the text should scale and nothing should stop you.'],
    android: ['Rotate the phone: the page should reflow with no sideways scroll.', 'Pinch to zoom: the text should scale and nothing should stop you.'],
  },
  {
    id: 'a11y',
    title: 'Accessibility',
    ask: 'Can everyone use it?',
    checks: ['a11y', 'focus'],
    computer: (b) => [
      { do: 'Reload the page, then press the Tab key once (above Caps Lock).', see: 'A Skip to content link appears at the top left, with an outline.' },
      {
        do: 'Keep pressing Tab.',
        key: b === 'safari' ? 'Hold Option while pressing Tab, or turn on Settings, Advanced, Press Tab to highlight each item on a webpage.' : undefined,
        see: 'The outline moves through every link and button in reading order.',
      },
      // (Lighthouse is in Chrome and Edge only; elsewhere the Tab check above is the one to trust)
      ...(b === 'chrome'
        ? [
            {
              do: 'Run the accessibility audit.',
              key: 'In the developer tools click the Lighthouse tab (behind the » arrow if the panel is narrow), tick Accessibility and untick the rest, then click Analyze page load.',
              see: 'A score of 100 in the Accessibility circle.',
            },
          ]
        : []),
    ],
    iphone: [
      'Turn on VoiceOver (Settings, Accessibility, VoiceOver) and swipe right through the page: every image and control is named.',
      motionLine('Turn on Reduce Motion (Settings, Accessibility, Motion) and '),
    ],
    android: [
      'Turn on TalkBack (Settings, Accessibility; the exact menu name varies by phone) and swipe right through the page: every image and control is named.',
      motionLine('Turn on Remove animations (Settings, Accessibility; the exact menu name varies by phone) and '),
    ],
  },
  {
    id: 'links',
    title: 'Links',
    ask: 'Does every link go somewhere?',
    checks: ['links'],
    computer: (b) => [
      { do: 'Open the developer tools, as in Step 1 of the Smoke test, and click the Network tab in the row along its top.', see: 'An empty list, or a note that it will record the next page load.' },
      { do: `Reload the page with ${reload(b)}.`, see: 'A row for every file. The Status column reads 200, or 304 for a file from the cache. No red rows.' },
    ],
    iphone: ['Pocket DevTools lists every request this page made, with its status and size.'],
    android: ['Pocket DevTools lists every request this page made, with its status and size.'],
  },
  {
    id: 'performance',
    title: 'Performance',
    ask: 'Is it fast?',
    checks: ['performance'],
    computer: (b) =>
      b === 'chrome'
        ? [
            {
              do: 'Run the performance audit.',
              key: 'In the developer tools click the Lighthouse tab, tick Performance and untick the rest, then click Analyze page load.',
              see: 'A score of 95 or more in the Performance circle.',
            },
          ]
        : [
            { do: `Open the developer tools, click the Network tab and reload the page with ${reload(b)}.`, see: 'The load time at the foot of the panel once the page has loaded: under two seconds is the target here.' },
          ],
    iphone: ['Pocket DevTools shows the load timings from this phone: time to first byte, first paint, loaded.'],
    android: ['Pocket DevTools shows the load timings from this phone: time to first byte, first paint, loaded.'],
  },
];
---

<Base
  title="QA Lab"
  fullTitle="Inside my QA Lab: how Nicolás Porras tests, live on this site"
  description="How I test, shown on this site: live checks on your device, a test plan for Bug Sweep and two real bug reports from building it."
>
  <!-- Level 1 -->
  <section class="level level--navy level--sky has-join-bottom qa" data-level="1" aria-labelledby="qa-title">
    <div class="level__head">
      <p class="flag" data-nosnippet data-load style="--d: 0ms"><span>QA Lab</span></p>
      <h1 id="qa-title" class="page__title">
        <span class="mask"><span class="mask__line quality__phrase" style="--i: 0">Inside my QA Lab</span></span>
      </h1>
      <p class="qa__lead statement" data-load style="--d: 360ms">
        How I test, shown on this site: live checks on your device, a real test plan and real bug reports from building it.
      </p>
    </div>
    <Join kind="clouds" from="var(--pr-navy)" to="var(--field-blue)" seed="quality-plan" />
    <Bug id="quality-1" style="right: 12%; top: 9rem" tablet="right: 10%; bottom: calc(var(--join-h) + 0.5rem)" walk="x -2rem" />
  </section>

  <!-- Level 2: the live checks. The five steps are cards; on a desktop with motion the level pins
       and they are dealt in one by one with the scroll, like drawing the next test case
       (src/scripts/deck.ts adds is-deck). On phones and tablets they swipe (Swipe.astro), each step
       running when its card is the one on show; with motion off on a desktop they stand in a column. -->
  <section class="level level--blue has-join-bottom plan" data-level="2" aria-labelledby="plan-title">
    <Join kind="terrain" from="var(--field-blue)" to="var(--pr-navy)" seed="quality-report" />
    <div class="level__head">
      <p class="flag" data-nosnippet data-enter><span>Level 2 &middot; Live checks</span></p>
      <h2 id="plan-title" class="level__title" data-enter="wipe">Live checks</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">Smoke, responsive, accessibility, links, performance. Pass or fail, live, on your device.</p>
    </div>
    <!-- The device picker: each step then shows only the instructions for that browser or phone
         (with script; without it every option shows, each under its name) -->
    <div class="picker level__body" role="group" aria-labelledby="picker-label" data-picker>
      <p class="picker__label" id="picker-label">Testing on:</p>
      <div class="picker__options">
        {devices.map((d) => (
          <button type="button" class="picker__btn" data-device={d.id} aria-pressed="false" data-umami-event="quality-device" data-umami-event-device={d.id}>
            {d.label}
          </button>
        ))}
      </div>
    </div>
    <!-- The head stays above: the deck pins the stage alone, so a card has the whole screen -->
    <Swipe label="The five steps and the report" count={steps.length + 1} class="deck level__body swipe--top" data-deck>
      <div class="deck__pin">
        <div class="steps deck__stage swipe__track">
      {
        steps.map((s, i) => (
          <div class="step is-idle deck__card" id={`step-${s.id}`} role="group" aria-roledescription="slide" aria-label={`Step ${i + 1} of ${steps.length + 1}`} data-step={s.id} data-checks={JSON.stringify(s.checks)} style={`--i: ${i}; --tilt: ${[-2.5, 2, -1.5, 2.5, -2][i]}deg; --step-accent: ${looks[s.id].accent}`}>
            <div class="step__head">
              <p class="step__num">Step {i + 1}</p>
              <h3 class="step__title">
                <svg class="step__icon" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
                  <path d={iconPath(looks[s.id].icon)} fill="currentColor" />
                </svg>
                {s.title}
              </h3>
              <p class="step__ask">{s.ask}</p>
            </div>
            <div class="step__run">
              <p class="step__state">
                <span class="step__mark" aria-hidden="true">
                  <svg class="step__idle" viewBox="0 0 7 7" shape-rendering="crispEdges"><path d="M0 0h7v1H0zM0 6h7v1H0zM0 1h1v5H0zM6 1h1v5H6z" fill="currentColor" /></svg>
                  <PassMark class="step__pass" />
                  <CrossMark class="step__cross" />
                </span>
                <span data-step-word>Not run yet</span>
              </p>
              <p class="step__result" data-step-result>This step runs in your browser, with script on. The checks below work either way.</p>
            </div>
            <div class="step__how">
              {devices.map((d) => (
                <div class="step__for" data-for={d.id}>
                  <h4 class="step__howtitle">{d.title}</h4>
                  <ol class="step__list">
                    {d.id === 'iphone' || d.id === 'android'
                      ? s[d.id].map((line) => <li>{line}</li>)
                      : s.computer(d.id).map((h) => (
                          <li class="how">
                            <p class="how__do">{h.do}</p>
                            {h.key && <p class="how__key">{h.key}</p>}
                            <p class="how__see">
                              <span class="how__seekey">You should see</span> {h.see}
                            </p>
                            {h.note && <p class="how__note">{h.note}</p>}
                          </li>
                        ))}
                  </ol>
                </div>
              ))}
            </div>
          </div>
        ))
      }
          <!-- The report: the sixth card, dealt and swiped like the steps. When it comes on show it
               runs any step that has not run yet, so it is always complete. -->
          <div class="report deck__card" id="report" role="group" aria-roledescription="slide" aria-label={`Report, ${steps.length + 1} of ${steps.length + 1}`} data-report style={`--i: ${steps.length}; --tilt: 1.5deg; --step-accent: var(--pr-light)`}>
            <div class="report__head">
              <p class="step__num">Report</p>
              <h3 class="step__title" id="report-title">
                <svg class="step__icon" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
                  <path d={iconPath(reportIcon)} fill="currentColor" />
                </svg>
                Test report
              </h3>
            </div>
            <div class="report__body">
              <ol role="list" class="report__list">
                {steps.map((s, i) => (
                  <li class="report__row is-idle" data-report-row={s.id}>
                    <span class="report__name">
                      {i + 1}. {s.title}
                    </span>
                    <span class="report__result">
                      <span class="step__mark" aria-hidden="true">
                        <svg class="step__idle" viewBox="0 0 7 7" shape-rendering="crispEdges"><path d="M0 0h7v1H0zM0 6h7v1H0zM0 1h1v5H0zM6 1h1v5H6z" fill="currentColor" /></svg>
                        <PassMark class="step__pass" />
                        <CrossMark class="step__cross" />
                      </span>
                      <span data-report-result>Not run yet</span>
                    </span>
                  </li>
                ))}
              </ol>
              <p class="report__score" data-report-score aria-live="polite">Not run yet.</p>
              <p class="report__suite">{suiteLine}</p>
              <p class="report__where">{whereLine}</p>
            </div>
          </div>
        </div>
      </div>
    </Swipe>

    <!-- Pocket DevTools: on a phone, what F12 would show, from the page's own records -->
    <section class="devtools" aria-labelledby="devtools-title" data-enter>
      <h3 id="devtools-title" class="devtools__title">Pocket DevTools</h3>
      <p class="devtools__lead">What you'd see in the developer tools on a computer, right here on your phone.</p>
      <div class="devtools__tabs">
        <section class="devtools__pane" aria-labelledby="dev-console">
          <h4 id="dev-console" class="devtools__tab">Console</h4>
          <ul role="list" class="devtools__list" data-dev-console>
            <li class="devtools__muted">Needs script.</li>
          </ul>
        </section>
        <section class="devtools__pane" aria-labelledby="dev-network">
          <h4 id="dev-network" class="devtools__tab">Network</h4>
          <table class="devtools__table">
            <thead>
              <tr><th scope="col">File</th><th scope="col">Type</th><th scope="col">Status</th><th scope="col">Size</th></tr>
            </thead>
            <tbody data-dev-network>
              <tr><td colspan="4" class="devtools__muted">Needs script.</td></tr>
            </tbody>
          </table>
        </section>
        <section class="devtools__pane" aria-labelledby="dev-perf">
          <h4 id="dev-perf" class="devtools__tab">Performance</h4>
          <dl class="devtools__perf" data-dev-perf>
            <dt>Timings</dt>
            <dd class="devtools__muted">Needs script.</dd>
          </dl>
        </section>
      </div>
    </section>
    <Bug id="quality-2" style="right: 10%; top: 1.5rem" tablet="right: 30%; top: 0.75rem" walk="x -2rem" />
    <!-- (in the strip at the level's foot, above the join: the report level it lived on is gone) -->
    <Bug id="quality-3" style="left: 12%; bottom: calc(var(--join-h) + 0.75rem)" tablet="left: 10%; bottom: calc(var(--join-h) + 0.75rem)" phone="left: var(--gutter); bottom: calc(var(--join-h) + 2.5rem)" walk="x 2rem" />
  </section>

  <!-- Level 3: the test plan for Bug Sweep, the game on the About page. Every count, test title,
       browser and result comes from the suite (src/data/suite.ts, the checks tagged @bugsweep). -->
  <section class="level level--navy has-join-bottom testplan" data-level="3" aria-labelledby="testplan-title">
    <Join kind="clouds" from="var(--pr-navy)" to="var(--field-light)" seed="qa-lab-plan" />
    <div class="level__head">
      <p class="flag" data-nosnippet data-enter><span>Level 3 &middot; Test plan</span></p>
      <h2 id="testplan-title" class="level__title" data-enter="wipe">Test plan: Bug Sweep</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">The plan for the game on my <a href="/about/#bug-sweep">About page</a>, written the way I write one for a game build.</p>
    </div>
    <div class="testplan__grid level__body">
      <section class="tp" aria-labelledby="tp-scope">
        <h3 id="tp-scope" class="tp__title">Scope</h3>
        <h4 class="tp__sub">In scope</h4>
        <ul class="tp__list">{testPlan.scope.in.map((t) => <li>{t}</li>)}</ul>
        <h4 class="tp__sub">Out of scope</h4>
        <ul class="tp__list">{testPlan.scope.out.map((t) => <li>{t}</li>)}</ul>
      </section>
      <section class="tp" aria-labelledby="tp-platforms">
        <h3 id="tp-platforms" class="tp__title">Platforms and devices</h3>
        <dl class="tp__fields">
          <dt>Automated</dt>
          <dd data-tp-automated>{listed(bugSweep.browsers)} in CI on every push, at {testPlan.automatedSizes}.</dd>
          <dt>By hand</dt>
          <dd><ul class="tp__list">{testPlan.byHand.map((t) => <li>{t}</li>)}</ul></dd>
        </dl>
      </section>
      <section class="tp" aria-labelledby="tp-risks">
        <h3 id="tp-risks" class="tp__title">Risks</h3>
        <ul class="tp__list">{testPlan.risks.map((t) => <li>{t}</li>)}</ul>
      </section>
      <section class="tp" aria-labelledby="tp-types">
        <h3 id="tp-types" class="tp__title">Test types</h3>
        <table class="tp__table">
          <thead><tr><th scope="col">Type</th><th scope="col">What I check</th></tr></thead>
          <tbody>{testPlan.types.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
        </table>
      </section>
      <section class="tp tp--wide" aria-labelledby="tp-auto">
        <h3 id="tp-auto" class="tp__title">What the automated tests cover</h3>
        <p class="tp__total" data-tp-total>{bugSweep.total} checks, run on every change</p>
        <!-- (the groups and their counts come from each check's tag in the suite: suite.ts COVERAGE) -->
        <ul role="list" class="tp__groups" data-tp-groups>
          {bugSweep.groups.map((g) => (
            <li class="tp__group">
              <span class="tp__count">{g.total}</span>
              <span class="tp__what"><strong class="tp__name">{g.name}{g.ticket && <>{' '}<a href={`#${g.ticket.toLowerCase()}`}>{g.ticket}</a></>}</strong> <span class="tp__line">{g.line}</span></span>
            </li>
          ))}
        </ul>
        <details class="tp__more" data-tp-coverage>
          <summary class="tp__summary">See every test</summary>
          <div class="tp__files">
            {bugSweep.files.map((f) => (
              <section class="tp__file">
                <h4 class="tp__filename"><code><Breakable text={f.file} /></code></h4>
                <ul class="tp__list tp__list--tight">{f.lines.map((l) => <li>{l.title}</li>)}</ul>
              </section>
            ))}
          </div>
        </details>
      </section>
      <section class="tp" aria-labelledby="tp-hand">
        <h3 id="tp-hand" class="tp__title">Checked by hand</h3>
        <ul class="tp__list">{testPlan.checkedByHand.map((t) => <li>{t}</li>)}</ul>
      </section>
      <section class="tp" aria-labelledby="tp-criteria">
        <h3 id="tp-criteria" class="tp__title">Entry and exit criteria</h3>
        <dl class="tp__fields">
          <dt>Entry</dt>
          <dd><ul class="tp__list">{testPlan.entry.map((t) => <li>{t}</li>)}</ul></dd>
          <dt>Exit</dt>
          <dd><ul class="tp__list">{testPlan.exit.map((t) => <li>{t}</li>)}</ul></dd>
          <dt>After release</dt>
          <dd>The check of the live site{liveDay ? ` every ${liveDay}` : ''}, which also plays Bug Sweep under the site's security policy.</dd>
        </dl>
      </section>
      <section class="tp" aria-labelledby="tp-run">
        <h3 id="tp-run" class="tp__title">How a test run goes</h3>
        <ol class="tp__steps">{testPlan.run.map(([k, v]) => <li><strong>{k}</strong>: {v}</li>)}</ol>
      </section>
      <section class="tp" aria-labelledby="tp-results">
        <h3 id="tp-results" class="tp__title">Results</h3>
        <table class="tp__table" data-tp-results>
          <thead><tr><th scope="col">Checks</th><th scope="col">Passed</th><th scope="col">Failed</th></tr></thead>
          <tbody>
            <tr>
              <td class="num" data-label="Checks">{bugSweep.total}</td>
              <td class="num" data-label="Passed">{suite.run ? bugSweep.passed : 'Not run yet'}</td>
              <td class="num" data-label="Failed">{suite.run ? bugSweep.failed : 'Not run yet'}</td>
            </tr>
          </tbody>
        </table>
        <p class="tp__note">{suite.run ? `From the run that deployed this page, ${deployed}.` : 'The run that deploys this page fills these in.'}</p>
      </section>
      <section class="tp" aria-labelledby="tp-known">
        <h3 id="tp-known" class="tp__title">Known issues</h3>
        <ul class="tp__list"><li><a href="#qa-002">QA-002</a>: one enemy bug glitches when it returns to formation. Low, kept on purpose.</li></ul>
      </section>
    </div>
  </section>

  <!-- Level 4: two real bugs from building this site, as tickets, and my template. -->
  <section class="level level--light has-join-bottom reports" data-level="4" aria-labelledby="reports-title">
    <Join kind="terrain" from="var(--field-light)" to="var(--pr-navy)" seed="qa-lab-foot" />
    <div class="level__head">
      <p class="flag" data-nosnippet data-enter><span>Level 4 &middot; Bug reports</span></p>
      <h2 id="reports-title" class="level__title" data-enter="wipe">Bug reports</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">Two real bugs from building this site, written the way I log them at work.</p>
    </div>
    <div class="reports__list level__body">
      {
        tickets.map((t) => (
          <article class="ticket" id={t.id.toLowerCase()} aria-labelledby={`${t.id.toLowerCase()}-title`}>
            <header class="ticket__head">
              <p class="ticket__id">{t.id}</p>
              <h3 id={`${t.id.toLowerCase()}-title`} class="ticket__title">{t.title}</h3>
              <p class:list={['ticket__status', `ticket__status--${t.state}`]}><span class="visually-hidden">Status: </span>{t.status}</p>
            </header>
            <dl class="ticket__fields">
              <dt>Environment</dt>
              <dd>
                <dl class="ticket__env">
                  {t.environment.map(([k, v]) => (
                    <>
                      <dt>{k}</dt>
                      <dd>{v}</dd>
                    </>
                  ))}
                </dl>
              </dd>
              <dt>Severity</dt>
              <dd><strong>{t.severity[0]}</strong>. {t.severity[1]}</dd>
              <dt>Priority</dt>
              <dd><strong>{t.priority[0]}</strong>. {t.priority[1]}</dd>
              <dt>Frequency</dt>
              <dd>{t.frequency}</dd>
              <dt>Preconditions</dt>
              <dd>{t.preconditions}</dd>
            </dl>
            <h4 class="ticket__sub">Steps to reproduce</h4>
            <ol class="ticket__steps">{t.steps.map((step) => <li>{step}</li>)}</ol>
            <dl class="ticket__fields">
              <dt>Expected</dt>
              <dd>{t.expected}</dd>
              <dt>Actual</dt>
              <dd>{t.actual}</dd>
            </dl>
            <h4 class="ticket__sub">Evidence</h4>
            <figure class="ticket__evidence">
              <Image src={evidence[t.id]} alt={t.evidence.alt} widths={[320, 480, 640]} sizes="(min-width: 64rem) 30rem, 90vw" loading="lazy" decoding="async" format="webp" />
              <figcaption>{t.evidence.caption}</figcaption>
            </figure>
            <h4 class="ticket__sub">Notes on the cause</h4>
            <ul class="ticket__notes">{t.cause.map((c) => <li>{c}</li>)}</ul>
            <h4 class="ticket__sub">Resolution</h4>
            <ul class="ticket__notes">
              {t.resolution.map((r) => <li>{r}</li>)}
            </ul>
            {t.play && <a class="button ticket__play" href={t.play.href}>{t.play.label}</a>}
          </article>
        ))
      }
      <section class="template" aria-labelledby="template-title">
        <h3 id="template-title" class="template__title">My bug report template</h3>
        <pre class="template__body">{template}</pre>
      </section>
    </div>
  </section>
</Base>

<style>
  .quality__phrase {
    text-wrap: balance;
    /* (just over its longest balanced line, so the heading's box hugs its lines and leaves the
       space beside it clear for bug quality-1) */
    max-width: 6em;
  }
  /* The title is one phrase in balanced lines, a step smaller than the other pages' titles: three
     lines at most on a phone, two from tablets up. Sizes stay on the 8px (phone) and 16px grids so the pixel font keeps crisp. */
  #qa-title {
    font-size: min(round(var(--step-hero), 16px), round(14.5vw, 16px));
  }
  @media (max-width: 63.99rem) {
    #qa-title {
      font-size: round(14.5vw, 16px);
    }
  }
  @media (max-width: 47.99rem) {
    #qa-title {
      font-size: round(15vw, 8px);
    }
  }
  .qa {
    padding-top: var(--s-3);
  }
  .qa__lead {
    max-width: 40ch;
  }
  /* tablets: a strip at the hero's foot, above the clouds, where bug quality-1 walks clear of the lead */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .qa.has-join-bottom {
      padding-bottom: calc(var(--s-5) + var(--join-h) + 3.5rem);
    }
  }
  /* Level 2: five steps, each a navy card: the name, the live result, the way to see it. In the
     deck (global.css) the cards stack on one stage; here they stand in a column. */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }
  .step,
  .report {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 5fr);
    column-gap: var(--s-4);
    padding: var(--s-4);
    background: var(--bg);
    color: var(--pr-light);
    --muted-2: var(--muted);
    --ink-2: var(--accent-2);
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
    border: 2px solid var(--surface-2); /* (where color-mix is missing) */
    border: 2px solid color-mix(in srgb, var(--step-accent, var(--surface-2)) 35%, var(--pr-navy));
    border-top: 0.25rem solid var(--step-accent, var(--accent-2));
  }
  .step__num {
    color: var(--step-accent, var(--pr-light));
    font-family: var(--font-display);
    font-size: 0.9375rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    max-width: none;
  }
  .step__title {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: 2rem;
    margin-top: var(--s-1);
    color: var(--step-accent, var(--pr-light));
  }
  .step__icon {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }
  .step__ask {
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.45;
    margin-top: var(--s-1);
    max-width: none;
  }
  .step__state {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    max-width: none;
  }
  .step__mark {
    display: inline-grid;
    place-items: center;
    font-size: 1.5rem;
    line-height: 0;
  }
  .step__idle {
    width: 1em;
    height: 1em;
  }
  .step__mark :global(.step__pass),
  .step__mark :global(.step__cross),
  .step__idle {
    display: none;
  }
  .step.is-idle .step__idle,
  .step.is-running .step__idle,
  .step.is-unmeasured .step__idle {
    display: block;
  }
  /* Not measured: neither a pass nor a fail, in grey */
  .step.is-unmeasured .step__state {
    color: var(--muted);
  }
  .step.is-pass .step__mark :global(.step__pass) {
    display: block;
  }
  .step.is-fail .step__mark :global(.step__cross) {
    display: block;
  }
  .step.is-pass .step__mark {
    color: var(--accent);
  }
  .step.is-pass .step__mark,
  .step.is-fail .step__mark {
    animation: mark-pop 320ms var(--ease-out);
  }
  .step.is-running .step__idle {
    animation: blink 700ms steps(2) infinite;
  }
  @keyframes mark-pop {
    from {
      transform: scale(0.6);
    }
    to {
      transform: none;
    }
  }
  @keyframes blink {
    to {
      opacity: 0.3;
    }
  }
  .step__result {
    font-size: 1rem;
    margin-top: var(--s-2);
    max-width: 44ch;
  }
  .step__howtitle {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--s-2);
  }
  /* Without script every option shows, one after another under its name. */
  .step__for + .step__for {
    margin-top: var(--s-3);
  }
  .step__for[hidden] {
    display: none;
  }
  :global(.js) .plan.is-phone .devtools {
    display: block;
  }
  /* The picker: a row of real buttons, the one pressed in light. */
  .picker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-2);
    margin-bottom: var(--s-4);
  }
  :global(html:not(.js)) .picker {
    display: none;
  }
  .picker__label {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .picker__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }
  .picker__btn {
    min-height: 2.75rem;
    padding: 0 var(--s-2);
    border: 2px solid var(--pr-navy);
    background: var(--pr-navy);
    color: var(--pr-light);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .picker__btn:hover {
    border-color: var(--pr-light);
  }
  .picker__btn[aria-pressed='true'] {
    background: var(--pr-light);
    border-color: var(--pr-light);
    color: var(--pr-navy);
  }
  .picker__btn:focus-visible {
    outline: 3px solid var(--pr-light);
    outline-offset: 2px;
  }
  .how__key {
    margin-top: 0.4em;
    font-size: 1rem;
    color: var(--pr-light);
    max-width: 48ch;
  }
  .step__list {
    padding-left: 1.25rem;
    font-size: 1rem;
    max-width: 48ch;
  }
  .step__list li + li {
    margin-top: 0.4em;
  }
  /* One action a step, the browsers that differ, then what you should see. */
  .how + .how {
    margin-top: var(--s-2);
  }
  .how__do {
    max-width: none;
  }
  /* In the deck the card must fit one screen with the level head above it, so it lays out in two
     rows: the name and the live result side by side, then the how-to steps across the full width,
     three abreast, so the card is only as tall as its longest step. */
  :global(.deck.is-deck) .step {
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    grid-template-areas:
      'head run'
      'how how';
    row-gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
  }
  :global(.deck.is-deck) .step__head {
    grid-area: head;
  }
  :global(.deck.is-deck) .step__run {
    grid-area: run;
  }
  :global(.deck.is-deck) .step__how {
    grid-area: how;
    border-top: 1px solid var(--surface-2);
    padding-top: var(--s-2);
  }
  :global(.deck.is-deck) .step__for .step__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--s-2) var(--s-4);
    max-width: none;
    padding-left: 1.25rem;
  }
  :global(.deck.is-deck) .how + .how {
    margin-top: 0;
  }
  .how__see {
    margin-top: 0.5em;
    font-size: 1rem;
    color: var(--muted);
    max-width: 48ch;
  }
  .how__seekey {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-right: 0.3em;
  }
  .how__note {
    margin-top: 0.5em;
    font-size: 1rem;
    color: var(--accent-2);
    max-width: 48ch;
  }
  /* Pocket DevTools: three panes, set like the tool it stands in for. Shown when a phone is picked;
     without script, on a phone-sized screen. */
  .devtools {
    display: none;
    margin-top: var(--s-6);
    border-top: 1px solid var(--rule);
    padding-top: var(--s-4);
  }
  .devtools__title {
    font-size: 2rem;
  }
  .devtools__lead {
    font-size: 1rem;
    margin-top: var(--s-1);
  }
  .devtools__tabs {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }
  .devtools__pane {
    background: var(--bg);
    color: var(--ink);
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
    padding: var(--s-2);
    font-family: ui-monospace, 'Cascadia Mono', Consolas, 'Courier New', monospace;
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .devtools__tab {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin: 0 0 var(--s-1);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--surface-2);
  }
  /* (the rows, items and timings are written by the script, so they take these rules through
     :global: Astro's scoped rules reach only the elements in the markup) */
  .devtools__list :global(li) {
    overflow-wrap: anywhere;
  }
  .devtools__list :global(li.is-error) {
    color: #f29a9a;
  }
  .devtools__muted,
  .devtools__pane :global(.devtools__muted) {
    color: var(--muted);
  }
  /* The network table: a fixed layout, so no cell's text ever runs into the next. The file takes
     what is left and ends in an ellipsis; type, status and size keep their width. */
  .devtools__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .devtools__table th,
  .devtools__table :global(td) {
    text-align: left;
    padding: 0.2rem 0.5rem 0.2rem 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .devtools__table th {
    color: var(--muted);
    font-weight: 400;
  }
  .devtools__table th:nth-child(2) {
    width: 8ch;
  }
  .devtools__table th:nth-child(3),
  .devtools__table th:nth-child(4) {
    width: 8.5ch;
  }
  .devtools__table :global(td.is-ok) {
    color: var(--accent);
  }
  .devtools__table :global(td.is-bad) {
    color: #f29a9a;
  }
  /* On phones (below 48rem, where Pocket DevTools shows) each row stacks: the file on a line of its
     own as the row's heading, then the type, status and size under it, each with its column's name.
     The header row stays for screen readers only. */
  @media (max-width: 47.99rem) {
    .devtools__table,
    .devtools__table tbody {
      display: block;
    }
    .devtools__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .devtools__table :global(tr) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.15rem 0.5rem;
      padding: 0.4rem 0;
      border-top: 1px solid var(--surface-2);
    }
    .devtools__table :global(td) {
      width: auto;
      padding: 0;
    }
    .devtools__table :global(td:first-child) {
      grid-column: 1 / -1;
      font-weight: 600;
      color: var(--ink);
    }
    .devtools__table :global(td[data-label])::before {
      content: attr(data-label);
      content: attr(data-label) / '';
      display: block;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
  }
  .devtools__perf :global(dt) {
    color: var(--muted);
  }
  .devtools__perf :global(dd) {
    margin: 0;
  }
  .devtools__perf {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.2rem 1rem;
    margin: 0;
  }

  /* The report card: the step's box, its head on the left, the five results, the score and the
     suite's two lines on the right. Each result in words, its mark beside it (never colour alone). */
  .report {
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
  }
  /* a foot strip under the deck for the bug, above the join */
  .plan.has-join-bottom {
    padding-bottom: calc(var(--s-5) + var(--join-h) + 3.5rem);
  }
  .report__body {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .report__list {
    display: grid;
    margin: 0;
    padding: 0;
  }
  .report__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2);
    padding: 0.6rem 0;
    border-top: 1px solid var(--surface-2);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.1;
  }
  .report__row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .report__result {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .report__result .step__mark {
    font-size: 1.125rem;
  }
  .report__row.is-idle .step__idle,
  .report__row.is-unmeasured .step__idle {
    display: block;
  }
  .report__row.is-unmeasured .report__result {
    color: var(--muted);
  }
  .report__row.is-pass .step__mark :global(.step__pass),
  .report__row.is-fail .step__mark :global(.step__cross) {
    display: block;
  }
  .report__row.is-pass .step__mark {
    color: var(--accent);
  }
  .report__score {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    max-width: none;
    margin-top: var(--s-2);
  }
  .report__suite,
  .report__where {
    font-size: 1rem;
    max-width: 34em;
  }
  .report__where {
    color: var(--muted);
  }

  @media (max-width: 63.99rem) {
    .step,
    .report {
      grid-template-columns: 1fr;
      row-gap: var(--s-3);
      padding: var(--s-3);
    }
    .step__result {
      max-width: 34em;
    }
  }
  @media (max-width: 47.99rem) {
    :global(html:not(.js)) .devtools {
      display: block;
    }
  }

  /* Level 3: the test plan, in blocks on the navy (two a row from 64rem, the coverage table the
     whole row). Headings in the display face, everything to read in Montserrat. */
  .testplan__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4) var(--s-5);
  }
  .tp {
    min-width: 0;
  }
  .tp--wide {
    grid-column: 1 / -1;
  }
  .tp__title {
    margin-bottom: var(--s-2);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--accent-2);
  }
  .tp__sub {
    margin: var(--s-2) 0 var(--s-1);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tp__sub:first-of-type {
    margin-top: 0;
  }
  .tp__list,
  .tp__steps {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.35rem;
  }
  .tp__list--tight {
    gap: 0.2rem;
    font-size: 0.9375rem;
  }
  .tp__list li,
  .tp__steps li {
    max-width: 34em;
  }
  .tp__note {
    margin: 0 0 var(--s-2);
    color: var(--muted);
  }
  .tp__results + .tp__note {
    margin-top: var(--s-2);
  }
  .tp__fields {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.5rem var(--s-3);
    margin: 0;
  }
  .tp__fields dt {
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tp__fields dd {
    margin: 0;
  }
  .tp__table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--s-2);
  }
  .tp__table th,
  .tp__table td {
    padding: 0.5rem 0.75rem 0.5rem 0;
    text-align: left;
    vertical-align: top;
    border-top: 1px solid var(--surface-2);
  }
  .tp__table thead th {
    border-top: 0;
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tp__table tbody th {
    font-weight: 600;
  }
  .tp__table code {
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  /* What the automated tests cover: the total, the groups in plain words with their counts, then
     every test in a closed dropdown. */
  .tp__total {
    margin: 0 0 var(--s-2);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    max-width: none;
  }
  .tp__groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--s-2) var(--s-4);
    margin: 0 0 var(--s-3);
    padding: 0;
  }
  .tp__group {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--s-2);
    align-items: baseline;
  }
  .tp__count {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--accent);
    text-align: right;
  }
  .tp__name {
    display: block;
    font-weight: 600;
  }
  .tp__line {
    color: var(--muted);
  }
  .tp__more {
    border-top: 1px solid var(--surface-2);
    border-bottom: 1px solid var(--surface-2);
  }
  .tp__summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 0;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-2);
    cursor: pointer;
    list-style: none;
  }
  .tp__summary::-webkit-details-marker {
    display: none;
  }
  /* (a pixel arrow that turns down when open) */
  .tp__summary::before {
    content: '';
    width: 0.5rem;
    height: 0.75rem;
    background: currentColor;
    clip-path: polygon(0 0, 25% 0, 25% 12.5%, 50% 12.5%, 50% 25%, 75% 25%, 75% 37.5%, 100% 37.5%, 100% 62.5%, 75% 62.5%, 75% 75%, 50% 75%, 50% 87.5%, 25% 87.5%, 25% 100%, 0 100%);
  }
  .tp__more[open] > .tp__summary::before {
    transform: rotate(90deg);
  }
  .tp__summary:hover {
    color: var(--ink);
  }
  .tp__summary:focus-visible {
    outline: 3px solid var(--accent-2);
    outline-offset: 4px;
  }
  .tp__files {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-1) 0 var(--s-3);
  }
  .tp__filename {
    margin: 0 0 var(--s-1);
    font-family: inherit;
    font-size: 1rem;
    font-weight: 400;
  }
  .tp__filename code {
    font-size: 0.9375rem;
  }
  .testplan a:not(.button),
  .reports a:not(.button) {
    color: inherit;
  }
  @media (max-width: 63.99rem) {
    .testplan__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 47.99rem) {
    /* (the tables stack: each row a small block, its first cell the heading, the other cells under
       it with the column's name where it is needed; the header row stays for screen readers only) */
    .tp__table,
    .tp__table tbody,
    .tp__table tr,
    .tp__table th,
    .tp__table td {
      display: block;
    }
    .tp__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .tp__table tr {
      padding: 0.75rem 0;
      border-top: 1px solid var(--surface-2);
    }
    .tp__table th,
    .tp__table td {
      padding: 0;
      border-top: 0;
    }
    .tp__table tbody th {
      margin-bottom: 0.2rem;
    }
    .tp__table[data-tp-results] tr {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-2);
    }
    .tp__table td[data-label]::before {
      content: attr(data-label);
      content: attr(data-label) / '';
      display: block;
      margin-bottom: 0.2rem;
      font-family: var(--font-display);
      font-size: 0.875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .tp__fields {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
    .tp__fields dd + dt {
      margin-top: var(--s-1);
    }
  }

  /* Level 4: the tickets, navy cards on the light field, then the template. */
  .reports__list {
    display: grid;
    gap: var(--s-5);
  }
  .ticket {
    padding: var(--s-4);
    background: var(--pr-navy);
    color: var(--ink);
    max-width: 52rem;
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
  }
  .ticket__head {
    display: grid;
    gap: var(--s-1);
    margin-bottom: var(--s-3);
  }
  .ticket__id {
    margin: 0;
    font-family: var(--font-display);
    letter-spacing: 0.08em;
    color: var(--accent-2);
  }
  .ticket__title {
    font-size: 1.5rem;
    line-height: 1.15;
  }
  .ticket__status {
    justify-self: start;
    margin: 0;
    padding: 0.2rem 0.5rem 0.15rem;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--pr-navy);
  }
  .ticket__status--fixed {
    background: var(--accent);
  }
  .ticket__status {
    --sel-bg: var(--pr-navy);
    --sel-ink: var(--pr-light);
  }
  .ticket__status--open {
    background: var(--pr-blue-ink);
  }
  .ticket__fields,
  .ticket__env {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.5rem var(--s-3);
    margin: 0 0 var(--s-3);
  }
  .ticket__env {
    grid-template-columns: 8rem minmax(0, 1fr);
    margin: 0;
  }
  .ticket__fields > dt,
  .ticket__env > dt {
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ticket__env > dt {
    text-transform: none;
    letter-spacing: 0;
  }
  .ticket dd {
    margin: 0;
  }
  /* (about 70 characters a line at most, as everywhere people read) */
  .ticket dd,
  .ticket li {
    max-width: 33em;
  }
  .ticket__sub {
    margin: var(--s-3) 0 var(--s-1);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ticket__steps + .ticket__fields {
    margin-top: var(--s-3);
  }
  .ticket__steps,
  .ticket__notes {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.35rem;
  }
  .ticket__evidence {
    margin: 0;
  }
  .ticket__play {
    margin-top: var(--s-3);
    font-size: 1.125rem;
    min-height: 2.75rem;
    padding-inline: 1.25rem;
  }
  .ticket__evidence :global(img) {
    width: 100%;
    max-width: 30rem;
    height: auto;
    border: 2px solid var(--surface-2);
    image-rendering: auto;
  }
  #qa-002 .ticket__evidence :global(img) {
    image-rendering: pixelated;
  }
  .ticket__evidence figcaption {
    margin-top: var(--s-1);
    font-size: var(--step-small);
    color: var(--muted);
  }
  .template {
    max-width: 52rem;
    color: var(--pr-navy);
  }
  .template__title {
    margin-bottom: var(--s-2);
    font-size: 1.5rem;
  }
  .template__body {
    margin: 0;
    padding: var(--s-3);
    background: var(--field-light-surface);
    border: 2px solid var(--pr-navy);
    font-size: 0.9375rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }
  @media (max-width: 47.99rem) {
    .ticket {
      padding: var(--s-3) var(--s-2);
    }
    .ticket__fields,
    .ticket__env {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
    .ticket__fields > dd + dt,
    .ticket__env > dd + dt {
      margin-top: var(--s-1);
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/motion';
  import { checks, errorsSinceLoad, kb, timings, pageLoaded, NOT_REPORTED, type Result } from '../scripts/checks';
  import { startDeck } from '../scripts/deck';
  import { startSwipes } from '../scripts/swipe';
  startDeck();
  startSwipes();

  // The device picker: preselected from this browser and device, the choice kept for later visits
  // (when storage is there); each step shows only that option's instructions, and a phone brings
  // Pocket DevTools.
  const plan = document.querySelector<HTMLElement>('.plan');
  const picks = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-picker] [data-device]'));
  const DEVICE_KEY = 'playrun.device';
  const detect = () => {
    const ua = navigator.userAgent;
    if (/iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1 && 'ontouchend' in document)) return 'iphone';
    if (/Android/.test(ua)) return 'android';
    if (/Firefox\//.test(ua)) return 'firefox';
    if (/Safari\//.test(ua) && !/Chrome\/|Chromium\/|Edg\//.test(ua)) return 'safari';
    return 'chrome';
  };
  const known = (v: string | null) => (v && picks.some((b) => b.dataset.device === v) ? v : null);
  let saved: string | null = null;
  try {
    saved = known(localStorage.getItem(DEVICE_KEY));
  } catch {
    /* storage off: detect each time */
  }
  const pick = (device: string, keep: boolean) => {
    picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.device === device)));
    document.querySelectorAll<HTMLElement>('.step__for').forEach((el) => (el.hidden = el.dataset.for !== device));
    plan?.classList.toggle('is-phone', device === 'iphone' || device === 'android');
    if (keep) {
      try {
        localStorage.setItem(DEVICE_KEY, device);
      } catch {
        /* storage off: the choice holds for this page */
      }
    }
  };
  picks.forEach((b) => b.addEventListener('click', () => pick(b.dataset.device!, true)));
  pick(saved ?? detect(), false);

  const reduce = reducedMotion();
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.step'));
  const score = document.querySelector<HTMLElement>('[data-report-score]');
  const reportCard = document.querySelector<HTMLElement>('[data-report]');
  const results = new Map<string, Result & { details: string[] }>();
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  const report = () => {
    let pass = 0;
    for (const step of steps) {
      const id = step.dataset.step!;
      const row = document.querySelector<HTMLElement>(`[data-report-row="${id}"]`);
      const r = results.get(id);
      if (!row) continue;
      // the result in words, its mark beside it
      const state = !r ? 'idle' : r.failed ? 'fail' : r.unmeasured ? 'unmeasured' : 'pass';
      row.classList.remove('is-idle', 'is-pass', 'is-fail', 'is-unmeasured');
      row.classList.add(`is-${state}`);
      row.querySelector('[data-report-result]')!.textContent = { idle: 'Not run yet', fail: 'Fail', unmeasured: 'Not measured', pass: 'Pass' }[state];
      if (r && !r.failed && !r.unmeasured) pass++;
    }
    if (score && results.size) {
      const done = results.size === steps.length;
      // (a step that could not measure on this browser is neither a pass nor a fail)
      const unmeasured = [...results.values()].filter((r) => !r.failed && r.unmeasured).length;
      const measured = results.size - unmeasured;
      score.textContent = !done
        ? `${pass} of ${results.size} steps passed so far. ${steps.length - results.size} to go.`
        : unmeasured
          ? `${pass} of ${measured} measured steps passed on your device, ${unmeasured} not measured.`
          : `${pass} of ${steps.length} steps passed on your device.`;
    }
  };

  const runStep = async (step: HTMLElement) => {
    if (step.dataset.done) return;
    step.dataset.done = '1';
    const id = step.dataset.step!;
    const ids: string[] = JSON.parse(step.dataset.checks ?? '[]');
    const word = step.querySelector<HTMLElement>('[data-step-word]')!;
    const out = step.querySelector<HTMLElement>('[data-step-result]')!;
    step.classList.remove('is-idle', 'is-pass', 'is-fail', 'is-unmeasured');
    step.classList.add('is-running');
    word.textContent = 'Running';
    if (!reduce) await wait(320);
    let passed = 0;
    let failed = 0;
    let unmeasured = 0;
    const details: string[] = [];
    for (const c of ids) {
      try {
        const r = await checks[c].run();
        passed += r.passed;
        failed += r.failed;
        unmeasured += r.unmeasured ?? 0;
        details.push(r.detail);
      } catch (e) {
        // a check that throws is a failed check, not a stuck page
        failed++;
        details.push(`${c} could not run: ${(e as Error).message}`);
      }
    }
    step.classList.remove('is-running');
    // a fail only on a real figure over budget; nothing measured is neither a pass nor a fail
    const state = failed ? 'fail' : unmeasured ? 'unmeasured' : 'pass';
    step.classList.add(`is-${state}`);
    word.textContent = { fail: 'Fail', unmeasured: 'Not measured', pass: 'Pass' }[state];
    out.textContent = `${details.join('. ')}.`;
    results.set(id, { passed, failed, unmeasured, detail: details.join('. '), details });
    report();
    if (results.size === steps.length) document.dispatchEvent(new CustomEvent('playrun:achieve', { detail: 'selftest' }));
  };

  // The report card runs, in order, any step that has not run yet, so the report is always complete.
  let finishing = false;
  const finish = async () => {
    if (finishing) return;
    finishing = true;
    for (const s of steps) await runStep(s);
  };

  // Each step runs as it comes into view; under reduced motion, or without the observer, all at once,
  // once the page has fully loaded (so Performance has real figures).
  if (reduce || !('IntersectionObserver' in window)) {
    (async () => {
      await pageLoaded();
      for (const s of steps) await runStep(s);
    })();
  } else {
    // In a column or the deck a step runs as it comes into view. In the swipe (phones and tablets)
    // it runs when its card is the one on show while the row is on screen.
    const swiping = matchMedia('(max-width: 63.99rem)');
    const swipe = document.querySelector<HTMLElement>('.plan [data-swipe]');
    const track = swipe?.querySelector<HTMLElement>('.swipe__track');
    let rowSeen = false;
    const runShown = () => {
      if (!rowSeen) return;
      if (reportCard?.classList.contains('is-current')) return void finish();
      const shown = steps.find((s) => s.classList.contains('is-current'));
      if (shown) runStep(shown);
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.target === track) {
            rowSeen = e.isIntersecting;
            if (swiping.matches) runShown();
            continue;
          }
          if (!e.isIntersecting || swiping.matches) continue;
          io.unobserve(e.target);
          if (e.target === reportCard) finish();
          else runStep(e.target as HTMLElement);
        }
      },
      { threshold: 0.3 },
    );
    steps.forEach((s) => io.observe(s));
    if (reportCard) io.observe(reportCard);
    if (track) io.observe(track);
    swipe?.addEventListener('swipe:change', () => {
      if (swiping.matches) runShown();
    });
  }

  // Pocket DevTools: the console, the network and the timings, from the page's own records.
  const fillDevtools = () => {
    const con = document.querySelector<HTMLElement>('[data-dev-console]');
    const net = document.querySelector<HTMLElement>('[data-dev-network]');
    const perf = document.querySelector<HTMLElement>('[data-dev-perf]');
    const t = timings();
    if (con) {
      const errors = errorsSinceLoad();
      con.replaceChildren(
        ...(errors.length
          ? errors.map((e) => Object.assign(document.createElement('li'), { className: 'is-error', textContent: e }))
          : [Object.assign(document.createElement('li'), { textContent: 'No errors since this page loaded.' })]),
      );
    }
    if (net) {
      const rows = t.resources.slice(0, 40).map((r) => {
        const tr = document.createElement('tr');
        const file = r.name.split('/').pop()?.split('?')[0] || r.name;
        // a readable name: Astro's script chunks lose their suffix ("Header.astro_astro_type_script_
        // index_0_lang.Ab12.js" reads "Header.astro"); the full address stays in the title and for
        // screen readers
        const name = file.replace(/^(.+?\.astro)_astro_type_.*$/, '$1');
        const st = (r as PerformanceResourceTiming & { responseStatus?: number }).responseStatus;
        const type = r.initiatorType === 'xmlhttprequest' ? 'xhr' : r.initiatorType;
        const cells = [name, type, st ? String(st) : r.transferSize === 0 ? 'cache' : '200', r.transferSize ? kb(r.transferSize) : 'cache'];
        cells.forEach((text, i) => {
          const td = document.createElement('td');
          if (i === 0) {
            td.title = r.name;
            const shown = Object.assign(document.createElement('span'), { textContent: name });
            shown.setAttribute('aria-hidden', 'true');
            td.append(shown, Object.assign(document.createElement('span'), { className: 'visually-hidden', textContent: r.name }));
          } else {
            td.textContent = text;
            // (the column's name, shown beside the value when the row stacks on a phone)
            td.dataset.label = ['File', 'Type', 'Status', 'Size'][i];
          }
          if (i === 2) td.className = st && st >= 400 ? 'is-bad' : 'is-ok';
          tr.append(td);
        });
        return tr;
      });
      net.replaceChildren(...rows);
    }
    if (perf) {
      const ms = (n: number | null) => (n === null ? NOT_REPORTED : `${n} ms`);
      const pairs: [string, string][] = [
        ['Time to first byte', ms(t.ttfb)],
        [t.paint === null ? 'First paint' : t.paintLabel, ms(t.paint)],
        ['DOM ready', ms(t.domReady)],
        ['Loaded', ms(t.loaded)],
        ['Requests', String(t.requests)],
        ['Transferred', kb(t.bytes)],
      ];
      perf.replaceChildren(
        ...pairs.flatMap(([k, v]) => [Object.assign(document.createElement('dt'), { textContent: k }), Object.assign(document.createElement('dd'), { textContent: v })]),
      );
    }
  };
  if (document.readyState === 'complete') fillDevtools();
  else addEventListener('load', () => setTimeout(fillDevtools, 50));
  // The first paint entry can land after load on a slow or busy device: fill the panel again then.
  if ('PerformanceObserver' in window) {
    try {
      new PerformanceObserver(() => fillDevtools()).observe({ type: 'paint', buffered: true });
    } catch {
      /* no paint timing here */
    }
  }
</script>

---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Bug from '../../components/Bug.astro';
import GameIcon from '../../components/GameIcon.astro';
import { contact, primaryAction } from '../../config';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  const shown = import.meta.env.DEV ? all : all.filter((p) => p.data.public);
  return shown.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const when = d.status === 'in-development' ? 'In development' : String(d.year);
---

<Base title={d.title} description={`${d.title}: ${d.summary} Tested by PlayRun.`}>
  <section class="level level--navy proj" data-level="1" aria-labelledby="proj-title">
    <p class="flag" data-load style="--d: 0ms"><span>Stage &middot; {d.title}</span></p>
    <div class="proj__grid">
      <div class="proj__text">
        <h1 id="proj-title" class="page__title proj__title">
          <span class="mask"><span class="mask__line" style="--i: 0">{d.title}</span></span>
        </h1>
        <p class="proj__summary statement" data-load style="--d: 300ms">{d.summary}</p>
        <div class="proj__body" data-load style="--d: 380ms">
          <Content />
        </div>
        <div class="proj__actions" data-load style="--d: 460ms">
          {
            d.url && (
              <a class="button" href={d.url} rel="noopener">
                {d.store ?? 'On Steam'}
              </a>
            )
          }
          <a class="textlink" href="/portfolio">Back to the portfolio</a>
        </div>
      </div>
      <div class="proj__facts" data-load style="--d: 200ms">
        <span class="proj__mark"><GameIcon name={d.icon} /></span>
        <dl class="proj__list">
        <div>
          <dt>Studio</dt>
          <dd>{d.studio}</dd>
        </div>
        <div>
          <dt>Platforms</dt>
          <dd>{d.platforms.join(', ')}</dd>
        </div>
        <div>
          <dt>My role</dt>
          <dd>{d.role}</dd>
        </div>
        {d.employer && (
          <div>
            <dt>Where I tested it</dt>
            <dd>{d.employer === 'Universally Speaking' ? 'Universally Speaking, 2021' : 'nDreams, 2022 to 2024'}</dd>
          </div>
        )}
        <div>
          <dt>Status</dt>
          <dd>{when}</dd>
        </div>
        </dl>
      </div>
    </div>
    <Bug id={`project-${project.id}`} style="right: 8%; top: 10%" />
  </section>

  <section class="level level--green proj-ask" data-level="2" aria-labelledby="proj-ask-title">
    <p class="flag" data-enter><span>Level 2 &middot; Next</span></p>
    <h2 id="proj-ask-title" class="level__title" data-enter="wipe">Talk to me about this one</h2>
    <div class="proj-ask__actions" data-enter style="--enter-delay: 80ms">
      <a class="button button--navy" href={primaryAction.href}>{primaryAction.label}</a>
      <a class="proj-ask__mail" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
  </section>
</Base>

<style>
  .proj {
    padding-top: var(--s-2);
  }
  .proj__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-5);
    align-items: start;
    margin-top: var(--s-5);
  }
  .proj__title {
    font-size: round(clamp(3rem, 1rem + 7vw, 9rem), 16px);
  }
  .proj__summary {
    margin-top: var(--s-4);
    max-width: 40ch;
  }
  .proj__body {
    margin-top: var(--s-3);
    max-width: 56ch;
  }
  .proj__actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-4);
  }
  .proj__facts {
    position: relative;
    margin: 0;
    padding: 6rem var(--s-3) var(--s-3);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .proj__mark {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    width: 4rem;
    height: 4rem;
  }
  .proj__mark :global(.gameicon) {
    width: 100%;
    height: 100%;
  }
  .proj__list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .proj__facts dt {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin-bottom: 0.25rem;
  }
  .proj__facts dd {
    margin: 0;
    font-size: var(--step-body);
  }
  .proj-ask__actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-4);
  }
  .proj-ask__mail {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--pr-navy);
  }
  @media (max-width: 63.99rem) {
    .proj__grid {
      grid-template-columns: 1fr;
      gap: var(--s-4);
      margin-top: var(--s-4);
    }
    .proj__title {
      font-size: round(15vw, 8px);
    }
    .proj__facts {
      padding: 5rem var(--s-2) var(--s-2);
    }
  }
</style>

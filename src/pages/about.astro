  /* Level 2: Bug Sweep. The game sits in a navy screen on the cyan field: a status bar on top, the
     playing field (a canvas drawn at a whole number of device pixels per game pixel, so it stays
     crisp at every size), then on touch screens and on tablets and phones the Left, Fire and
     Right buttons, in the page's flow so the bottom bar never covers them. */
  .sweep {
    /* (text selected on the navy screen shows green, as in the footer) */
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
    width: 100%;
    max-width: 40rem;
    display: grid;
    gap: var(--s-2);
    /* (brought into view on Play with room under it for the bottom bar) */
    scroll-margin-bottom: calc(var(--hud-h, 0px) + var(--s-2));
    scroll-margin-top: var(--s-2);
  }
  .sweep__bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 2.75rem;
    padding: 0 var(--s-2);
    background: var(--pr-navy);
    color: var(--pr-light);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sweep__bar p {
    margin: 0;
    max-width: none;
  }
  .sweep__name {
    color: var(--pr-green);
    margin-right: auto !important;
  }
  .sweep__stat b {
    font-weight: 400;
    color: var(--pr-cyan);
  }
  .sweep__pause {
    align-self: stretch;
    margin-right: calc(-1 * var(--s-2));
    min-width: 2.75rem;
    padding: 0 var(--s-2);
    border: 0;
    border-left: 2px solid var(--surface-2);
    background: transparent;
    color: var(--pr-light);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }
  .sweep__pause:hover {
    color: var(--pr-cyan);
  }
  .sweep__pause[hidden] {
    display: none;
  }
  .sweep__stage {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 4;
    background: var(--pr-navy);
    overflow: hidden;
    touch-action: none;
  }
  .sweep__stage:focus-visible {
    outline: 3px solid var(--pr-light);
    outline-offset: 3px;
  }
  .sweep__canvas {
    grid-area: 1 / 1;

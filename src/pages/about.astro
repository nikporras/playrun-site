    gap: var(--s-2);
    padding: var(--s-3);
    background: rgb(12 21 42 / 0.88); /* (where color-mix is missing) */
    background: color-mix(in srgb, var(--pr-navy) 88%, transparent);
    color: var(--pr-light);
    text-align: center;
  }
  .sweep__overlay[hidden] {

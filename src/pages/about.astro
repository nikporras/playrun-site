</style>

<script>
  import { startDeck } from '../scripts/deck';
  import { startSwipes } from '../scripts/swipe';

  // What I test: dealt on a desktop with motion, swiped on phones and tablets.
  startDeck();
  startSwipes();

  // The Kit: a chip with a detail shows it while a mouse is over it or the keyboard is on it, and
  // a click or a tap keeps it open until the next one, a tap elsewhere or Escape. One at a time.
  const board = document.querySelector<HTMLElement>('[data-kit]');
  if (board) {
    const chips = Array.from(board.querySelectorAll<HTMLButtonElement>('[data-chip]'));
    let kept: HTMLButtonElement | null = null;
    const show = (chip: HTMLButtonElement, on: boolean) => {
      if (on) {
        chips.forEach((c) => c !== chip && c.setAttribute('aria-expanded', 'false'));
        const group = chip.closest('.kit__group')!.getBoundingClientRect();
        const box = chip.getBoundingClientRect();
        (chip.nextElementSibling as HTMLElement).style.setProperty('--x', `${box.left + box.width / 2 - group.left}px`);
      }
      chip.setAttribute('aria-expanded', String(on));
    };
    const shut = () => {
      chips.forEach((c) => c.setAttribute('aria-expanded', 'false'));
      kept = null;
    };
    for (const chip of chips) {
      chip.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && !kept) show(chip, true);
      });
      chip.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse' && kept !== chip) show(chip, false);
      });
      chip.addEventListener('focus', () => {
        if (chip.matches(':focus-visible') && kept !== chip) {
          kept = null;
          show(chip, true);
        }
      });
      chip.addEventListener('blur', () => {
        if (kept === chip) kept = null;
        show(chip, false);
      });
      chip.addEventListener('click', () => {
        if (kept === chip) {
          kept = null;
          show(chip, false);
        } else {
          kept = chip;
          show(chip, true);
        }
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') shut();
    });
    document.addEventListener('pointerdown', (e) => {
      if (kept && !kept.contains(e.target as Node)) shut();
    });
  }

  // Bug Sweep: the game's code arrives only when Play is pressed (a module of its own).
  const root = document.querySelector<HTMLElement>('[data-sweep]');
  const play = root?.querySelector<HTMLButtonElement>('[data-sweep-action]');
  if (root && play) {
    const start = async () => {
      play.removeEventListener('click', start);
      play.disabled = true;
      const { startSweep } = await import('../scripts/sweep');
      play.disabled = false;
      startSweep(root);
    };
    play.addEventListener('click', start);
  }
</script>

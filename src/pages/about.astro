---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Bug from '../components/Bug.astro';
import PixelTile from '../components/PixelTile.astro';
import PassMark from '../components/PassMark.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { contact, personal, primaryAction } from '../config';
import portrait from '../assets/photos/nicolas.png';

// From the CV in content-source, in the first person, with PlayRun's positioning.
const posts = [
  {
    where: 'Aonic',
    accent: 'green',
    when: 'July 2026 to now',
    role: 'Senior QA Tester',
    text: 'Game quality testing on the titles Megabit Publishing, part of Aonic, brings to console and PC: test plans, functional and regression passes on real hardware, platform checks before each submission, and bug reports the studios can act on.',
    terms: ["Lou's Lagoon", 'Thick as Thieves', 'CLAWPUNK', 'Gang of Frogs', 'Hello Sunshine', 'Vaewolf', 'Pathfinder: Abomination Vaults'],
  },
  {
    where: 'PlayRun, London',
    when: 'October 2025 to now',
    role: 'Founder & Lead QA',
    text: 'PlayRun is my personal brand for game QA: this site, my portfolio and how I test.',
    terms: ['Test plans', 'Real hardware', 'Milestone quality reports'],
  },
  {
    where: 'Historic VR, Guildford',
    accent: 'cyan',
    when: 'February 2025 to February 2026',
    role: 'QA Manager',
    text: 'I ran the testing environments and the QA hardware across every project, kept the low spec and recommended spec rigs honest, and profiled with Unreal Engine to find what gave. I planned the schedules with development, production and external QA, and grew the outsourced team to ten testers.',
    terms: ['Guildford Castle VR', 'Londinium: AD 215', 'Unreal Engine profiling', 'Low and recommended spec', 'Ten outsourced testers'],
  },
  {
    where: 'nDreams, Farnborough',
    accent: 'blue',
    when: '2022 to 2024',
    role: 'Senior QA Technician, then Lead QA Technician',
    text: 'Senior QA Technician on Fracked, Synapse and Ghostbusters: Rise of the Ghost Lord, and Lead QA Technician on one cancelled project. I started as the sole tester on a project: test plans, feature feedback, investigative testing, the bug lifecycle in Jira, the record in Confluence. Then I led the team, mentored the juniors, brought QA into sprint planning and retrospectives, and managed the external QA vendor day to day.',
    terms: ['Ghostbusters: Rise of the Ghost Lord', 'Synapse', 'Fracked', 'Jira and Confluence', 'Vendor management'],
  },
  {
    where: 'Universally Speaking, Bedford',
    accent: 'light',
    when: '2021',
    role: 'QA Technician',
    text: 'Where I started. Functional testing on VR titles and console releases for the studios that made them.',
    terms: ['Beat Saber', 'Walkabout Minigolf', 'A Township Tale', 'Space Pirate Trainer', 'Jurassic World Aftermath', 'The Climb 2', 'Cyberpunk 2077 (console)', 'NBA 2K21 (console)'],
    via: 'via Universally Speaking',
  },
];

const panels = [
  { title: 'Tools', items: ['Jira and Confluence', 'TestRail', 'Unreal Engine: debugging, profiling, Blueprint', 'Agile and Scrum'] },
  { title: 'How I work', items: ['A test plan the team can read before I start', 'Every pass on real hardware', 'Steps, severity, media and a build number on every bug', 'A quality report at each milestone'] },
  { title: 'Languages', items: ['Spanish, fluent', 'English, fluent', 'Chinese, Portuguese and Italian, intermediate'] },
  { title: 'Education', items: ['Swinburne University of Technology, Diploma in Information Technology, 2017 to 2019', 'South China Normal University, Guangzhou, Mandarin, 2015 to 2017'] },
];
---

<Base title="About" description="Nicolás Porras, founder and lead QA of PlayRun in London: testing games since 2021, at Universally Speaking, nDreams, Historic VR and Aonic.">
  <!-- Level 1: who -->
  <section class="level level--navy who" data-level="1" aria-labelledby="about-title">
    <p class="flag" data-load style="--d: 0ms"><span>About</span></p>
    <div class="who__grid">
      <div class="who__text">
        <h1 id="about-title" class="page__title">
          <span class="mask"><span class="mask__line" style="--i: 0">Nicolás</span></span>
          <span class="mask"><span class="mask__line" style="--i: 1">Porras</span></span>
        </h1>
        <p class="who__role" data-load style="--d: 300ms">Founder &amp; Lead QA, PlayRun. {contact.location}.</p>
        <p class="who__intro statement" data-load style="--d: 380ms">
          I have tested games since 2021: a year on VR titles at Universally Speaking, two years at nDreams where I
          ended up leading QA, a year as QA Manager at Historic VR, and since July 2026 Senior QA Tester at Aonic.
          PlayRun is my personal brand for the work.
        </p>
        <div class="who__actions" data-load style="--d: 460ms">
          <a class="button" href={primaryAction.href}>{primaryAction.label}</a>
          <ExternalLink class="textlink" href={personal.linkedin} rel="me">LinkedIn profile</ExternalLink>
        </div>
      </div>
      <div class="who__figure" data-load style="--d: 200ms">
        <Picture
          src={portrait}
          alt="Nicolás Porras wearing a VR headset pushed up on his head"
          widths={[400, 640, 960, 1280]}
          sizes="(max-width: 63.99rem) 80vw, 40vw"
          formats={['avif']}
          fallbackFormat="webp"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
    <Bug id="about-1" style="right: 12%; top: 6rem" tablet="left: 2rem; bottom: 1rem" walk="x -2rem" />
  </section>

  <!-- Level 2: where I have tested -->
  <section class="level level--blue posts" data-level="2" aria-labelledby="posts-title">
    <p class="flag" data-enter><span>Level 2 &middot; Where I have tested</span></p>
    <div class="posts__grid">
      <div class="posts__intro">
        <h2 id="posts-title" class="level__title" data-enter="wipe">Five years, four studios</h2>
        <p class="level__lead posts__lead" data-enter style="--enter-delay: 80ms">
          Each post added a layer: VR, leading a team, running the hardware, console and PC releases.
        </p>
      </div>
      <ol class="rows">
        {
          posts.map((p, i) => (
            <li class:list={['row', 'accent' in p && `accent--${p.accent}`]} data-enter style={`--enter-delay: ${i * 70}ms`}>
              <p class="row__meta">{p.when}</p>
              <h3 class="row__title">{p.where}</h3>
              <p class="posts__role">{p.role}</p>
              <p class="row__text">{p.text}</p>
              <ul role="list" class="row__terms">
                {p.terms.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              {p.via && <p class="posts__via">{p.via}</p>}
            </li>
          ))
        }
      </ol>
    </div>
    <Bug id="about-2" style="left: 10%; top: 60%" tablet="right: 10%; top: 23rem" phone="left: 1rem; bottom: 0.75rem" walk="y 2rem" />
  </section>

  <!-- Level 3: how I work -->
  <section class="level level--cyan how" data-level="3" aria-labelledby="how-title">
    <p class="flag" data-enter><span>Level 3 &middot; Kit and method</span></p>
    <h2 id="how-title" class="level__title" data-enter="wipe">What I bring</h2>
    <div class="how__board">
      {
        panels.map((p, i) => (
          <div class="how__panel how__panel--navy" data-enter="place" style={`--enter-delay: ${i * 60}ms`}>
            <PassMark class="how__mark" />
            <h3 class="how__title">{p.title}</h3>
            <ul role="list" class="how__list">
              {p.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="how__photo" data-enter="place">
        <PixelTile name="headset" tone="navy" />
      </div>
      <div class="how__photo" data-enter="place" style="--enter-delay: 60ms">
        <PixelTile name="controller" tone="navy" />
      </div>
    </div>
    <Bug id="about-3" style="right: 25%; bottom: 1.25rem" phone="right: 1rem; bottom: 0.5rem" walk="x 2rem" />
  </section>

  <!-- Level 4: off the clock -->
  <section class="level level--green off" data-level="4" aria-labelledby="off-title">
    <p class="flag" data-enter><span>Level 4 &middot; Off the clock</span></p>
    <div class="off__grid">
      <div>
        <h2 id="off-title" class="level__title" data-enter="wipe">After hours</h2>
        <p class="off__text" data-enter style="--enter-delay: 80ms">
          I play and pull apart games for the mechanics and the design choices, Helldivers, The Witcher and God of War
          lately. I play instruments and dance, music is a big part of my culture, and I am learning the drums. I watch
          and play most sports.
        </p>
        <div class="off__actions" data-enter style="--enter-delay: 160ms">
          <a class="button button--navy" href={primaryAction.href}>{primaryAction.label}</a>
          <a class="off__mail" href={`mailto:${contact.email}`}>{contact.email}</a>
        </div>
      </div>
      <div class="off__photo" data-enter="place">
        <PixelTile name="ship" tone="navy" />
      </div>
    </div>
    <Bug id="about-4" style="right: 10%; top: 33rem" tablet="right: 12%; top: 29rem" phone="left: 1rem; bottom: 0.5rem" walk="x -1.5rem" />
  </section>
</Base>

<style>
  .who {
    padding-top: var(--s-2);
  }
  .who__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-5);
    align-items: end;
    margin-top: var(--s-5);
  }
  .who__role {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--accent-2);
    margin-top: var(--s-3);
    max-width: none;
  }
  .who__intro {
    margin-top: var(--s-3);
    max-width: 40ch;
  }
  .who__actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-4);
  }
  /* The figure stands on the bottom edge of the navy field, beside the name. */
  .who {
    padding-bottom: 0;
  }
  .who__grid {
    align-items: end;
  }
  .who__text {
    padding-bottom: var(--s-7);
  }
  .who__figure {
    position: relative;
    align-self: end;
    width: min(100%, 34rem);
    justify-self: end;
    line-height: 0;
  }
  .who__figure::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 180%;
    height: 95%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse 55% 75% at 50% 100%, rgba(86, 189, 218, 0.4), rgba(81, 108, 179, 0.2) 55%, transparent 75%);
    pointer-events: none;
  }
  .who__figure :global(img) {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }

  .posts__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-5);
    align-items: start;
    margin-top: var(--s-5);
  }
  .posts__intro {
    position: sticky;
    top: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    color: var(--pr-navy);
  }
  .posts__lead {
    color: var(--pr-navy);
  }
  .posts__role {
    font-family: var(--font-display);
    font-size: 1.25rem;
    max-width: none;
    color: var(--g-ink, var(--accent-2));
  }
  /* Each company's row carries its accent on the edge, the dates, the role and the terms. */
  .row {
    border-left: 0.25rem solid var(--g-accent, var(--accent-2));
  }
  .row .row__meta,
  .row .row__terms {
    color: var(--g-ink, var(--accent-2));
  }
  .posts__via {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--muted);
    max-width: none;
  }

  .how__board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: minmax(17rem, auto);
    gap: var(--gap);
    margin-top: var(--s-5);
  }
  .how__panel {
    position: relative;
    padding: var(--s-3);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-2);
    min-width: 0;
  }
  .how__panel--navy {
    background: var(--bg);
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
    color: var(--ink);
  }
  .how__panel :global(.how__mark) {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    font-size: 2rem;
    color: var(--accent);
  }
  .how__title {
    font-size: 2rem;
  }
  .how__list {
    font-size: 1rem;
  }
  .how__list li + li {
    margin-top: 0.3em;
  }
  .how__panel--navy .how__list {
    color: var(--muted);
  }
  .how__photo {
    min-width: 0;
    min-height: 0;
  }

  .off__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-5);
    align-items: end;
    margin-top: var(--s-5);
  }
  .off__text {
    margin-top: var(--s-4);
    max-width: 52ch;
    font-size: var(--step-lead);
    line-height: 1.35;
  }
  .off__actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-4);
  }
  .off__mail {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--pr-navy);
  }
  .off__photo {
    min-height: 20rem;
  }

  @media (max-width: 63.99rem) {
    .who__grid,
    .posts__grid,
    .off__grid {
      grid-template-columns: 1fr;
      gap: var(--s-4);
      margin-top: var(--s-4);
    }
    .who__text {
      padding-bottom: 0;
    }
    .who__figure {
      width: min(80vw, 24rem);
      justify-self: center;
      margin-top: var(--s-2);
    }
    .posts__intro {
      position: static;
    }
    .how__board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
      gap: 0.375rem;
    }
    .how__panel {
      min-height: 14rem;
      padding: 4rem var(--s-2) var(--s-2);
    }
    .how__panel :global(.how__mark) {
      top: var(--s-2);
      right: var(--s-2);
    }
    .how__title {
      font-size: 1.75rem;
    }
    .how__photo {
      aspect-ratio: 1;
    }
    .off__photo {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }
</style>

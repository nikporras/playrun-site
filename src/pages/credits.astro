---
import Base from '../layouts/Base.astro';
import Icon from '../assets/logo/icon.svg';
import Sprite from '../components/Sprite.astro';
import GameIcon from '../components/GameIcon.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { getCollection } from 'astro:content';
import { logos } from '../data/logos';

const games = (await getCollection('projects')).filter((p) => p.data.public && p.data.logoSource && logos[p.id]).sort((a, b) => a.data.title.localeCompare(b.data.title));
const iconOnly = (await getCollection('projects')).filter((p) => p.data.public && !logos[p.id]).map((p) => p.data.title);
---

<Base title="Credits" description="Who made the typefaces, tools and artwork used on playrunqa.com.">
  <article class="credits wrap">
    <div class="credits__head">
      <div>
        <h1 class="credits__title">Credits</h1>
        <p class="lead">
          Everything on this site that I did not make myself is listed here, with its maker and its licence.
        </p>
      </div>
      <div class="credits__mark" aria-hidden="true">
        <Icon class="credits__icon" role="presentation" />
      </div>
    </div>

    <section class="credits__section" aria-labelledby="credits-pixels">
      <h2 id="credits-pixels">Pixel art</h2>
      <p>
        The ship, the bugs, the net, the controller and the headset are drawn for this site as bitmaps in the brand
        colours. Nothing is copied from any game. The portrait on the home page is my own.
      </p>
      <ul role="list" class="credits__sprites" aria-hidden="true">
        {(['ship', 'bug', 'net', 'controller', 'headset'] as const).map((n) => <li><Sprite name={n} class="credits__sprite" /></li>)}
      </ul>
      <p>
        Each game also has a generic icon drawn the same way, used where no clean official logo exists ({iconOnly.join(', ')}): a skyline, a ball, a seaplane, a frog, a mask, a cat, two sabres, a golf flag, a dinosaur, a
        ghost, a brain, a mountain with a ski track, a sun, a wolf, a castle, a Roman helmet, a thatched hut, a
        drone, a hand on a ledge and a barred vault gate.
      </p>
      <ul role="list" class="credits__sprites credits__icons" aria-hidden="true">
        {
          (['city', 'basketball', 'seaplane', 'frog', 'mask', 'cat', 'sabres', 'golf', 'dino', 'ghost', 'brain', 'mountain', 'sun', 'wolf', 'castle', 'helmet', 'hut', 'drone', 'hand', 'vault'] as const).map((n) => (
            <li>
              <GameIcon name={n} class="credits__sprite" />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="credits__section" aria-labelledby="credits-logos">
      <h2 id="credits-logos">Game logos</h2>
      <p>
        The logos on the home page and the portfolio are the games' own, shown in one colour and otherwise unaltered,
        each taken from its publisher's or developer's press kit or official page. They are the trademarks of their
        owners and appear here only to name the games I have tested.
      </p>
      <ul role="list" class="credits__list">
        {games.map((p) => (
          <li class="credits__item">
            {p.data.title}, the official logo from <ExternalLink href={p.data.logoSource!}>{new URL(p.data.logoSource!).hostname.replace(/^www\./, '')}</ExternalLink>
          </li>
        ))}
      </ul>
    </section>

    <section class="credits__section" aria-labelledby="credits-type">
      <h2 id="credits-type">Typefaces</h2>
      <ul role="list" class="credits__list">
        <li class="credits__item">
          Pixel Operator by Jayvee Enaguas, under the CC0 licence. The licence text ships with the fonts at{' '}
          <a href="/fonts/PixelOperator-LICENSE.txt">/fonts/PixelOperator-LICENSE.txt</a>.
        </li>
        <li class="credits__item">
          Montserrat by Julieta Ulanovsky and contributors, under the SIL Open Font License, self-hosted from the
          Fontsource package.
        </li>
      </ul>
    </section>

    <section class="credits__section" aria-labelledby="credits-tools">
      <h2 id="credits-tools">Built with</h2>
      <p>
        Designed, built and tested by PlayRun, with Astro, hosted on GitHub Pages. Tested with Playwright and
        axe-core on every push. The brand identity is PlayRun's own.
      </p>
    </section>
  </article>
</Base>

<style>
  .credits {
    padding-block: var(--s-5) var(--s-6);
  }
  .credits__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-4);
    align-items: center;
    min-height: 60svh;
  }
  .credits__title {
    margin-bottom: var(--s-3);
  }
  .credits__mark {
    display: flex;
    justify-content: center;
    color: var(--field-blue);
  }
  .credits__icon {
    width: min(100%, 24rem);
    height: auto;
  }
  .credits__section {
    margin-top: var(--s-6);
    max-width: 72ch;
  }
  .credits__section--wide {
    max-width: none;
  }
  @media (max-width: 47.99rem) {
    .credits__head {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .credits__icon {
      width: min(60%, 14rem);
    }
  }
  .credits__sprites {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
    --bug-body: var(--pr-green);
    --bug-eye: var(--pr-navy);
    --bug-leg: var(--pr-cyan);
  }
  .credits__icons li {
    width: 3.5rem;
  }
  .credits__sprites li {
    width: 5rem;
    display: grid;
    place-items: center;
  }
  .credits__sprites :global(.credits__sprite) {
    width: 100%;
    height: auto;
  }
  .credits__section h2 {
    font-size: 2rem;
    margin-bottom: var(--s-2);
  }
  .credits__list--photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4) var(--gap);
    margin-top: var(--s-3);
  }
  .credits__item--photo + .credits__item--photo {
    margin-top: 0;
  }
  .credits__thumb {
    aspect-ratio: 4 / 3;
    margin-bottom: var(--s-2);
  }
  @media (max-width: 47.99rem) {
    .credits__list--photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .credits__list {
    margin-top: var(--s-2);
  }
  .credits__item + .credits__item {
    margin-top: var(--s-2);
  }
</style>

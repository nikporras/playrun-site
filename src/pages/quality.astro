---
import Base from '../layouts/Base.astro';
import Bug from '../components/Bug.astro';
import PassMark from '../components/PassMark.astro';
import { spell, suite, versions } from '../data/suite';

// The names in the suite, read from the spec files at build time; the counts come from
// Playwright's own list of the suite (see src/data/suite.ts).
const specs = import.meta.glob<string>('../../tests/*.spec.ts', { query: '?raw', import: 'default', eager: true });
const suites = Object.entries(specs)
  .map(([path, src]) => {
    const file = path.split('/').pop() ?? path;
    const describe = src.match(/test\.describe\(\s*(['"`])(.*?)\1/)?.[2] ?? file;
    const tests = Array.from(src.matchAll(/\btest\(\s*(['"`])(.*?)\1/g)).map((m) => m[2].replace(/\$\{[^}]+\}/g, '…'));
    const count = suite.groups.find((g) => g.file === file)?.total ?? 0;
    return { file, describe, tests, count };
  })
  .sort((a, b) => a.file.localeCompare(b.file));

// The run that built this page: GitHub Actions builds only after the suite has passed, and hands
// the build that run's report, so the date is the run's own. Local builds carry no run.
const runDate = suite.run ? suite.run.startedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : null;

const loop = [
  ['Push', 'Every push and pull request starts the workflow on GitHub Actions.'],
  ['Install', `A clean Node ${versions.node} install and a fresh Chromium for Playwright ${versions.playwright}.`],
  ['Build and serve', 'The site is built with Astro and served exactly as it will be deployed.'],
  [`${suite.total} checks`, `${suite.files} spec files: pages, console, links, viewports, forms, the games, the bugs, selection, and axe-core on every page.`],
  ['Deploy only if green', 'A failing check stops the deploy. The live site is always a build that passed, and this page shows that run.'],
];
---

<Base title="Quality" description="How playrunqa.com is tested: a Playwright suite with axe-core runs on every push, and the site deploys only when it passes. The same rigour I bring to the games I test.">
  <!-- Level 1 -->
  <section class="level level--navy qa" data-level="1" aria-labelledby="quality-title">
    <div class="level__head">
      <p class="flag" data-load style="--d: 0ms"><span>Quality</span></p>
      <h1 id="quality-title" class="page__title">
        <span class="mask"><span class="mask__line" style="--i: 0">This site is</span></span>
        <span class="mask"><span class="mask__line" style="--i: 1">a test subject</span></span>
      </h1>
      <p class="qa__lead statement" data-load style="--d: 360ms">
        A Playwright suite runs against every push before the site can deploy. If I would not ship an untested build
        of a game, I will not ship one of my own site.
      </p>
    </div>
    <Bug id="quality-1" style="right: 12%; top: 9rem" tablet="right: 10%; bottom: 0.75rem" walk="x -2rem" />
  </section>

  <!-- Level 2: the scoreboard -->
  <section class="level level--green score" data-level="2" aria-labelledby="score-title">
    <div class="level__head">
      <p class="flag" data-enter><span>Level 2 &middot; Latest run</span></p>
      <h2 id="score-title" class="level__title" data-enter="wipe">The last run</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">
        {suite.run
          ? `${suite.passed} of ${suite.total} passed in the run that deployed this page: ${runDate}, ${spell(suite.run.seconds)}.`
          : `${suite.total} checks across ${suite.files} spec files run before every deploy.`}
      </p>
      <a class="button button--navy" href="/#selftest" data-enter style="--enter-delay: 160ms">Test the home page</a>
    </div>
    <div class="score__board level__body">
      {
        suite.groups.map((g, i) => (
          <div class="panel" style={`--enter-delay: ${i * 50}ms`} data-enter="scan">
            <p class="panel__num num">
              {suite.run ? g.passed : g.total}
              <span class="panel__of"> {suite.run ? `of ${g.total} passed` : `check${g.total === 1 ? '' : 's'}`}</span>
            </p>
            <h3 class="panel__title">{g.title}</h3>
            <p class="panel__detail">{g.detail}</p>
          </div>
        ))
      }
    </div>
    <Bug id="quality-4" style="right: 12%; top: 9rem" tablet="right: 8%; top: 8rem" walk="x -2rem" />
  </section>

  <!-- Level 3: the suite -->
  <section class="level level--blue suite" data-level="3" aria-labelledby="suite-title">
    <div class="level__head">
      <p class="flag" data-enter><span>Level 3 &middot; The suite</span></p>
      <h2 id="suite-title" class="level__title" data-enter="wipe">{suite.total} checks, read from the code</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">
        The names come from the test files and the counts from Playwright's own list, so nothing here can drift.
      </p>
    </div>
    <ul role="list" class="rows level__body">
      {
        suites.map((s, i) => (
          <li class="row suite__row" data-enter style={`--enter-delay: ${i * 70}ms`}>
            <div class="suite__name">
              <p class="row__meta">
                {s.file} <span class="row__dot" aria-hidden="true">&middot;</span> {s.count} check{s.count === 1 ? '' : 's'}
              </p>
              <h3 class="row__title">{s.describe}</h3>
            </div>
            <ul role="list" class="suite__tests">
              {s.tests.map((t) => (
                <li>
                  <PassMark class="suite__mark" />
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <Bug id="quality-2" style="right: 10%; top: 1.5rem" tablet="right: 30%; top: 0.75rem" phone="right: 1rem; bottom: 0.25rem" walk="x -2rem" />
  </section>

  <!-- Level 4: the loop -->
  <section class="level level--cyan loop" data-level="4" aria-labelledby="loop-title">
    <div class="level__head">
      <p class="flag" data-enter><span>Level 4 &middot; Every push</span></p>
      <h2 id="loop-title" class="level__title" data-enter="wipe">The loop</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">Five steps between a commit and the live site.</p>
    </div>
    <ol class="loop__track level__body">
      {
        loop.map(([step, text], i) => (
          <li class:list={['loop__step', i % 2 ? 'loop__step--light' : 'loop__step--navy']} data-enter="place" style={`--enter-delay: ${i * 50}ms`}>
            <h3 class="loop__title">{step}</h3>
            <p class="loop__text">{text}</p>
          </li>
        ))
      }
    </ol>
    <Bug id="quality-3" style="right: 12%; top: 9rem" tablet="right: 8%; top: 8rem" phone="left: 1rem; bottom: 0.25rem" walk="x -2rem" />
  </section>

  <!-- Level 5: a short way on -->
  <section class="level level--light level--tight ask" data-level="5" aria-labelledby="ask-title">
    <div class="level__head">
      <p class="flag" data-enter><span>Level 5 &middot; Next</span></p>
      <h2 id="ask-title" class="level__title level__title--small" data-enter="wipe">The same rigour, on every game</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">The games this came from, and how I test them.</p>
      <div class="level__actions" data-enter style="--enter-delay: 160ms">
        <a class="button" href="/portfolio">See the games</a>
        <a class="textlink ask__link" href="/skills">See the skills</a>
      </div>
    </div>
    <Bug id="quality-5" style="right: 12%; top: 40%" tablet="right: 8%; top: 2rem" phone="right: 1rem; top: 0.25rem" walk="y 1.5rem" />
  </section>
</Base>

<style>
  .qa {
    padding-top: var(--s-3);
  }
  .qa__lead {
    max-width: 40ch;
  }
  .level__title--small {
    font-size: var(--step-head);
    font-size: round(var(--step-head), 16px);
  }
  .ask__link {
    color: var(--pr-navy);
  }

  /* One block per spec file, three a row on the field, a rule above each. */
  .score__board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--s-4);
  }
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-3) 0 var(--s-4);
    min-width: 0;
    overflow: hidden;
    border-top: 1px solid var(--rule);
  }
  .panel__num {
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 0.9;
    max-width: none;
  }
  .panel__of {
    font-size: 1.25rem;
  }
  .panel__title {
    font-size: 1.75rem;
  }
  .panel__detail {
    font-size: 1rem;
    max-width: none;
  }

  /* Level 3: each spec file a full-width row, its name on the left and its checks on the right. */
  .suite__row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--s-5);
    align-items: start;
  }
  .suite__name {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }
  .row__dot {
    margin-inline: 0.2em;
  }
  .suite__tests {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 1rem;
  }
  .suite__tests li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  :global(.suite__mark) {
    flex: none;
    font-size: 1rem;
    color: var(--ink-2);
    margin-top: 0.3em;
  }

  /* Level 4: five steps side by side, a rule between them */
  .loop__track {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    counter-reset: step;
  }
  .loop__step {
    position: relative;
    padding: 3.5rem var(--s-2) var(--s-2) var(--s-2);
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    counter-increment: step;
    border-left: 1px solid var(--rule);
  }
  .loop__step:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .loop__step:first-child::before {
    left: 0;
  }
  .loop__step::before {
    content: counter(step);
    position: absolute;
    top: 0;
    left: var(--s-2);
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
  }
  .loop__title {
    font-size: 1.5rem;
  }
  .loop__text {
    font-size: 1rem;
  }

  @media (max-width: 63.99rem) {
    .score__board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-3);
    }
    .panel__num {
      font-size: 3rem;
    }
    .panel__title {
      font-size: 1.5rem;
    }
    .suite__row {
      grid-template-columns: 1fr;
      row-gap: var(--s-2);
    }
    .loop__track {
      grid-template-columns: 1fr;
    }
    .loop__step {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding: var(--s-3) 0 var(--s-3) 3.5rem;
    }
    .loop__step::before {
      top: var(--s-3);
      left: 0;
    }
  }
  @media (max-width: 47.99rem) {
    .score__board {
      grid-template-columns: 1fr;
    }
  }
</style>

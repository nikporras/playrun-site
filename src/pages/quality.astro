---
import ExternalLink from '../components/ExternalLink.astro';
import Base from '../layouts/Base.astro';
import Bug from '../components/Bug.astro';
import PixelTile from '../components/PixelTile.astro';
import PassMark from '../components/PassMark.astro';
import { contact, primaryAction } from '../config';
import { spell, suite, versions } from '../data/suite';

// The names in the suite, read from the spec files at build time; the counts come from
// Playwright's own list of the suite (see src/data/suite.ts).
const specs = import.meta.glob<string>('../../tests/*.spec.ts', { query: '?raw', import: 'default', eager: true });
const suites = Object.entries(specs)
  .map(([path, src]) => {
    const file = path.split('/').pop() ?? path;
    const describe = src.match(/test\.describe\(\s*(['"`])(.*?)\1/)?.[2] ?? file;
    const tests = Array.from(src.matchAll(/\btest\(\s*(['"`])(.*?)\1/g)).map((m) => m[2].replace(/\$\{[^}]+\}/g, '…'));
    const loops = Array.from(src.matchAll(/for \(const (\w+) of (\[[^\]]+\])\)/g)).map((m) => m[2]);
    const count = suite.groups.find((g) => g.file === file)?.total ?? 0;
    return { file, describe, tests, count };
  })
  .sort((a, b) => a.file.localeCompare(b.file));

// The run that built this page. GitHub Actions builds only after the suite has passed, and
// hands the build that run's report, so the date is the run's own. Local builds carry no run.
const ci = process.env.GITHUB_RUN_ID
  ? {
      date: (suite.run?.startedAt ?? new Date()).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }),
      url: `${process.env.GITHUB_SERVER_URL}/${process.env.GITHUB_REPOSITORY}/actions/runs/${process.env.GITHUB_RUN_ID}`,
    }
  : null;
const panelTones = ['navy', 'light', 'cyan'];

const loop = [
  ['Push', 'Every push and pull request starts the workflow on GitHub Actions.'],
  ['Install', `A clean Node ${versions.node} install and a fresh Chromium for Playwright ${versions.playwright}.`],
  ['Build and serve', 'The site is built with Astro and served exactly as it will be deployed.'],
  [`${suite.total} checks`, `${suite.files} spec files: pages, console, links, viewports, forms, the games, the bugs, selection, and axe-core on every page.`],
  ['Deploy only if green', 'A failing check stops the deploy. The live site is always a build that passed, and this page shows that run.'],
];
---

<Base title="Quality" description="How playrunqa.com is tested: a Playwright suite with axe-core runs on every push, and the site deploys only when it passes. The same rigour I bring to the games I test.">
  <!-- Level 1 -->
  <section class="level level--navy qa" data-level="1" aria-labelledby="quality-title">
    <p class="flag" data-load style="--d: 0ms"><span>Quality</span></p>
    <div class="qa__grid">
      <div>
        <h1 id="quality-title" class="page__title">
          <span class="mask"><span class="mask__line" style="--i: 0">This site is</span></span>
          <span class="mask"><span class="mask__line" style="--i: 1">a test subject</span></span>
        </h1>
        <p class="qa__lead statement" data-load style="--d: 360ms">
          A Playwright suite runs against every push before the site can deploy. If I would not ship an untested build
          of a game, I will not ship one of my own site.
        </p>
      </div>
      <div class="qa__photo" data-load style="--d: 200ms">
        <PixelTile name="check" tone="blue" />
      </div>
    </div>
    <Bug id="quality-1" style="right: 12%; top: 32rem" tablet="right: 10%; bottom: 1rem" walk="x 2rem" />
  </section>

  <!-- Level 2: the scoreboard -->
  <section class="level level--green score" data-level="2" aria-labelledby="score-title">
    <p class="flag" data-enter><span>Level 2 &middot; Latest run</span></p>
    <div class="level__head">
      <h2 id="score-title" class="level__title" data-enter="wipe">The last run</h2>
      <div class="level__aside" data-enter style="--enter-delay: 80ms">
        <p class="level__lead">
          {ci && suite.run ? (
            <>
              {suite.passed} of {suite.total} checks passed in <ExternalLink href={ci.url}>the run that deployed this page</ExternalLink>, on{' '}
              {ci.date}, in {spell(suite.run.seconds)}.
            </>
          ) : (
            `${suite.total} checks across ${suite.files} spec files run before every deploy.`
          )}{' '}
          The home page runs live checks on itself when you press Test this page.
        </p>
        <a class="button button--navy" href="/#selftest">Test the home page</a>
      </div>
    </div>
    <div class="score__board">
      {
        suite.groups.map((g, i) => (
          <div class:list={['panel', `panel--${panelTones[i % 3]}`]} style={`--enter-delay: ${i * 50}ms`} data-enter="scan">
            <p class="panel__num num">
              {suite.run ? g.passed : g.total}
              <span class="panel__of"> {suite.run ? `of ${g.total} passed` : `check${g.total === 1 ? '' : 's'}`}</span>
            </p>
            <h3 class="panel__title">{g.title}</h3>
            <p class="panel__detail">{g.detail}</p>
          </div>
        ))
      }
    </div>
    <Bug id="quality-4" style="left: 20%; top: 8rem" tablet="right: 10%; top: 18rem" walk="x 2rem" />
  </section>

  <!-- Level 3: the suite -->
  <section class="level level--blue suite" data-level="3" aria-labelledby="suite-title">
    <p class="flag" data-enter><span>Level 3 &middot; The suite</span></p>
    <div class="suite__grid">
      <div class="suite__intro">
        <h2 id="suite-title" class="level__title" data-enter="wipe">{suite.total} checks, read from the code</h2>
        <p class="level__lead suite__lead" data-enter style="--enter-delay: 80ms">
          The names come from the test files and the counts from Playwright's own list of the suite, both at build
          time, so nothing here can drift from what runs.
        </p>
        <div class="suite__photo" data-enter="place">
          <PixelTile name="bug" tone="navy" />
        </div>
      </div>
      <ul role="list" class="rows">
        {
          suites.map((s, i) => (
            <li class="row" data-enter style={`--enter-delay: ${i * 70}ms`}>
              <p class="row__meta">
                {s.file} <span class="row__dot" aria-hidden="true">&middot;</span> {s.count} check{s.count === 1 ? '' : 's'}
              </p>
              <h3 class="row__title">{s.describe}</h3>
              <ul role="list" class="suite__tests">
                {s.tests.map((t) => (
                  <li>
                    <PassMark class="suite__mark" />
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
    <Bug id="quality-2" style="left: 12%; top: 50%" tablet="right: 10%; top: 24rem" phone="right: 1rem; bottom: 0.25rem" walk="y 2rem" />
  </section>

  <!-- Level 4: the loop -->
  <section class="level level--cyan loop" data-level="4" aria-labelledby="loop-title">
    <p class="flag" data-enter><span>Level 4 &middot; Every push</span></p>
    <div class="level__head">
      <h2 id="loop-title" class="level__title" data-enter="wipe">The loop</h2>
      <div class="level__aside" data-enter style="--enter-delay: 80ms">
        <p class="level__lead">Five steps between a commit and the live site.</p>
      </div>
    </div>
    <ol class="loop__track">
      {
        loop.map(([step, text], i) => (
          <li class:list={['loop__step', i % 2 ? 'loop__step--light' : 'loop__step--navy']} data-enter="place" style={`--enter-delay: ${i * 50}ms`}>
            <h3 class="loop__title">{step}</h3>
            <p class="loop__text">{text}</p>
          </li>
        ))
      }
    </ol>
    <Bug id="quality-3" style="left: 35%; bottom: 1rem" phone="left: 1rem; bottom: 0.25rem" walk="x 2rem" />
  </section>

  <!-- Level 5 -->
  <section class="level level--light ask" data-level="5" aria-labelledby="ask-title">
    <p class="flag" data-enter><span>Level 5 &middot; Final level</span></p>
    <h2 id="ask-title" class="level__title" data-enter="wipe">
      <span class="mask__line">The same rigour,</span>
      <span class="mask__line">on every game</span>
    </h2>
    <div class="ask__actions" data-enter style="--enter-delay: 80ms">
      <a class="button" href={primaryAction.href}>{primaryAction.label}</a>
      <a class="ask__mail" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
    <Bug id="quality-5" style="left: 50%; top: 24rem" tablet="right: 10%; top: 22rem" phone="right: 1rem; bottom: 0.25rem" walk="x 2rem" />
  </section>
</Base>

<style>
  .qa {
    padding-top: var(--s-2);
  }
  .qa__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-5);
    align-items: end;
    margin-top: var(--s-5);
  }
  .qa__lead {
    margin-top: var(--s-4);
    max-width: 40ch;
  }
  .qa__photo {
    min-height: 24rem;
  }

  /* One panel per spec file, three a row; a lone last panel spans the row, a pair splits it. */
  .score__board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(14rem, auto);
    gap: var(--gap);
    margin-top: var(--s-5);
  }
  .panel {
    grid-column: span 4;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-3);
    min-width: 0;
    overflow: hidden;
  }
  .panel--navy {
    background: var(--bg);
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
    color: var(--ink);
  }
  .panel--light {
    background: var(--field-light);
    color: var(--field-light-ink);
  }
  .panel--cyan {
    background: var(--field-cyan);
    color: var(--field-cyan-ink);
  }
  .panel--light,
  .panel--cyan {
    --sel-bg: var(--pr-navy);
    --sel-ink: var(--pr-light);
  }
  .panel:last-child:nth-child(3n + 1) {
    grid-column: span 12;
  }
  .panel:nth-last-child(2):nth-child(3n + 1),
  .panel:last-child:nth-child(3n + 2) {
    grid-column: span 6;
  }
  .panel__mark {
    font-size: 2.5rem;
    line-height: 0;
    color: var(--accent);
  }
  .panel--light .panel__mark,
  .panel--cyan .panel__mark {
    color: var(--pr-navy);
  }
  .panel__num {
    margin-top: auto;
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 0.9;
    max-width: none;
  }
  .panel__of {
    font-size: 1.25rem;
    color: var(--muted);
  }
  .panel--light .panel__of,
  .panel--cyan .panel__of {
    color: inherit;
  }
  .panel__title {
    font-size: 1.75rem;
  }
  .panel__detail {
    font-size: 1rem;
    color: var(--muted);
    max-width: none;
  }
  .panel--light .panel__detail,
  .panel--cyan .panel__detail {
    color: inherit;
  }

  .suite__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-5);
    align-items: start;
    margin-top: var(--s-5);
  }
  .suite__intro {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    color: var(--pr-navy);
  }
  .suite__photo {
    aspect-ratio: 4 / 3;
  }
  .suite__lead {
    color: var(--pr-navy);
  }
  .row__dot {
    margin-inline: 0.2em;
  }
  .suite__tests {
    margin-top: var(--s-2);
    font-size: 1rem;
  }
  .suite__tests li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .suite__tests li + li {
    margin-top: 0.4em;
  }
  .suite__tests :global(.suite__mark) {
    flex: none;
    font-size: 1rem;
    color: var(--accent);
    margin-top: 0.3em;
  }

  .loop__track {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--gap);
    counter-reset: step;
  }
  .loop__step {
    position: relative;
    min-height: 16rem;
    padding: 4rem var(--s-2) var(--s-3);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-1);
    counter-increment: step;
  }
  .loop__step--navy {
    background: var(--bg);
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
    color: var(--ink);
  }
  .loop__step--light {
    background: var(--field-light);
    color: var(--field-light-ink);
    --sel-bg: var(--pr-navy);
    --sel-ink: var(--pr-light);
  }
  .loop__step::before {
    content: counter(step);
    position: absolute;
    top: var(--s-2);
    left: var(--s-2);
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--accent-2);
  }
  .loop__step--light::before {
    color: var(--pr-blue);
  }
  .loop__title {
    font-size: 1.75rem;
  }
  .loop__text {
    font-size: 1rem;
  }
  .loop__step--navy .loop__text {
    color: var(--muted);
  }
  .loop__photo {
    margin-top: var(--gap);
    height: 16rem;
  }

  .ask__actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-5);
  }
  .ask__actions .button {
    font-size: 1.5rem;
    min-height: 3.5rem;
    padding-inline: 2rem;
  }
  .ask__mail {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--pr-navy);
  }

  @media (max-width: 63.99rem) {
    .qa__grid,
    .suite__grid {
      grid-template-columns: 1fr;
      gap: var(--s-4);
      margin-top: var(--s-4);
    }
    .qa__photo {
      min-height: 0;
      aspect-ratio: 4 / 3;
      order: -1;
    }
    .score__board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
      gap: 0.375rem;
    }
    .panel,
    .panel:last-child:nth-child(3n + 1),
    .panel:nth-last-child(2):nth-child(3n + 1),
    .panel:last-child:nth-child(3n + 2) {
      grid-column: span 1;
      min-height: 12rem;
      padding: var(--s-2);
    }
    .panel:last-child:nth-child(odd) {
      grid-column: span 2;
    }
    .panel__num {
      font-size: 3rem;
    }
    .panel__title {
      font-size: 1.5rem;
    }
    .loop__track {
      grid-template-columns: 1fr 1fr;
      gap: 0.375rem;
    }
    .loop__step {
      min-height: 12rem;
    }
    .loop__photo {
      height: 12rem;
    }
  }
  @media (max-width: 47.99rem) {
    .loop__track {
      grid-template-columns: 1fr;
    }
  }
</style>

---
/**
 * The Quality page is called Testing now, at /testing/. This address stays as a small page that
 * sends visitors and old links there at once: a script first, the meta refresh where script is off,
 * a link to press. It points search engines at /testing/ (canonical) and is never indexed itself;
 * the sitemap leaves it out (astro.config.mjs).
 */
import { site } from '../config';

const to = '/testing/';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Testing | Nicolás Porras</title>
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={`${site.url}/testing/`} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <meta name="theme-color" content={site.themeColor} />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1.25rem;
        background: #0c152a;
        color: #e5e7ea;
        font: 1.125rem/1.5 system-ui, sans-serif;
      }
      a {
        color: #56bdda;
      }
    </style>
  </head>
  <body>
    <p>This page is now called Testing. <a href={to}>Go to Testing</a></p>
    <script>
      location.replace('/testing/');
    </script>
  </body>
</html>

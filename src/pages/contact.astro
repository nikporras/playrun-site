---
import Base from '../layouts/Base.astro';
import Bug from '../components/Bug.astro';
import PassMark from '../components/PassMark.astro';
import PixelTile from '../components/PixelTile.astro';
import { contact, contactEndpoint } from '../config';

// With script, the form posts a JSON string to the Apps Script endpoint. Without script it opens
// the visitor's mail app with the message written out, so nothing is lost either way.
const action = `mailto:${contact.email}`;

const reasons = ['A hello from another tester', 'A question about how I test', 'An opportunity you think fits', 'A game we have both played', 'Feedback on this site'];

const steps = [
  { title: 'I read it', text: 'Every message lands in my own inbox, and I read all of them.' },
  { title: 'I reply', text: 'From studio@playrunqa.com, so look out for that address.' },
  { title: 'We talk', text: 'Email, a call, or a coffee if you are in London.' },
];
---

<Base title="Contact" description="Get in touch with Nicolás Porras of PlayRun in London: networking, opportunities, a question about game QA, or just to say hello.">
  <!-- Level 1: the ask -->
  <section class="level level--navy contact" data-level="1" aria-labelledby="contact-title">
    <p class="flag" data-load style="--d: 0ms"><span>Contact</span></p>
    <div class="contact__grid">
      <div class="contact__text">
        <h1 id="contact-title" class="contact__title">
          <span class="hero__mask"><span class="hero__line" style="--i: 0">Get in</span></span>
          <span class="hero__mask"><span class="hero__line" style="--i: 1">touch</span></span>
        </h1>
        <p class="contact__lead statement" data-load style="--d: 360ms">
          Networking, opportunities, a question about QA, or just hello. I read every message.
        </p>
      </div>
      <div class="contact__side">
      <div class="contact__photo" data-load style="--d: 200ms">
        <PixelTile name="ship" tone="blue" />
      </div>
      <ul role="list" class="contact__direct" data-load style="--d: 480ms">
        <li>
          <span class="contact__key">Email</span>
          <a class="contact__big" href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
        <li>
          <span class="contact__key">Based in</span>
          <span class="contact__big">{contact.location}</span>
        </li>
      </ul>
      </div>
    </div>
    <Bug id="contact-1" style="left: 30%; top: 9rem" tablet="right: 1.5rem; top: 24rem" walk="x 2rem" />
  </section>

  <!-- Level 2: the message, a form on a blue field -->
  <section class="level level--blue msg" data-level="2" aria-labelledby="message-title">
    <p class="flag" data-enter><span>Level 2 &middot; The message</span></p>
    <div class="msg__grid">
      <div class="msg__intro">
        <h2 id="message-title" class="level__title" data-enter="wipe">Write to me</h2>
        <ul role="list" class="msg__list" data-enter style="--enter-delay: 80ms">
          {reasons.map((r) => <li>{r}</li>)}
        </ul>
        <div class="msg__photo" data-enter="place">
          <PixelTile name="bug" tone="navy" />
        </div>
      </div>
      <form
        class="form"
        action={action}
        method="post"
        enctype="text/plain"
        novalidate
        data-endpoint={contactEndpoint}
        data-enter="place"
        aria-describedby="form-note"
      >
        <div class="form__row">
          <label class="form__label" for="f-name">Your name</label>
          <input class="form__input" id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="e-name" />
          <p class="form__error" id="e-name" hidden>Tell me who to reply to.</p>
        </div>
        <div class="form__row">
          <label class="form__label" for="f-email">Your email</label>
          <input class="form__input" id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="e-email" />
          <p class="form__error" id="e-email" hidden>I need a working email address to reply to.</p>
        </div>
        <div class="form__row">
          <label class="form__label" for="f-message">Your message</label>
          <textarea class="form__input form__input--area" id="f-message" name="message" rows="7" required aria-describedby="e-message"
          ></textarea>
          <p class="form__error" id="e-message" hidden>A line or two is enough.</p>
        </div>
        <div class="form__trap" aria-hidden="true">
          <label for="f-website">Website</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="form__actions">
          <button class="button" type="submit">Send the message</button>
          <p class="form__status" id="form-status" role="status" aria-live="polite"></p>
        </div>
        <p class="form__fallback" id="form-fallback" hidden>
          <a class="textlink" data-fallback-link href={action}>Email me instead</a>
        </p>
        <p class="form__note small" id="form-note" data-note-js="It comes straight to me. I reply from studio@playrunqa.com.">
          This opens your mail app with the message written out, addressed to studio@playrunqa.com.
        </p>
        <p class="form__note small">
          I'll only use these details to reply to your message. See the <a href="/privacy">privacy notice</a>.
        </p>
      </form>
    </div>
    <Bug id="contact-2" style="right: 15%; bottom: 1rem" phone="left: 1rem; bottom: 0.25rem" walk="x -2rem" />
  </section>

  <!-- Level 3: what happens next, three panels on green -->
  <section class="level level--green next" data-level="3" aria-labelledby="next-title">
    <p class="flag" data-enter><span>Level 3 &middot; What happens next</span></p>
    <h2 id="next-title" class="level__title" data-enter="wipe">Then</h2>
    <ol class="next__steps">
      {
        steps.map((s, i) => (
          <li class:list={['next__step', i === 1 ? 'next__step--light' : 'next__step--navy']} data-enter="place" style={`--enter-delay: ${i * 70}ms`}>
            <PassMark class="next__mark" />
            <h3 class="next__title">{s.title}</h3>
            <p class="next__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
    <Bug id="contact-3" style="left: 60%; top: 0.25rem" walk="x -2rem" />
  </section>
</Base>

<style>
  /* Level 1 */
  .contact {
    padding-top: var(--s-2);
    padding-bottom: var(--s-7);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-5);
    align-items: end;
    margin-top: var(--s-5);
  }
  .contact__title {
    font-size: var(--step-hero);
    font-size: round(var(--step-hero), 16px);
    line-height: 0.9;
    margin-left: -0.03em;
    text-wrap: initial;
  }
  .hero__mask {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero__line {
    display: block;
  }
  .contact__lead {
    margin-top: var(--s-4);
    max-width: 36ch;
  }
  .contact__side {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    min-width: 0;
  }
  .contact__photo {
    aspect-ratio: 4 / 3;
  }
  .contact__direct {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-width: 0;
  }
  .contact__key {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin-bottom: 0.25rem;
  }
  .contact__big {
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 1.1;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  a.contact__big {
    text-decoration-color: var(--accent-2);
  }
  a.contact__big:hover {
    color: var(--accent-2);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero__line {
      transform: translateY(105%);
      animation: boot-line var(--dur-reveal) var(--ease-expo) forwards;
      animation-delay: calc(120ms + var(--i) * 110ms);
    }
    :global(.js) .contact [data-load] {
      animation: load-rise 500ms var(--ease-out) both;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes boot-line {
    to {
      transform: none;
    }
  }
  @keyframes load-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Level 2: the form */
  .level__title {
    font-size: var(--step-level);
    font-size: round(var(--step-level), 16px);
    line-height: 0.92;
    text-wrap: initial;
    margin-left: -0.03em;
  }
  .msg__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-5);
    align-items: start;
    margin-top: var(--s-5);
  }
  .msg__intro {
    position: sticky;
    top: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    color: var(--pr-navy);
  }
  .msg__list {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.2;
  }
  .msg__list li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }
  .msg__list li::before {
    content: '';
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--pr-navy);
    transform: translateY(-0.1em);
  }
  .msg__list li + li {
    margin-top: 0.4em;
  }
  .msg__photo {
    aspect-ratio: 4 / 3;
  }
  .form {
    background: var(--bg);
    color: var(--ink);
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .form__row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .form__label {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
  }
  .form__optional {
    color: var(--muted);
    font-size: 1rem;
    margin-left: 0.5em;
  }
  .form__input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    background: var(--surface-2);
    color: var(--ink);
    border: 2px solid var(--surface-2);
    font: inherit;
    font-size: var(--step-body);
    border-radius: 0;
    transition: border-color var(--dur-fast) ease;
  }
  .form__input:hover {
    border-color: var(--pr-blue);
  }
  .form__input:focus-visible {
    outline: 3px solid var(--accent-2);
    outline-offset: 2px;
    border-color: var(--accent-2);
  }
  .form__input[aria-invalid='true'] {
    border-color: var(--accent-2);
  }
  .form__input--area {
    resize: vertical;
    min-height: 10rem;
  }
  .form__error {
    font-size: 1rem;
    color: var(--accent-2);
    max-width: none;
  }
  .form__error[hidden] {
    display: none;
  }
  .form__actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-1);
  }
  .form__actions .button {
    font-size: 1.5rem;
    min-height: 3.5rem;
    padding-inline: 2rem;
  }
  .form__status {
    font-family: var(--font-display);
    font-size: 1.25rem;
    max-width: none;
  }
  .form__status:empty {
    display: none;
  }
  .form__note {
    color: var(--muted);
    max-width: none;
  }
  /* The honeypot: a field no person sees or hears. Hidden by the stylesheet, not inline, so a
     script that fills every text input still finds it. */
  .form__trap {
    display: none;
  }
  .form {
    position: relative;
  }
  .form__fallback {
    max-width: none;
  }
  .form__fallback[hidden] {
    display: none;
  }
  .form.is-sent .form__row,
  .form.is-sent .form__actions .button {
    display: none;
  }

  /* Level 3 */
  .next__steps {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 3fr 5fr 4fr;
    gap: var(--gap);
    counter-reset: step;
  }
  .next__step {
    position: relative;
    min-height: 18rem;
    padding: var(--s-3);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-1);
    counter-increment: step;
  }
  .next__step--navy {
    background: var(--bg);
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
    color: var(--ink);
  }
  .next__step--light {
    background: var(--field-light);
    color: var(--field-light-ink);
    --sel-bg: var(--pr-navy);
    --sel-ink: var(--pr-light);
  }
  .next__step::before {
    content: counter(step);
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: var(--accent-2);
  }
  .next__step--light::before {
    color: var(--pr-blue);
  }
  .next__step :global(.next__mark) {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    font-size: 2rem;
    color: var(--accent);
  }
  .next__step--light :global(.next__mark) {
    color: var(--pr-navy);
  }
  .next__title {
    font-size: 2rem;
  }
  .next__text {
    font-size: 1rem;
    max-width: 38ch;
  }
  .next__step--navy .next__text {
    color: var(--muted);
  }
  .next__photos {
    display: grid;
    grid-template-columns: 8fr 4fr;
    gap: var(--gap);
    margin-top: var(--gap);
    height: 18rem;
  }
  .next__photo {
    min-width: 0;
    min-height: 0;
  }

  @media (max-width: 63.99rem) {
    .contact {
      padding-bottom: var(--s-6);
    }
    .contact__grid,
    .msg__grid {
      grid-template-columns: 1fr;
      gap: var(--s-5);
      margin-top: var(--s-4);
    }
    .contact__title {
      font-size: round(19vw, 8px);
    }
    .contact__big {
      font-size: 1.5rem;
    }
    .level__title {
      font-size: round(15vw, 8px);
    }
    .msg__intro {
      position: static;
    }
    .msg__list {
      font-size: 1.5rem;
    }
    .form {
      padding: var(--s-3) var(--s-2);
    }
    .form__actions .button {
      width: 100%;
    }
    .next__steps {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
    .next__photos {
      grid-template-columns: 1fr 1fr;
      height: auto;
      gap: 0.375rem;
    }
    .next__photo {
      aspect-ratio: 1;
    }
    .next__step {
      min-height: 13rem;
      padding: 4.5rem var(--s-2) var(--s-3);
    }
    .next__step::before,
    .next__step :global(.next__mark) {
      top: var(--s-2);
    }
    .next__step::before {
      left: var(--s-2);
      font-size: 2rem;
    }
    .next__step :global(.next__mark) {
      right: var(--s-2);
    }
  }
</style>

<script>
  // The form: checks each field before anything leaves the page and names what is missing beside
  // the field. With script it posts a JSON string to the Apps Script endpoint (a text/plain body,
  // so no preflight) and reads {ok} back. Without script the browser opens the mail app.
  const form = document.querySelector<HTMLFormElement>('.form');
  const status = document.getElementById('form-status');
  const fallback = document.getElementById('form-fallback');
  const note = document.getElementById('form-note');
  if (form && status && fallback && note) {
    const endpoint = form.dataset.endpoint || '';
    const startedAt = Date.now();
    note.textContent = note.dataset.noteJs || note.textContent;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]'));
    const errorOf = (f: HTMLElement) => document.getElementById(f.getAttribute('aria-describedby') || '');
    const mark = (f: HTMLInputElement | HTMLTextAreaElement, ok: boolean) => {
      f.setAttribute('aria-invalid', String(!ok));
      const err = errorOf(f);
      if (err) err.hidden = ok;
    };
    const check = (f: HTMLInputElement | HTMLTextAreaElement) => {
      const ok = f.checkValidity();
      mark(f, ok);
      return ok;
    };
    fields.forEach((f) => f.addEventListener('input', () => f.getAttribute('aria-invalid') === 'true' && check(f)));
    const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null)?.value ?? '';
    const offerMail = () => {
      const link = fallback.querySelector<HTMLAnchorElement>('[data-fallback-link]');
      if (link) {
        const subject = encodeURIComponent('Hello from playrunqa.com');
        const body = encodeURIComponent(value('name') + ' (' + value('email') + ')\n\n' + value('message'));
        link.href = form.action + '?subject=' + subject + '&body=' + body;
      }
      fallback.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      const bad = fields.filter((f) => !check(f));
      if (bad.length) {
        e.preventDefault();
        status.textContent = bad.length === 1 ? 'One field needs a look.' : bad.length + ' fields need a look.';
        bad[0].focus();
        return;
      }
      if (!endpoint) {
        status.textContent = 'Opening your mail app with the message.';
        return; // the browser carries on with the mailto: action
      }
      e.preventDefault();
      fallback.hidden = true;
      status.textContent = 'Sending';
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({
            name: value('name'),
            email: value('email'),
            brief: value('message'),
            page: location.pathname,
            startedAt,
            website: value('website'),
          }),
        });
        const data = (await res.json()) as { ok: boolean; errors?: string[] };
        if (data.ok) {
          form.classList.add('is-sent');
          status.textContent = 'Sent. I reply from studio@playrunqa.com.';
          return;
        }
        const errors = data.errors ?? ['server'];
        // The script still calls the message field 'brief'.
        const fieldErrors = fields.filter((f) => errors.includes(f.name === 'message' ? 'brief' : f.name));
        if (fieldErrors.length) {
          fieldErrors.forEach((f) => mark(f, false));
          status.textContent = fieldErrors.length === 1 ? 'One field needs a look.' : fieldErrors.length + ' fields need a look.';
          fieldErrors[0].focus();
        } else if (errors.includes('rate_limited')) {
          status.textContent = "You've just sent a message, give it a minute.";
        } else {
          throw new Error(errors.join(','));
        }
      } catch {
        status.textContent = 'That did not send. Email me at studio@playrunqa.com and I will pick it up.';
        offerMail();
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>

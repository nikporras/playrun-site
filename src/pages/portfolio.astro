---
import { inWords } from '../data/words';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bug from '../components/Bug.astro';
import GameCard from '../components/GameCard.astro';
import Join from '../components/Join.astro';
import { employers, since } from '../config';
import { trackerIds } from '../data/ids';

const all = await getCollection('projects');
// Released titles newest first, titles in development last.
const shown = (import.meta.env.DEV ? all : all.filter((p) => p.data.public)).sort((a, b) => {
  const aDev = a.data.status === 'in-development' ? 1 : 0;
  const bDev = b.data.status === 'in-development' ? 1 : 0;
  return aDev - bDev || (b.data.year ?? 0) - (a.data.year ?? 0);
});
// Each game's tracker ID (PR-001...), stable from the data.
const ids = trackerIds(shown);
// One group per post with public games, in the order of `employers` (newest first). A post that
// was not game QA (`games: false`) or has no public titles is listed under Other roles instead.
const posts = employers.map((e) => ({ ...e, projects: shown.filter((p) => p.data.employer === e.id) }));
const groups = posts.filter((e) => e.games !== false && e.projects.length > 0);
const others = posts.filter((e) => !groups.includes(e));
const count = shown.length;
// (the companies the games were tested at)
const companies = new Set(groups.map((e) => e.name)).size;
// The whole span of a post, from the start of its first role to the end of its last (in the name
// of its list of games).
const span = (g: (typeof groups)[number]) => {
  const first = g.roles[0].when.split(' to ')[0];
  const last = g.roles[g.roles.length - 1].when.split(' to ').pop();
  return `${first} to ${last}`;
};
// The year a post began, for the track: the earliest year in its dates.
const yearOf = (g: (typeof groups)[number]) => Math.min(...g.roles.flatMap((r) => (r.when.match(/\b(20\d\d)\b/g) ?? []).map(Number)));
---

<Base
  title="Games"
  fullTitle="Games I've tested, QA portfolio | Nicolás Porras"
  description={`The ${count} games Nicolás Porras has tested since ${since}, from Cyberpunk 2077 and NBA 2K21 to VR titles at nDreams and Historic VR, with his part in each.`}
>
  <!-- Level 1 -->
  <section class="level level--navy level--sky has-join-bottom work" data-level="1" aria-labelledby="work-title">
    <div class="level__head">
      <p class="flag" data-nosnippet data-load style="--d: 0ms"><span>Games</span></p>
      <h1 id="work-title" class="page__title">
        <span class="mask"><span class="mask__line" style="--i: 0">Games I've</span></span>{' '}
        <span class="mask"><span class="mask__line" style="--i: 1">tested</span></span>
      </h1>
      <p class="work__lead statement" data-load style="--d: 360ms">
        {inWords(count)} titles across {inWords(companies).toLowerCase()} companies, from where I started in 2021 to the latest releases.
      </p>
    </div>
    <Join kind="clouds" from="var(--pr-navy)" to="var(--field-cyan)" seed="portfolio-titles" />
    <Bug id="portfolio-1" style="right: 12%; top: 9rem" tablet="right: var(--gutter); top: 6rem" walk="x -2rem" />
    <Bug id="portfolio-4" style="right: 30%; bottom: calc(var(--join-h) + 1rem)" tablet="left: 45%; bottom: calc(var(--join-h) + 0.75rem)" phone="left: var(--gutter); bottom: calc(var(--join-h) + 0.75rem)" walk="x 2rem" />
  </section>

  <!-- Level 2: every post, newest first, with its titles -->
  <section class="level level--cyan has-join-bottom titles" data-level="2" aria-labelledby="titles-title">
    <Join kind="terrain" from="var(--field-cyan)" to="var(--pr-navy)" seed="portfolio-next" />
    <div class="level__head">
      <p class="flag" data-nosnippet data-enter><span>Level 2 &middot; By company</span></p>
      <h2 id="titles-title" class="level__title" data-enter="wipe">Games I've tested, by studio</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">Newest first, with what I did on each one.</p>
    </div>
    <div class="level__body">
      {
        groups.map((g, gi) => (
          <div class="group" role="group" aria-labelledby={`group-${gi}`} data-year={yearOf(g)}>
            <div class="group__head" data-enter>
              <h3 id={`group-${gi}`} class="group__name">{g.name}</h3>
              <div class="group__about">
                <ol role="list" class="group__roles">
                  {g.roles.map((r) => (
                    <li class="group__role">
                      <span class="group__title">{r.title}</span> <span class="group__dot" aria-hidden="true">&middot;</span> <span class="group__dates">{r.when}</span>
                    </li>
                  ))}
                </ol>
                <p class="group__lead">{g.lead}</p>
                <p class="group__count">{g.projects.length} {g.projects.length === 1 ? 'game' : 'games'}</p>
              </div>
            </div>
            {g.projects.length > 0 && (
              <div class="group__row" role="region" aria-label={`${g.name} games, ${span(g)}`}>
                <ul role="list" class="group__grid">
                  {g.projects.map((p, i) => (
                    <li class="group__cell">
                      <GameCard project={p} via={g.via} delay={i * 60} scan trackerId={ids.get(p.id)} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
      {
        others.length > 0 && (
          <div class="others" data-enter>
            <h3 class="others__title">Other roles</h3>
            <ul role="list" class="others__list">
              {others.map((e) => (
                <li class="others__item">
                  <h4 class="others__name">{e.name}</h4>
                  {e.roles.map((r) => (
                    <p class="others__role">
                      <span class="group__title">{r.title}</span> <span class="group__dot" aria-hidden="true">&middot;</span> <span class="group__dates">{r.when}</span>
                    </p>
                  ))}
                  <p class="others__lead">{e.lead}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
    <Bug id="portfolio-2" style="right: 10%; bottom: calc(var(--join-h) + 0.75rem)" walk="x -2rem" />
    <Bug id="portfolio-3" style="right: 8%; top: 1.5rem" tablet="left: 45%; top: 0.75rem" phone="left: 1rem; bottom: calc(var(--join-h) + 0.25rem)" walk="x -2rem" />
  </section>

</Base>

<style>
  .work {
    padding-top: var(--s-3);
  }
  /* (a strip at the foot of each level, above its join, where the bugs walk clear of the text:
     portfolio-4 under the intro, portfolio-2 and portfolio-3 under Other roles) */
  .work.has-join-bottom,
  .titles.has-join-bottom {
    padding-bottom: calc(var(--s-5) + var(--join-h) + 3.5rem);
  }
  .work__lead {
    max-width: 40ch;
  }

  /* Each post: a plain header like a career entry (the company, each role with its dates, the line
     on the post, the number of games), then its titles. */
  .group + .group {
    margin-top: var(--s-6);
  }
  .group__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--s-5);
    row-gap: var(--s-2);
    align-items: start;
    padding: var(--s-4) 0;
    border-top: 1px solid var(--rule);
    position: relative;
  }
  .group__name {
    font-size: var(--step-head);
    font-size: round(var(--step-head), 16px);
    line-height: 0.95;
    margin-left: -0.03em;
  }
  .group__about {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }
  /* each role on a line of its own, "title · dates" (Other roles) */
  .others__role {
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.45;
    max-width: none;
  }
  /* The roles in a company header: a compact list, oldest at the top, the dates in a column of
     their own; the same hollow pixel marker per role on a thin line, so a post with several roles
     reads as steps. Every role looks the same. */
  .group__roles {
    position: relative;
    max-width: none;
    font-size: 1.0625rem;
    line-height: 1.45;
  }
  .group__roles:has(> li + li)::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 1.1rem;
    bottom: 1.1rem;
    width: 2px;
    background: currentColor;
    opacity: 0.45;
  }
  .group__role {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12.5rem;
    column-gap: var(--s-2);
    align-items: baseline;
    padding: 0.3rem 0 0.3rem 1.75rem;
  }
  .group__role::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(0.3rem + 0.725em - 5px);
    width: 10px;
    height: 10px;
    box-sizing: border-box;
    border: 2px solid currentColor;
    background: var(--level-bg);
  }
  .group__title {
    font-weight: 400;
  }
  /* (the dot is for the text only: the dates stand in their own column) */
  .group__dot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* (a role's dates stay on one line) */
  .group__dates {
    white-space: nowrap;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
  /* the description under the roles: body text, lighter, with room above it */
  .group__lead {
    margin-top: var(--s-2);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    max-width: 34em;
    color: inherit; /* (where color-mix is missing) */
    color: color-mix(in srgb, currentColor 82%, var(--level-bg));
  }
  .group__count {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    max-width: none;
  }
  /* Other roles: the posts with no public games, newest first, plain and compact under the games. */
  .others {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }
  .others__title {
    font-size: var(--step-head);
    font-size: round(var(--step-head), 16px);
    line-height: 0.95;
  }
  .others__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3) var(--gap);
    margin-top: var(--s-3);
  }
  .others__item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .others__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.1;
  }
  .others__role {
    font-size: 1rem;
  }
  .others__lead {
    font-size: 0.9375rem;
    max-width: 34em;
  }
  /* The cards are a list at every width. On a desktop, three a row on a six-column grid, so the
     last row always fills: a lone last tile spans the row, a pair splits it. */
  .group__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--gap);
    margin: var(--gap) 0 0;
    padding: 0;
  }
  .group__cell {
    display: grid;
    min-width: 0;
    grid-column: span 2;
  }
  .group__cell:last-child:nth-child(3n + 1) {
    grid-column: span 6;
  }
  .group__cell:nth-last-child(2):nth-child(3n + 1),
  .group__cell:last-child:nth-child(3n + 2) {
    grid-column: span 3;
  }

  /* On phones each role is two lines: the title a step smaller, then the dates under it, smaller
     and lighter, no dot. From 48rem title and dates share a line with the dot between. */
  @media (max-width: 47.99rem) {
    .group__roles,
    .others__role {
      font-size: 0.9375rem;
      line-height: 1.35;
    }
    .others__role + .others__role {
      margin-top: 0.5rem;
    }
    /* each role two lines, the title then the dates */
    .group__role {
      display: block;
      padding: 0.35rem 0 0.35rem 1.25rem;
    }
    .group__role::before {
      top: calc(0.35rem + 0.675em - 5px);
    }
    .group__roles:has(> li + li)::before {
      top: 1rem;
      bottom: 1.6rem;
    }
    .group__title,
    .group__dates {
      display: block;
    }
    .group__dot {
      display: none;
    }
    .group__dates {
      margin-top: 0.1rem;
      font-size: 0.875rem;
      font-weight: 400;
      color: var(--muted-2, var(--muted));
    }
  }
  @media (max-width: 63.99rem) {
    .group + .group {
      margin-top: var(--s-5);
    }
    .group__head {
      grid-template-columns: 1fr;
      padding: var(--s-3) 0;
    }
    .others {
      margin-top: var(--s-5);
    }
    .others__list {
      grid-template-columns: 1fr;
    }
    .group__grid {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
    .group__cell,
    .group__cell:last-child:nth-child(3n + 1),
    .group__cell:nth-last-child(2):nth-child(3n + 1),
    .group__cell:last-child:nth-child(3n + 2) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/motion';
  // The folded list below 64rem: each company's cards are rows, all folded to begin with. A tap on a
  // row opens its card (height and opacity) and a second tap folds it; any number can be open. Once
  // open, a card that runs off the screen is brought into view, and the games script is told to
  // look at it (the scan plays on an open card only). As a company's list comes on screen its rows
  // slide in one after another (the stagger is each card's --enter-delay); on a desktop the cards
  // keep their own entrance, each as it enters.
  const narrow = matchMedia('(max-width: 63.99rem)');
  const OPEN_MS = 280;
  const lists = Array.from(document.querySelectorAll<HTMLElement>('.group__grid'));
  lists.forEach((list) => {
    list.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
      const button = card.querySelector<HTMLButtonElement>('[data-card-toggle]')!;
      button.addEventListener('click', () => {
        const opening = !card.classList.contains('is-open');
        card.classList.toggle('is-open', opening);
        button.setAttribute('aria-expanded', String(opening));
        if (!opening || !narrow.matches) return;
        const still = reducedMotion();
        setTimeout(() => {
          const r = card.getBoundingClientRect();
          const room = innerHeight - (parseFloat(getComputedStyle(document.body).paddingBottom) || 0);
          if (r.bottom > room) scrollBy({ top: Math.min(r.bottom - room + 8, r.top - 16), behavior: still ? 'instant' : 'smooth' });
          document.dispatchEvent(new CustomEvent('playrun:cardopen'));
        }, still ? 0 : OPEN_MS);
      });
    });
  });
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting || !narrow.matches) continue;
          e.target.querySelectorAll('[data-card]').forEach((c) => c.classList.add('is-in'));
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0 },
    );
    lists.forEach((l) => io.observe(l));
  }
</script>

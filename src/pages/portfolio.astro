---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bug from '../components/Bug.astro';
import GameCard from '../components/GameCard.astro';
import { employers } from '../config';

const all = await getCollection('projects');
// Released titles newest first, titles in development last.
const shown = (import.meta.env.DEV ? all : all.filter((p) => p.data.public)).sort((a, b) => {
  const aDev = a.data.status === 'in-development' ? 1 : 0;
  const bDev = b.data.status === 'in-development' ? 1 : 0;
  return aDev - bDev || (b.data.year ?? 0) - (a.data.year ?? 0);
});
// One group per post, in the order of `employers`; a post with no public titles keeps its header.
const groups = employers.map((e) => ({ ...e, projects: shown.filter((p) => p.data.employer === e.id) }));
const count = shown.length;
const companies = new Set(employers.map((e) => e.name)).size;
const words = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen', 'Twenty', 'Twenty-one', 'Twenty-two', 'Twenty-three', 'Twenty-four'];
const role = (r: { title: string; contract?: boolean }) => (r.contract ? `${r.title}, contract` : r.title);
// The whole span of a post, from the start of its first role to the end of its last: the big date
// under the company name. A post with several roles keeps each role's own dates on its line.
const span = (g: (typeof groups)[number]) => {
  const first = g.roles[0].when.split(' to ')[0];
  const last = g.roles[g.roles.length - 1].when.split(' to ').pop();
  return `${first} to ${last}`;
};
// The year a post began, for the track: the earliest year in its dates.
const yearOf = (g: (typeof groups)[number]) => Math.min(...g.roles.flatMap((r) => (r.when.match(/\b(20\d\d)\b/g) ?? []).map(Number)));
---

<Base title="Portfolio" description="Games Nicolás Porras has tested, by company: the Megabit titles at Aonic, Guildford Castle VR and Londinium at Historic VR, the nDreams VR titles, and Cyberpunk 2077, NBA 2K21 and the VR titles via Universally Speaking.">
  <!-- Level 1 -->
  <section class="level level--navy work" data-level="1" aria-labelledby="work-title">
    <div class="level__head">
      <p class="flag" data-load style="--d: 0ms"><span>Portfolio</span></p>
      <h1 id="work-title" class="page__title">
        <span class="mask"><span class="mask__line" style="--i: 0">Games I've</span></span>
        <span class="mask"><span class="mask__line" style="--i: 1">tested</span></span>
      </h1>
      <p class="work__lead statement" data-load style="--d: 360ms">
        {words[count] ?? count} titles across {words[companies]?.toLowerCase() ?? companies} companies, from where I started in 2021 to the latest indie releases.
      </p>
    </div>
    <Bug id="portfolio-1" style="right: 12%; top: 9rem" tablet="right: 10%; bottom: 0.75rem" walk="x -2rem" />
  </section>

  <!-- Level 2: every post, newest first, with its titles -->
  <section class="level level--cyan titles" data-level="2" aria-labelledby="titles-title">
    <div class="level__head">
      <p class="flag" data-enter><span>Level 2 &middot; By company</span></p>
      <h2 id="titles-title" class="level__title" data-enter="wipe">Where I tested them</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">Newest first. Every card has one button, to the game's store page, in a new tab.</p>
    </div>
    <div class="level__body">
      {
        groups.map((g, gi) => (
          <div class:list={['group', `accent--${g.accent}`]} aria-labelledby={`group-${gi}`} data-year={yearOf(g)}>
            <div class="group__head" data-enter>
              <div class="group__id">
                <h3 id={`group-${gi}`} class="group__name">{g.name}</h3>
                <p class="group__when">{span(g)}</p>
              </div>
              <ul role="list" class="group__roles">
                {g.roles.map((r) => (
                  <li class="group__role">
                    {role(r)}
                    {g.roles.length > 1 && (
                      <>
                        {' '}
                        <span class="group__dot" aria-hidden="true">&middot;</span> {r.when}
                      </>
                    )}
                  </li>
                ))}
              </ul>
              <p class="group__lead">{g.lead}</p>
            </div>
            {g.projects.length > 0 && (
              <div class="group__grid">
                {g.projects.map((p, i) => (
                  <GameCard project={p} via={g.via} delay={i * 60} scan />
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
    <Bug id="portfolio-2" style="right: 10%; bottom: 0.75rem" walk="x -2rem" />
    <Bug id="portfolio-3" style="right: 8%; top: 10rem" tablet="left: 45%; top: 0.75rem" phone="left: 1rem; bottom: 0.25rem" walk="x -2rem" />
  </section>

  <!-- Level 3: a short way on -->
  <section class="level level--green level--tight next" data-level="3" aria-labelledby="next-title">
    <div class="level__head">
      <p class="flag" data-enter><span>Level 3 &middot; Next</span></p>
      <h2 id="next-title" class="level__title level__title--small" data-enter="wipe">How I test</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">The skills behind the titles, and the suite that tests this site.</p>
      <div class="level__actions" data-enter style="--enter-delay: 160ms">
        <a class="button button--navy" href="/skills/">See the skills</a>
        <a class="button button--navy" href="/quality/">How I test this site</a>
      </div>
    </div>
    <Bug id="portfolio-4" style="right: 10%; top: 40%" tablet="right: 8%; top: 2rem" phone="right: 1rem; top: 0.25rem" walk="y 1.5rem" />
  </section>
</Base>

<style>
  .work {
    padding-top: var(--s-3);
  }
  .work__lead {
    max-width: 40ch;
  }

  /* Each post: a navy header band with the company's accent on its edge, then its titles. */
  .group + .group {
    margin-top: var(--s-6);
  }
  .group__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas:
      'id roles'
      'id lead';
    column-gap: var(--s-5);
    row-gap: var(--s-2);
    align-items: start;
    padding: var(--s-4) 0;
    border-top: 1px solid var(--rule);
    position: relative;
  }
  .group__id {
    grid-area: id;
  }
  .group__name {
    font-size: var(--step-head);
    font-size: round(var(--step-head), 16px);
    line-height: 0.95;
    margin-left: -0.03em;
  }
  /* The dates: large, in the company's accent, right under the name. The accents do not read on
     the cyan field, so the dates sit on a navy label, like the labels on the cards. */
  .group__when {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    padding: 0.3em 0.5em;
    background: var(--bg);
    color: var(--g-ink, var(--accent-2));
    max-width: none;
    margin-top: var(--s-2);
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
  }
  .group__roles {
    grid-area: roles;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
  }
  .group__dot {
    margin-inline: 0.2em;
  }
  .group__lead {
    grid-area: lead;
    font-size: 1rem;
    max-width: 70ch;
  }
  /* Three tiles a row on a six-column grid, so the last row always fills: a lone last tile
     spans the row, a pair splits it. */
  .group__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: var(--gap);
  }
  .group__grid > :global(.card) {
    grid-column: span 2;
  }
  .group__grid > :global(.card:last-child:nth-child(3n + 1)) {
    grid-column: span 6;
  }
  .group__grid > :global(.card:nth-last-child(2):nth-child(3n + 1)),
  .group__grid > :global(.card:last-child:nth-child(3n + 2)) {
    grid-column: span 3;
  }
  .level__title--small {
    font-size: var(--step-head);
    font-size: round(var(--step-head), 16px);
  }

  @media (max-width: 63.99rem) {
    .group + .group {
      margin-top: var(--s-5);
    }
    .group__head {
      grid-template-columns: 1fr;
      grid-template-areas:
        'id'
        'roles'
        'lead';
      padding: var(--s-3) 0;
    }
    .group__when {
      font-size: 1.5rem;
      margin-top: var(--s-1);
    }
    .group__grid {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
    .group__grid > :global(.card),
    .group__grid > :global(.card:last-child:nth-child(3n + 1)),
    .group__grid > :global(.card:nth-last-child(2):nth-child(3n + 1)),
    .group__grid > :global(.card:last-child:nth-child(3n + 2)) {
      grid-column: 1 / -1;
    }
  }
</style>

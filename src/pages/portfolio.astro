---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bug from '../components/Bug.astro';
import PixelTile from '../components/PixelTile.astro';
import StageCard from '../components/StageCard.astro';
import { contact, employers, primaryAction } from '../config';

const all = await getCollection('projects');
// Released titles newest first, titles in development last.
const shown = (import.meta.env.DEV ? all : all.filter((p) => p.data.public)).sort((a, b) => {
  const aDev = a.data.status === 'in-development' ? 1 : 0;
  const bDev = b.data.status === 'in-development' ? 1 : 0;
  return aDev - bDev || (b.data.year ?? 0) - (a.data.year ?? 0);
});
// One group per company, newest first, as on About. Stage numbers run on through the groups.
let number = 0;
const groups = employers
  .map((e) => ({ ...e, projects: shown.filter((p) => p.data.employer === e.id) }))
  .filter((g) => g.projects.length > 0)
  .map((g) => ({ ...g, from: (number += g.projects.length) - g.projects.length + 1 }));
const fillers = ['controller', 'check', 'headset', 'ship'] as const;
const count = shown.length;
const words = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen', 'Twenty'];
---

<Base title="Portfolio" description="Games Nicolás Porras has tested, by company: the Megabit Publishing titles at Aonic, Guildford Castle VR and Londinium at Historic VR, the nDreams VR titles, and Cyberpunk 2077, NBA 2K21 and the VR titles via Universally Speaking.">
  <!-- Level 1 -->
  <section class="level level--navy work" data-level="1" aria-labelledby="work-title">
    <p class="flag" data-load style="--d: 0ms"><span>Portfolio</span></p>
    <div class="work__grid">
      <div>
        <h1 id="work-title" class="page__title">
          <span class="mask"><span class="mask__line" style="--i: 0">Games I have</span></span>
          <span class="mask"><span class="mask__line" style="--i: 1">tested</span></span>
        </h1>
        <p class="work__lead statement" data-load style="--d: 360ms">
          Titles with their own pages, from where I started in 2021 to the latest indie releases.
        </p>
      </div>
      <div class="work__photo" data-load style="--d: 200ms">
        <PixelTile name="ship" tone="blue" />
      </div>
    </div>
    <Bug id="portfolio-1" style="right: 46%; top: 12%" />
  </section>

  <!-- Level 2: every title, by company -->
  <section class="level level--cyan titles" data-level="2" aria-labelledby="titles-title">
    <p class="flag" data-enter><span>Level 2 &middot; Select title</span></p>
    <div class="level__head">
      <h2 id="titles-title" class="level__title" data-enter="wipe">Select title</h2>
      <div class="level__aside" data-enter style="--enter-delay: 80ms">
        <p class="level__lead">
          {words[count] ?? count} titles by company, newest first. Each one opens to the platforms, the role and the store page.
        </p>
      </div>
    </div>
    {
      groups.map((g, gi) => (
        <div class:list={['group', gi % 2 ? 'group--light' : 'group--navy']} aria-labelledby={`group-${gi}`}>
          <div class="group__head" data-enter>
            <h3 id={`group-${gi}`} class="group__name">{g.id}</h3>
            <p class="group__role">
              {g.role} <span class="group__dot" aria-hidden="true">&middot;</span> {g.when}
            </p>
            <p class="group__lead">{g.lead}</p>
            {g.note && <p class="group__note">{g.note}</p>}
          </div>
          <div class="group__grid">
            {g.projects.map((p, i) => (
              <StageCard project={p} number={g.from + i} via={g.via} tone={gi % 2 ? 'light' : 'navy'} delay={i * 60} />
            ))}
            {g.projects.length % 3 !== 0 && (
              <div class="group__photo" data-enter="place" style={`--enter-delay: ${g.projects.length * 60}ms`}>
                <PixelTile name={fillers[gi % fillers.length]} tone={gi % 2 ? 'light' : 'navy'} />
              </div>
            )}
          </div>
        </div>
      ))
    }
    <Bug id="portfolio-2" style="left: 52%; top: 4%" />
    <Bug id="portfolio-3" style="right: 8%; top: 38%" phone="none" />
    <Bug id="portfolio-4" style="left: 36%; top: 72%" phone="none" />
  </section>

  <!-- Level 3 -->
  <section class="level level--green ask" data-level="3" aria-labelledby="ask-title">
    <p class="flag" data-enter><span>Level 3 &middot; Final level</span></p>
    <h2 id="ask-title" class="level__title" data-enter="wipe">
      <span class="mask__line">The list</span>
      <span class="mask__line">keeps growing</span>
    </h2>
    <div class="ask__actions" data-enter style="--enter-delay: 80ms">
      <a class="button button--navy" href={primaryAction.href}>{primaryAction.label}</a>
      <a class="ask__mail" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
  </section>
</Base>

<style>
  .work {
    padding-top: var(--s-2);
  }
  .work__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--s-5);
    align-items: end;
    margin-top: var(--s-5);
  }
  .work__lead {
    margin-top: var(--s-4);
    max-width: 36ch;
  }
  .work__photo {
    min-height: 24rem;
  }

  /* Each company: a header band, then its tiles. The band and the tiles share a tone and the
     groups alternate, so the page reads as four boards on one field. */
  .group {
    margin-top: var(--s-6);
  }
  .group__head {
    display: grid;
    grid-template-columns: 7fr 5fr;
    grid-template-areas:
      'name role'
      'name lead'
      'name note';
    column-gap: var(--s-5);
    row-gap: var(--s-1);
    align-items: start;
    padding: var(--s-3);
  }
  .group--navy .group__head {
    background: var(--bg);
    color: var(--ink);
    --sel-bg: var(--accent);
    --sel-ink: var(--accent-ink);
  }
  .group--light .group__head {
    background: var(--field-light);
    color: var(--field-light-ink);
    --sel-bg: var(--pr-navy);
    --sel-ink: var(--pr-light);
  }
  .group__name {
    grid-area: name;
    font-size: var(--step-head);
    font-size: round(var(--step-head), 16px);
    line-height: 0.95;
    margin-left: -0.03em;
  }
  .group__role {
    grid-area: role;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--accent-2);
    max-width: none;
  }
  .group--light .group__role {
    color: var(--pr-navy);
  }
  .group__dot {
    margin-inline: 0.2em;
  }
  .group__lead {
    grid-area: lead;
    font-size: var(--step-body);
    max-width: 40ch;
  }
  .group__note {
    grid-area: note;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-2);
    max-width: none;
  }
  .group--light .group__note {
    color: var(--pr-navy);
  }
  .group__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: minmax(21rem, auto);
    gap: var(--gap);
    margin-top: var(--gap);
  }
  .group__photo {
    min-width: 0;
    min-height: 0;
  }

  .ask__actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-5);
  }
  .ask__actions .button {
    font-size: 1.5rem;
    min-height: 3.5rem;
    padding-inline: 2rem;
  }
  .ask__mail {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--pr-navy);
  }

  @media (max-width: 63.99rem) {
    .work__grid {
      grid-template-columns: 1fr;
      gap: var(--s-4);
      margin-top: var(--s-4);
    }
    .work__photo {
      min-height: 0;
      aspect-ratio: 4 / 3;
      order: -1;
    }
    .group {
      margin-top: var(--s-5);
    }
    .group__head {
      grid-template-columns: 1fr;
      grid-template-areas:
        'name'
        'role'
        'lead'
        'note';
      padding: var(--s-3) var(--s-2);
    }
    .group__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      gap: 0.375rem;
    }
    .group__photo {
      display: none;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bug from '../components/Bug.astro';
import GameCard from '../components/GameCard.astro';
import Join from '../components/Join.astro';
import { employers, since } from '../config';
import { trackerIds } from '../data/ids';

const all = await getCollection('projects');
// Released titles newest first, titles in development last.
const shown = (import.meta.env.DEV ? all : all.filter((p) => p.data.public)).sort((a, b) => {
  const aDev = a.data.status === 'in-development' ? 1 : 0;
  const bDev = b.data.status === 'in-development' ? 1 : 0;
  return aDev - bDev || (b.data.year ?? 0) - (a.data.year ?? 0);
});
// Each game's tracker ID (PR-001...), stable from the data.
const ids = trackerIds(shown);
// One group per post with public games, in the order of `employers` (newest first). A post that
// was not game QA (`games: false`) or has no public titles is listed under Other roles instead.
const posts = employers.map((e) => ({ ...e, projects: shown.filter((p) => p.data.employer === e.id) }));
const groups = posts.filter((e) => e.games !== false && e.projects.length > 0);
const others = posts.filter((e) => !groups.includes(e));
const count = shown.length;
// (the companies the games were tested at)
const companies = new Set(groups.map((e) => e.name)).size;
const words = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen', 'Twenty', 'Twenty-one', 'Twenty-two', 'Twenty-three', 'Twenty-four'];
// The whole span of a post, from the start of its first role to the end of its last (in the name
// of its list of games).
const span = (g: (typeof groups)[number]) => {
  const first = g.roles[0].when.split(' to ')[0];
  const last = g.roles[g.roles.length - 1].when.split(' to ').pop();
  return `${first} to ${last}`;
};
// The year a post began, for the track: the earliest year in its dates.
const yearOf = (g: (typeof groups)[number]) => Math.min(...g.roles.flatMap((r) => (r.when.match(/\b(20\d\d)\b/g) ?? []).map(Number)));
---

<Base
  title="Games"
  fullTitle="Games I've tested, QA portfolio | Nicolás Porras"
  description={`The ${count} games Nicolás Porras has tested since ${since}, from Cyberpunk 2077 and NBA 2K21 to VR titles at nDreams and Historic VR, with his part in each.`}
>
  <!-- Level 1 -->
  <section class="level level--navy level--sky has-join-bottom work" data-level="1" aria-labelledby="work-title">
    <div class="level__head">
      <p class="flag" data-nosnippet data-load style="--d: 0ms"><span>Games</span></p>
      <h1 id="work-title" class="page__title">
        <span class="mask"><span class="mask__line" style="--i: 0">Games I've</span></span>{' '}
        <span class="mask"><span class="mask__line" style="--i: 1">tested</span></span>
      </h1>
      <p class="work__lead statement" data-load style="--d: 360ms">
        {words[count] ?? count} titles across {words[companies]?.toLowerCase() ?? companies} companies, from where I started in 2021 to the latest releases.
      </p>
    </div>
    <Join kind="clouds" from="var(--pr-navy)" to="var(--field-cyan)" seed="portfolio-titles" />
    <Bug id="portfolio-1" style="right: 12%; top: 9rem" tablet="right: var(--gutter); top: 6rem" walk="x -2rem" />
  </section>

  <!-- Level 2: every post, newest first, with its titles -->
  <section class="level level--cyan has-join-bottom titles" data-level="2" aria-labelledby="titles-title">
    <Join kind="terrain" from="var(--field-cyan)" to="var(--field-green)" seed="portfolio-next" />
    <div class="level__head">
      <p class="flag" data-nosnippet data-enter><span>Level 2 &middot; By company</span></p>
      <h2 id="titles-title" class="level__title" data-enter="wipe">Games I've tested, by studio</h2>
      <p class="level__lead" data-enter style="--enter-delay: 80ms">Newest first, with what I did on each one.</p>
    </div>
    <div class="level__body">
      {
        groups.map((g, gi) => (
          <div class:list={['group', `accent--${g.accent}`]} role="group" aria-labelledby={`group-${gi}`} data-year={yearOf(g)}>
            <div class="group__head" data-enter>
              <h3 id={`group-${gi}`} class="group__name">{g.name}</h3>
              <div class="group__about">
                <ul role="list" class="group__roles">
                  {g.roles.map((r) => (
                    <li class="group__role">
                      {r.title} <span class="group__dot" aria-hidden="true">&middot;</span> {r.when}
                    </li>
                  ))}
                </ul>
                <p class="group__lead">{g.lead}</p>
                <p class="group__count">{g.projects.length} {g.projects.length === 1 ? 'game' : 'games'}</p>
              </div>
            </div>
            {g.projects.length > 0 && (
              <div class="group__row" role="region" aria-label={`${g.name} games, ${span(g)}`}>
                <ul role="list" class="group__grid">
                  {g.projects.map((p, i) => (
                    <li class="group__cell">
                      <GameCard project={p} via={g.via} delay={i * 60} scan open={i === 0} trackerId={ids.get(p.id)} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
      {
        others.length > 0 && (
          <div class="others" data-enter>
            <h3 class="others__title">Other roles</h3>
            <ul role="list" class="others__list">
              {others.map((e) => (
                <li class="others__item">
                  <h4 class="others__name">{e.name}</h4>
                  {e.roles.map((r) => (
                    <p class="others__role">
                      {r.title} <span class="group__dot" aria-hidden="true">&middot;</span> {r.when}
                    </p>
                  ))}
                  <p class="others__lead">{e.lead}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
    <Bug id="portfolio-2" style="right: 10%; bottom: 0.75rem" walk="x -2rem" />
    <Bug id="portfolio-3" style="right: 8%; top: 1.5rem" tablet="left: 45%; top: 0.75rem" phone="left: 1rem; bottom: 0.25rem" walk="x -2rem" />
  </section>

  <!-- Level 3: a short way on -->
  <section class="level level--green level--tight has-join-bottom next" data-level="3" aria-labelledby="next-title">
    <Join kind="terrain" from="var(--field-green)" to="var(--pr-navy)" seed="portfolio-foot" />
    <div class="level__head">
      <p class="flag" data-nosnippet data-enter><span>Level 3 &middot; Next</span></p>
      <h2 id="next-title" class="level__title level__title--small" data-enter="wipe">How I test games, and this site</h2>
      <div class="level__actions" data-enter style="--enter-delay: 160ms">
        <a class="button button--navy" href="/about/#skills">See the skills</a>
        <a class="button button--navy" href="/quality/">How I test this site</a>
      </div>
    </div>
    <Bug id="portfolio-4" style="right: 10%; top: 40%" tablet="right: 8%; top: 2rem" phone="right: 1rem; top: 0.25rem" walk="y 1.5rem" />
  </section>
</Base>

<style>
  .work {
    padding-top: var(--s-3);
  }
  .work__lead {
    max-width: 40ch;
  }

  /* Each post: a plain header like a career entry (the company, each role with its dates, the line
     on the post, the number of games), then its titles. */
  .group + .group {
    margin-top: var(--s-6);
  }
  .group__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: var(--s-5);
    row-gap: var(--s-2);
    align-items: start;
    padding: var(--s-4) 0;
    border-top: 1px solid var(--rule);
    position: relative;
  }
  .group__name {
    font-size: var(--step-head);
    font-size: round(var(--step-head), 16px);
    line-height: 0.95;
    margin-left: -0.03em;
  }
  .group__about {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }
  /* each role on a line of its own, "title · dates" */
  .group__roles,
  .others__role {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.25;
    max-width: none;
  }
  .group__dot {
    margin-inline: 0.2em;
  }
  .group__lead {
    font-size: 1rem;
    max-width: 70ch;
  }
  .group__count {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    max-width: none;
  }
  /* Other roles: the posts with no public games, newest first, plain and compact under the games. */
  .others {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }
  .others__title {
    font-size: var(--step-head);
    font-size: round(var(--step-head), 16px);
    line-height: 0.95;
  }
  .others__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3) var(--gap);
    margin-top: var(--s-3);
  }
  .others__item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .others__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.1;
  }
  .others__role {
    font-size: 1rem;
  }
  .others__lead {
    font-size: 0.9375rem;
    max-width: 60ch;
  }
  /* The cards are a list at every width. On a desktop, three a row on a six-column grid, so the
     last row always fills: a lone last tile spans the row, a pair splits it. */
  .group__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--gap);
    margin: var(--gap) 0 0;
    padding: 0;
  }
  .group__cell {
    display: grid;
    min-width: 0;
    grid-column: span 2;
  }
  .group__cell:last-child:nth-child(3n + 1) {
    grid-column: span 6;
  }
  .group__cell:nth-last-child(2):nth-child(3n + 1),
  .group__cell:last-child:nth-child(3n + 2) {
    grid-column: span 3;
  }
  .level__title--small {
    font-size: var(--step-head);
    font-size: round(var(--step-head), 16px);
  }

  @media (max-width: 63.99rem) {
    .group + .group {
      margin-top: var(--s-5);
    }
    .group__head {
      grid-template-columns: 1fr;
      padding: var(--s-3) 0;
    }
    .others {
      margin-top: var(--s-5);
    }
    .others__list {
      grid-template-columns: 1fr;
    }
    .group__grid {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
    .group__cell,
    .group__cell:last-child:nth-child(3n + 1),
    .group__cell:nth-last-child(2):nth-child(3n + 1),
    .group__cell:last-child:nth-child(3n + 2) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/motion';
  // The folded list on a phone: each company's cards are rows, one open at a time (the first to
  // begin with). A tap on a row opens its card and folds the one that was open; the row stays under
  // the finger while the cards above it fold. Once open, a card that runs off the screen is brought
  // into view, and the games script is told to look at it (the scan plays on an open card only).
  const phone = matchMedia('(max-width: 47.99rem)');
  const still = { get matches() { return reducedMotion(); } };
  const FOLD_MS = 280;
  document.querySelectorAll<HTMLElement>('.group__grid').forEach((list) => {
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-card]'));
    const set = (card: HTMLElement, open: boolean) => {
      card.classList.toggle('is-open', open);
      card.querySelector('[data-card-toggle]')!.setAttribute('aria-expanded', String(open));
    };
    cards.forEach((card) => {
      const button = card.querySelector<HTMLButtonElement>('[data-card-toggle]')!;
      button.addEventListener('click', () => {
        const opening = !card.classList.contains('is-open');
        const before = button.getBoundingClientRect().top;
        cards.forEach((c) => set(c, c === card && opening));
        const until = performance.now() + (still.matches ? 0 : FOLD_MS);
        const frame = () => {
          const drift = button.getBoundingClientRect().top - before;
          if (Math.abs(drift) > 0.5) scrollBy({ top: drift, behavior: 'instant' });
          if (performance.now() < until) return requestAnimationFrame(frame);
          if (!opening || !phone.matches) return;
          const r = card.getBoundingClientRect();
          const room = innerHeight - (parseFloat(getComputedStyle(document.body).paddingBottom) || 0);
          if (r.bottom > room && r.height < room) scrollBy({ top: r.bottom - room + 8, behavior: still.matches ? 'instant' : 'smooth' });
          document.dispatchEvent(new CustomEvent('playrun:cardopen'));
        };
        requestAnimationFrame(frame);
      });
    });
  });
</script>
